// Live objects by type in production (docs/FRAMEWORK.md section 5): the
// per-type counters of ZELL_DIAG_HEAP=1 (runtime/src/diag_heap.c), or the
// exact list of live objects under `zell run --leak-check`. And the cycle
// collector's metrics for PrometheusText.
namespace std.diag

// Live objects of one type (HeapByType).
struct HeapType {
    // The type name (`app.Node`, `[]backing`, `string`, `closure env`...).
    Type string
    // Objects alive now.
    Live int
    // Objects of the type allocated since the start (-1 under
    // --leak-check, which only sees the live ones).
    Allocated int
    // Bytes of the live objects (0 when the type's size is not recorded).
    Bytes int
}

// True when HeapByType has data: ZELL_DIAG_HEAP=1 was set at startup, or
// the program runs with --leak-check (debug build).
func HeapCounting() bool {
    return rtHeapCounting() || len(rtHeapTypes()) > 0
}

// Live objects by type, most live first (empty without ZELL_DIAG_HEAP=1
// or --leak-check).
func HeapByType() []HeapType {
    var out []HeapType = []
    for line in std.strings.Split(rtHeapTypes(), "\n") {
        var f = std.strings.Split(line, "\t")
        if len(f) != 4 {
            continue
        }
        var live = try std.strings.ToInt(f[0]) else 0
        var total = try std.strings.ToInt(f[1]) else 0
        var bytes = try std.strings.ToInt(f[2]) else 0
        out = append(out, HeapType{Type: f[3], Live: live, Allocated: total, Bytes: bytes})
    }
    return out
}

// The /debug/heap report: the top `limit` types by live objects, with the
// growth of each since the previous report (kept process-wide).
func HeapReport(limit int) string {
    var types = HeapByType()
    if len(types) == 0 {
        return "no heap data: start the program with ZELL_DIAG_HEAP=1 (or run it with --leak-check)\n"
    }
    rtLock()
    var m = slots()
    var prev = map[string]int{}
    switch m["diag.heap.last"] {
        case map[string]int p:
            prev = p
    }
    var now = map[string]int{}
    for t in types {
        now[t.Type] = t.Live
    }
    m["diag.heap.last"] = now
    rtUnlock()
    var b = std.strings.Builder{}
    b.Write(std.fmt.Sprintf("%12s %10s %14s %12s  %s\n", "live", "growth", "allocated", "bytes", "type"))
    var total = 0
    for i, t in types {
        total += t.Live
        if i >= limit {
            continue
        }
        // A type missing from the previous report counts from 0; the first
        // report has no previous one.
        var g = std.fmt.Sprintf("%+d", t.Live - prev[t.Type])
        if len(prev) == 0 {
            g = "-"
        }
        b.Write(std.fmt.Sprintf("%12d %10s %14d %12d  %s\n", t.Live, g, t.Allocated, t.Bytes, t.Type))
    }
    b.Write(std.fmt.Sprintf("%12d live objects in %d types\n", total, len(types)))
    return b.String()
}

// A Router handler serving HeapReport(50) as text: `r.Get("/debug/heap",
// diag.ServeHeap)`.
async func ServeHeap(req *std.net.http.Request, res *std.net.http.Response) void! {
    res.SetHeader("Content-Type", "text/plain; charset=utf-8")
    res.Write(HeapReport(50))
}

struct heapHandler {
    func Serve(req *std.net.http.Request, res *std.net.http.Response) Task<void!> {
        return ServeHeap(req, res)
    }
}

// An http.Handler serving HeapReport(50) (for http.Server{Handler: ...}).
func HeapHandler() std.net.http.Handler {
    return new heapHandler{}
}

// The cycle collector's metrics, part of the runtime metrics.
func cycleMetricsText() string {
    var c = std.runtime.CycleStats()
    return "# HELP zell_cycles_collected_total Objects freed by the cycle collector.\n# TYPE zell_cycles_collected_total counter\nzell_cycles_collected_total " +
        std.fmt.Format("{0}", c.Collected) +
        "\n# HELP zell_cycle_collections_total Cycle collections run.\n# TYPE zell_cycle_collections_total counter\nzell_cycle_collections_total " +
        std.fmt.Format("{0}", c.Runs) +
        "\n# HELP zell_cycle_candidates Possible cycle roots waiting for a collection.\n# TYPE zell_cycle_candidates gauge\nzell_cycle_candidates " +
        std.fmt.Format("{0}", c.Pending) +
        "\n# HELP zell_cycle_candidates_total Possible cycle roots recorded.\n# TYPE zell_cycle_candidates_total counter\nzell_cycle_candidates_total " +
        std.fmt.Format("{0}", c.Candidates) +
        "\n"
}
