namespace std.testing

// std.testing and the runtime half of `slang test`.
//
// Test functions are marked @test: `@test func TestAdd(t *testing.T)` or
// a plain `@test func Something()`; `@test func BenchX(b *testing.B)` is a
// benchmark (run with `slang test --bench`). `slang test [path]` finds
// them, generates a driver calling Main with every Case and runs it.
//
// Isolation: Main runs every test in its own child process (the test
// binary re-executes itself with --run-one), so t.Fatal, t.Skip and even
// a panic end only that test. t.Run subtests run inside their parent's
// process; a Fatal in a subtest ends the whole top-level test.
//
// Assertions (testing.Equal(t, got, want) ...) report through t.Error and
// keep going; the ...Fatal variants stop the test (testing.EqualFatal).
// Table tests are plain slices of structs:
//
//   @test func TestAbs(t *testing.T) {
//       var cases = [Case{In: -1, Want: 1}, Case{In: 2, Want: 2}]
//       for c in cases {
//           t.Run(fmt.Format("{0}", c.In), func(t *testing.T) {
//               testing.Equal(t, math.IAbs(c.In), c.Want)
//           })
//       }
//   }

// One discovered test (generated by `slang test`).
struct Case {
    Name string
    Run func(*T)
    Bench func(*B)
}

// The handle of a running test.
struct T {
    name string
    failed bool
    skipped bool
    depth int
    verbose bool
    noTime bool

    func Name() string {
        return this.name
    }

    func Failed() bool {
        return this.failed
    }

    func Skipped() bool {
        return this.skipped
    }

    func indent() string {
        return std.strings.Repeat("    ", this.depth + 1)
    }

    // Records a message (shown for failing tests and with -v).
    func Log(msg string) {
        std.io.println(this.indent() + std.strings.Replace(msg, "\n", "\n" + this.indent()))
    }

    // Marks the test failed and logs msg; the test continues.
    func Error(msg string) {
        this.failed = true
        this.Log(msg)
    }

    // Marks the test failed (without a message).
    func Fail() {
        this.failed = true
    }

    // Marks the test failed, logs msg and ends it.
    func Fatal(msg string) {
        this.failed = true
        this.Log(msg)
        this.FailNow()
    }

    // Ends the test now (failed if it was marked failed).
    func FailNow() {
        if this.failed {
            std.os.Exit(1)
        }
        std.os.Exit(0)
    }

    // Skips the rest of the test.
    func Skip(msg string) {
        this.skipped = true
        if msg != "" {
            this.Log(msg)
        }
        if this.failed {
            std.os.Exit(1)
        }
        std.os.Exit(3)
    }

    // Marks the test as safe to run in parallel (tests already run in
    // separate processes; `slang test --parallel N` runs N at a time).
    func Parallel() {
    }

    // Runs fn as subtest name; returns true if it passed.
    func Run(name string, fn func(*T)) bool {
        var sub = new T{name: this.name + "/" + std.strings.Replace(name, " ", "_"), depth: this.depth + 1, verbose: this.verbose, noTime: this.noTime}
        var start = std.time.NowInstant()
        std.io.println(std.strings.Repeat("    ", this.depth + 1) + "=== RUN   " + sub.name)
        fn(sub)
        var status = "PASS"
        if sub.failed {
            status = "FAIL"
            this.failed = true
        } else if sub.skipped {
            status = "SKIP"
        }
        std.io.println(std.strings.Repeat("    ", this.depth + 1) + "--- " + status + ": " + sub.name + timeText(start.Elapsed(), this.noTime))
        return !sub.failed
    }
}

// The handle of a running benchmark: run the measured code b.N times.
struct B {
    N int
    name string
    failed bool
    start std.time.Instant
    elapsed std.time.Duration
    running bool
    allocStart int
    allocs int

    func Name() string {
        return this.name
    }

    // Restarts the measurement (excludes setup before it).
    func ResetTimer() {
        this.start = std.time.NowInstant()
        this.elapsed = std.time.Duration{}
        this.allocStart = std.diag.rtAllocations()
        this.allocs = 0
    }

    func StopTimer() {
        if this.running {
            this.elapsed = this.elapsed.Add(this.start.Elapsed())
            this.allocs += std.diag.rtAllocations() - this.allocStart
            this.running = false
        }
    }

    func StartTimer() {
        if !this.running {
            this.start = std.time.NowInstant()
            this.allocStart = std.diag.rtAllocations()
            this.running = true
        }
    }

    // Allocations are always reported (allocs/op); kept for Go parity.
    func ReportAllocs() {
    }

    func Log(msg string) {
        std.io.println("    " + msg)
    }

    func Error(msg string) {
        this.failed = true
        this.Log(msg)
    }

    func Fatal(msg string) {
        this.failed = true
        this.Log(msg)
        std.os.Exit(1)
    }
}

// " (0.01s)", or "" with --no-time (for golden outputs).
func timeText(d std.time.Duration, off bool) string {
    if off {
        return ""
    }
    return " (" + seconds(d) + ")"
}

func seconds(d std.time.Duration) string {
    return std.strconv.FormatFloat(d.Seconds(), 'f', 2) + "s"
}

// ---- assertions -------------------------------------------------------------------

func show<V>(v V) string {
    if std.reflect.TypeOf<V>().Kind == std.reflect.Kind.String {
        return std.strconv.Quote(v)
    } else {
        return std.fmt.Format("{0}", v)
    }
}

// Reports an error unless got == want.
func Equal<V: Comparable>(t *T, got V, want V) bool {
    if got != want {
        t.Error("got " + show(got) + ", want " + show(want))
        return false
    }
    return true
}

// Equal that ends the test on failure.
func EqualFatal<V: Comparable>(t *T, got V, want V) {
    if got != want {
        t.Fatal("got " + show(got) + ", want " + show(want))
    }
}

// Reports an error if got == other.
func NotEqual<V: Comparable>(t *T, got V, other V) bool {
    if got == other {
        t.Error("got " + show(got) + ", want anything else")
        return false
    }
    return true
}

// Compares slices element by element.
func EqualSlices<V: Comparable>(t *T, got []V, want []V) bool {
    if !std.slices.Equal(got, want) {
        t.Error("got " + std.fmt.Format("{0}", got) + ", want " + std.fmt.Format("{0}", want))
        return false
    }
    return true
}

func True(t *T, cond bool, msg string) bool {
    if !cond {
        t.Error("expected true: " + msg)
        return false
    }
    return true
}

func False(t *T, cond bool, msg string) bool {
    if cond {
        t.Error("expected false: " + msg)
        return false
    }
    return true
}

// Reports an error unless p is nil.
func Nil<V>(t *T, p *V) bool {
    if p != nil {
        t.Error("expected nil")
        return false
    }
    return true
}

func NotNil<V>(t *T, p *V) bool {
    if p == nil {
        t.Error("expected a non-nil value")
        return false
    }
    return true
}

// Reports an error if err is nil.
func Error(t *T, err error) bool {
    if err == nil {
        t.Error("expected an error, got nil")
        return false
    }
    return true
}

// Reports an error unless err is nil.
func NoError(t *T, err error) bool {
    if err != nil {
        t.Error("unexpected error: " + err.Message())
        return false
    }
    return true
}

// Reports an error unless errors.Is(err, target).
func ErrorIs(t *T, err error, target error) bool {
    if !std.errors.Is(err, target) {
        var got = "nil"
        if err != nil {
            got = std.strconv.Quote(err.Message())
        }
        t.Error("error " + got + " is not " + std.strconv.Quote(target.Message()))
        return false
    }
    return true
}

// Reports an error unless s contains sub.
func Contains(t *T, s string, sub string) bool {
    if !std.strings.Contains(s, sub) {
        t.Error(std.strconv.Quote(s) + " does not contain " + std.strconv.Quote(sub))
        return false
    }
    return true
}

// ---- runner -----------------------------------------------------------------------

struct options {
    filter string
    json bool
    bench bool
    verbose bool
    runOne string
    benchOne string
    benchMs int
    parallel int
    noTime bool
}

func parseArgs(args []string) options {
    var o = options{benchMs: 1000, parallel: 1}
    var i = 1
    for i < len(args) {
        var a = args[i]
        i += 1
        if a == "--json" {
            o.json = true
        } else if a == "--bench" {
            o.bench = true
        } else if a == "-v" || a == "--verbose" {
            o.verbose = true
        } else if a == "--no-time" {
            o.noTime = true
        } else if (a == "--filter" || a == "--run-one" || a == "--bench-one" || a == "--benchtime" || a == "--parallel") && i < len(args) {
            var v = args[i]
            i += 1
            if a == "--filter" {
                o.filter = v
            } else if a == "--run-one" {
                o.runOne = v
            } else if a == "--bench-one" {
                o.benchOne = v
            } else if a == "--benchtime" {
                o.benchMs = try std.strconv.Atoi(v) else 1000
            } else {
                o.parallel = try std.strconv.Atoi(v) else 1
            }
        }
    }
    return o
}

// The filter: alternatives separated by "|", each a substring, with
// optional ^ (prefix) and $ (suffix) anchors.
func matches(filter string, name string) bool {
    if filter == "" {
        return true
    }
    for alt in std.strings.Split(filter, "|") {
        var p = alt
        var pre = std.strings.HasPrefix(p, "^")
        var suf = std.strings.HasSuffix(p, "$")
        if pre {
            p = p[1..]
        }
        if suf {
            p = p[..len(p) - 1]
        }
        if pre && suf {
            if name == p {
                return true
            }
        } else if pre {
            if std.strings.HasPrefix(name, p) {
                return true
            }
        } else if suf {
            if std.strings.HasSuffix(name, p) {
                return true
            }
        } else if std.strings.Contains(name, p) {
            return true
        }
    }
    return false
}

func runChild(c Case, o options) int {
    if c.Run == nil {
        std.io.Eprintln("testing: " + c.Name + " is not a test")
        return 1
    }
    var t = new T{name: c.Name, verbose: o.verbose, noTime: o.noTime}
    var run = c.Run
    run(t)
    if t.failed {
        return 1
    }
    if t.skipped {
        return 3
    }
    return 0
}

func benchChild(c Case, o options) int {
    var fn = c.Bench
    var n = 1
    var target = o.benchMs * 1000000
    for {
        var b = new B{N: n, name: c.Name}
        b.ResetTimer()
        b.running = true
        fn(b)
        b.StopTimer()
        if b.failed {
            return 1
        }
        var ns = b.elapsed.Nanoseconds()
        if ns >= target || n >= 1000000000 {
            var perOp = ns / n
            var frac = ""
            if perOp < 100 {
                // two decimals for fast operations
                var hundredths = (ns * 100 / n) % 100
                frac = "." + std.strings.PadLeft(std.strconv.Itoa(hundredths), 2, "0")
            }
            std.io.println("BENCH " + std.strconv.Itoa(n) + " " + std.strconv.Itoa(perOp) + frac + " " + std.strconv.Itoa(b.allocs / n))
            return 0
        }
        // predict the N that reaches the target, grow at most 100x
        var next = n * 100
        if ns > 0 {
            var predicted = target / (ns / n + 1) * 6 / 5
            if predicted < next {
                next = predicted
            }
        }
        if next <= n {
            next = n + 1
        }
        n = next
    }
}

func jsonEvent(action string, test string, elapsed float, output string) string {
    var s = "{\"Action\":\"" + action + "\""
    if test != "" {
        s += ",\"Test\":" + std.encoding.json.Quote(test)
    }
    if action == "output" {
        s += ",\"Output\":" + std.encoding.json.Quote(output)
    }
    if action == "pass" || action == "fail" || action == "skip" {
        s += ",\"Elapsed\":" + std.strconv.FormatFloat(elapsed, 'f', 3)
    }
    return s + "}"
}

struct outcome {
    name string
    code int
    output string
    elapsed std.time.Duration
}

async func runOne(self string, c Case, o options) outcome {
    var start = std.time.NowInstant()
    var args = ["--run-one", c.Name]
    if o.verbose {
        args = append(args, "-v")
    }
    if o.noTime {
        args = append(args, "--no-time")
    }
    var r = try await std.process.Run(self, args) catch err {
        return outcome{name: c.Name, code: 1, output: "    cannot run the test binary: " + err.Message() + "\n", elapsed: start.Elapsed()}
    }
    return outcome{name: c.Name, code: r.ExitCode, output: r.Stdout + r.Stderr, elapsed: start.Elapsed()}
}

// Runs the cases (the entry point of the driver `slang test` generates);
// returns the exit code: 0 when everything passed, 1 otherwise.
async func Main(cases []Case) int {
    var args = std.os.Args()
    var o = parseArgs(args)
    if o.runOne != "" {
        for c in cases {
            if c.Name == o.runOne {
                return runChild(c, o)
            }
        }
        std.io.Eprintln("testing: no test " + o.runOne)
        return 1
    }
    if o.benchOne != "" {
        for c in cases {
            if c.Name == o.benchOne && c.Bench != nil {
                return benchChild(c, o)
            }
        }
        std.io.Eprintln("testing: no benchmark " + o.benchOne)
        return 1
    }
    var self = args[0]
    var start = std.time.NowInstant()
    var passed = 0
    var failed = 0
    var skipped = 0
    var tests []Case = []
    var benches []Case = []
    for c in cases {
        if !matches(o.filter, c.Name) {
            continue
        }
        if c.Run != nil {
            tests = append(tests, c)
        } else if c.Bench != nil {
            benches = append(benches, c)
        }
    }
    var i = 0
    for i < len(tests) {
        // a batch of up to o.parallel tests at a time
        var batch []Task<outcome> = []
        var j = i
        for j < len(tests) && j - i < o.parallel {
            batch = append(batch, runOne(self, tests[j], o))
            j += 1
        }
        for task in batch {
            var r = await task
            var status = "PASS"
            var action = "pass"
            if r.code == 0 {
                passed += 1
            } else if r.code == 3 {
                status = "SKIP"
                action = "skip"
                skipped += 1
            } else {
                status = "FAIL"
                action = "fail"
                failed += 1
                if r.code != 1 {
                    r.output += "    (exit status " + std.strconv.Itoa(r.code) + ")\n"
                }
            }
            if o.json {
                std.io.println(jsonEvent("run", r.name, 0.0, ""))
                if r.output != "" {
                    std.io.println(jsonEvent("output", r.name, 0.0, r.output))
                }
                std.io.println(jsonEvent(action, r.name, r.elapsed.Seconds(), ""))
            } else if o.verbose || status == "FAIL" {
                if o.verbose {
                    std.io.println("=== RUN   " + r.name)
                }
                std.io.print(r.output)
                std.io.println("--- " + status + ": " + r.name + timeText(r.elapsed, o.noTime))
            }
        }
        i = j
    }
    if o.bench {
        for c in benches {
            var args2 = ["--bench-one", c.Name, "--benchtime", std.strconv.Itoa(o.benchMs)]
            var r = try await std.process.Run(self, args2) catch err {
                std.io.println("--- FAIL: " + c.Name + ": " + err.Message())
                failed += 1
                continue
            }
            var lines = std.strings.Split(std.strings.Trim(r.Stdout), "\n")
            var last = lines[len(lines) - 1]
            if r.ExitCode != 0 || !std.strings.HasPrefix(last, "BENCH ") {
                failed += 1
                std.io.print(r.Stdout + r.Stderr)
                std.io.println("--- FAIL: " + c.Name)
                continue
            }
            var f = std.strings.Fields(last)
            if o.json {
                std.io.println("{\"Action\":\"bench\",\"Test\":" + std.encoding.json.Quote(c.Name) + ",\"N\":" + f[1] + ",\"NsPerOp\":" + f[2] + ",\"AllocsPerOp\":" + f[3] + "}")
            } else {
                std.io.println(std.strings.PadRight(c.Name, 24, " ") + " " + std.strings.PadLeft(f[1], 10, " ") + " " + std.strings.PadLeft(f[2], 12, " ") + " ns/op " + std.strings.PadLeft(f[3], 8, " ") + " allocs/op")
            }
        }
    }
    var summary = std.strconv.Itoa(passed) + " passed, " + std.strconv.Itoa(failed) + " failed, " + std.strconv.Itoa(skipped) + " skipped"
    if o.json {
        var act = "pass"
        if failed > 0 {
            act = "fail"
        }
        std.io.println(jsonEvent(act, "", start.Elapsed().Seconds(), ""))
    } else if failed > 0 {
        std.io.println("FAIL")
        std.io.println("FAIL\t" + summary + timeText(start.Elapsed(), o.noTime))
    } else {
        std.io.println("PASS")
        std.io.println("ok  \t" + summary + timeText(start.Elapsed(), o.noTime))
    }
    if failed > 0 {
        return 1
    }
    return 0
}
