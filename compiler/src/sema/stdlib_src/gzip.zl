// gzip files (RFC 1952): members of header + raw DEFLATE + CRC-32 and
// size. Decompress and Reader read concatenated members as one stream,
// like gzip -d.
namespace compress.gzip

// The optional header fields of a member. ModTime is Unix seconds (0:
// unset); OS is the RFC 1952 operating system byte (255: unknown).
struct Header {
    Name    string
    Comment string
    ModTime int
    OS      int = 255
    Extra   []byte
}

// Compresses data into one member with an empty header.
func Compress(data []byte, level int) []byte {
    return CompressHeader(data, level, Header{})
}

// Compresses data into one member with header fields h.
func CompressHeader(data []byte, level int, h Header) []byte {
    var w = NewWriter(level)
    w.Header = h
    w.Write(data)
    w.Close()
    return w.Bytes()
}

// Decompresses all members of a gzip file.
func Decompress(data []byte) []byte! {
    var r = NewReader()
    r.Feed(data)?
    r.Close()?
    return r.Read()
}

// The header of the first member.
func ReadHeader(data []byte) Header! {
    var h = Header{}
    var n = parseHeader(data, &h)?
    if n < 0 {
        return error("gzip: unexpected end of header")
    }
    return h
}

func encodeHeader(h Header, level int) []byte {
    var flg = 0
    if len(h.Extra) > 0 {
        flg = flg | 4
    }
    if h.Name != "" {
        flg = flg | 8
    }
    if h.Comment != "" {
        flg = flg | 16
    }
    var b []byte = [byte(31), byte(139), byte(8), byte(flg)]
    b = compress.putLE32(b, h.ModTime)
    var xfl = 0
    if level == 9 {
        xfl = 2
    } else if level == 1 {
        xfl = 4
    }
    b = append(b, byte(xfl))
    b = append(b, byte(h.OS & 255))
    if len(h.Extra) > 0 {
        b = append(b, byte(len(h.Extra) & 255))
        b = append(b, byte((len(h.Extra) >> 8) & 255))
        b = compress.rtConcat(b, h.Extra)
    }
    if h.Name != "" {
        b = compress.rtConcat(b, strings.Bytes(h.Name))
        b = append(b, byte(0))
    }
    if h.Comment != "" {
        b = compress.rtConcat(b, strings.Bytes(h.Comment))
        b = append(b, byte(0))
    }
    return b
}

// Parses a member header at the start of b into h: its length, or -1 if
// b ends inside it.
func parseHeader(b []byte, h *Header) int! {
    if len(b) < 10 {
        if len(b) >= 1 && int(b[0]) != 31 || len(b) >= 2 && int(b[1]) != 139 {
            return error("gzip: invalid header")
        }
        return -1
    }
    if int(b[0]) != 31 || int(b[1]) != 139 {
        return error("gzip: invalid header")
    }
    if int(b[2]) != 8 {
        return error("gzip: unsupported compression method")
    }
    var flg = int(b[3])
    if (flg & 224) != 0 {
        return error("gzip: reserved header flags set")
    }
    h.ModTime = compress.le32(b, 4)
    h.OS = int(b[9])
    var i = 10
    if (flg & 4) != 0 {
        if len(b) < i + 2 {
            return -1
        }
        var xlen = int(b[i]) | (int(b[i + 1]) << 8)
        i += 2
        if len(b) < i + xlen {
            return -1
        }
        h.Extra = compress.rtCopy(b, i, i + xlen)
        i += xlen
    }
    if (flg & 8) != 0 {
        var j = zero(b, i)
        if j < 0 {
            return -1
        }
        h.Name = strings.FromBytes(compress.rtCopy(b, i, j))
        i = j + 1
    }
    if (flg & 16) != 0 {
        var j = zero(b, i)
        if j < 0 {
            return -1
        }
        h.Comment = strings.FromBytes(compress.rtCopy(b, i, j))
        i = j + 1
    }
    if (flg & 2) != 0 {
        if len(b) < i + 2 {
            return -1
        }
        var crc = compress.Crc32(0, compress.rtCopy(b, 0, i)) & 65535
        if crc != (int(b[i]) | (int(b[i + 1]) << 8)) {
            return error("gzip: header checksum mismatch")
        }
        i += 2
    }
    return i
}

func zero(b []byte, from int) int {
    for i in from..len(b) {
        if int(b[i]) == 0 {
            return i
        }
    }
    return -1
}

// A streaming gzip compressor: set Header before the first Write.
struct Writer {
    Header  Header
    d       *compress.deflate.Writer
    crc     int
    size    int
    out     []byte
    started bool
    closed  bool

    // Write compresses p (writing the header first).
    func Write(p []byte) {
        this.start()
        this.crc = compress.Crc32(this.crc, p)
        this.size += len(p)
        this.d.Write(p)
    }

    // WriteString compresses the bytes of s.
    func WriteString(s string) {
        this.Write(strings.Bytes(s))
    }

    // Flush emits everything written so far (a deflate sync flush); read it with Bytes.
    func Flush() {
        this.start()
        this.d.Flush()
    }

    // Close finishes the stream and appends the trailer (CRC-32 and size).
    func Close() {
        if this.closed {
            return
        }
        this.start()
        this.d.Close()
        this.out = compress.rtConcat(this.out, this.d.Bytes())
        this.out = compress.putLE32(this.out, this.crc)
        this.out = compress.putLE32(this.out, this.size & 4294967295)
        this.closed = true
    }

    // The compressed bytes produced since the last call.
    func Bytes() []byte {
        if !this.closed {
            this.out = compress.rtConcat(this.out, this.d.Bytes())
        }
        var b = this.out
        this.out = []
        return b
    }

    func start() {
        if !this.started {
            this.started = true
            this.out = encodeHeader(this.Header, this.d.level)
        }
    }
}

// NewWriter returns a compressor with level (0-9, -1 for the default).
func NewWriter(level int) *Writer {
    return &Writer{d: compress.deflate.NewWriter(level)}
}

// A streaming gzip decompressor over concatenated members; checksums and
// sizes are verified at the end of each member.
struct Reader {
    state   int
    buf     []byte
    d       *compress.deflate.Reader
    crc     int
    size    int
    members int
    header  Header
    out     []byte

    // Feed decompresses the next chunk of input; read the output with Bytes.
    func Feed(chunk []byte) void! {
        var input = chunk
        for {
            if this.state == 0 {
                this.buf = compress.rtConcat(this.buf, input)
                input = []
                if len(this.buf) == 0 {
                    return
                }
                var h = Header{}
                var n = parseHeader(this.buf, &h)?
                if n < 0 {
                    return
                }
                if this.members == 0 {
                    this.header = h
                }
                input = compress.rtCopy(this.buf, n, len(this.buf))
                this.buf = []
                this.d = compress.deflate.NewReader()
                this.crc = 0
                this.size = 0
                this.state = 1
            }
            if this.state == 1 {
                this.d.Feed(input)?
                input = []
                var b = this.d.Read()
                this.crc = compress.Crc32(this.crc, b)
                this.size += len(b)
                this.out = compress.rtConcat(this.out, b)
                if !this.d.Done() {
                    return
                }
                this.state = 2
                input = this.d.Rest()
            }
            this.buf = compress.rtConcat(this.buf, input)
            input = []
            if len(this.buf) < 8 {
                return
            }
            if compress.le32(this.buf, 0) != this.crc {
                return error("gzip: checksum mismatch")
            }
            if compress.le32(this.buf, 4) != (this.size & 4294967295) {
                return error("gzip: size mismatch")
            }
            this.members += 1
            input = compress.rtCopy(this.buf, 8, len(this.buf))
            this.buf = []
            this.state = 0
            if len(input) == 0 {
                return
            }
        }
    }

    // The decompressed bytes produced since the last call.
    func Read() []byte {
        var b = this.out
        this.out = []
        return b
    }

    // The header of the first member (nil before it was read).
    func Header() *Header {
        if this.members == 0 && this.state == 0 {
            return nil
        }
        var h = this.header
        return &h
    }

    // True when at least one member ended and no other one is in progress.
    func Done() bool {
        return this.members > 0 && this.state == 0 && len(this.buf) == 0
    }

    // Close fails if the input ended in the middle of a member.
    func Close() void! {
        if !this.Done() {
            return error("gzip: unexpected end of compressed data")
        }
    }
}

// NewReader returns a decompressor.
func NewReader() *Reader {
    return &Reader{}
}

// io adapters: gzip.NewStreamReader(src) is an io.Reader of the
// decompressed data of src; gzip.NewStreamWriter(dst, level) is an
// io.Writer that writes gzip data to dst (Close writes the trailer).
struct StreamReader {
    src     io.Reader
    z       *Reader
    pending []byte
    pos     int
    eof     bool

    // Read returns up to len(buf) decompressed bytes; 0 at the end.
    func Read(buf []byte) int! {
        for this.pos >= len(this.pending) {
            if this.eof {
                return 0
            }
            var chunk = compress.rtZeros(32768)
            var n = this.src.Read(chunk)?
            if n == 0 {
                this.eof = true
                this.z.Close()?
            } else {
                this.z.Feed(compress.rtCopy(chunk, 0, n))?
            }
            this.pending = this.z.Read()
            this.pos = 0
        }
        var k = len(this.pending) - this.pos
        if k > len(buf) {
            k = len(buf)
        }
        for i in 0..k {
            buf[i] = this.pending[this.pos + i]
        }
        this.pos += k
        return k
    }

    // The header of the first member (nil before it was read).
    func Header() *Header {
        return this.z.Header()
    }
}

// NewStreamReader returns a reader of the decompressed data of src.
func NewStreamReader(src io.Reader) *StreamReader {
    return &StreamReader{src: src, z: NewReader()}
}

// StreamWriter compresses to an io.Writer.
struct StreamWriter {
    dst io.Writer
    z   *Writer

    // Write compresses buf and writes the output produced so far to dst.
    func Write(buf []byte) int! {
        this.z.Write(buf)
        var b = this.z.Bytes()
        if len(b) > 0 {
            io.WriteAll(this.dst, b)?
        }
        return len(buf)
    }

    // Flush flushes the compressor and writes the output to dst.
    func Flush() void! {
        this.z.Flush()
        io.WriteAll(this.dst, this.z.Bytes())?
    }

    // Close finishes the stream and writes the rest (with the trailer) to dst.
    func Close() void! {
        this.z.Close()
        io.WriteAll(this.dst, this.z.Bytes())?
    }

    // SetHeader sets the gzip header (before the first Write).
    func SetHeader(h Header) {
        this.z.Header = h
    }
}

// NewStreamWriter returns a writer that gzips everything written to it into dst.
func NewStreamWriter(dst io.Writer, level int) *StreamWriter {
    return &StreamWriter{dst: dst, z: NewWriter(level)}
}
