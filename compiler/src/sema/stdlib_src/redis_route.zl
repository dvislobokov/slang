// The router behind a Client (see redis.zl for the file layout): which
// server a command goes to and what happens when it fails.
//
// * single server: one pool;
// * Sentinel (ConnectSentinel): the master's address comes from the first
//   sentinel that knows it (SENTINEL get-master-addr-by-name); a
//   subscription to +switch-master on a sentinel moves the pool to the new
//   master (connections in use are closed when they come back), and a
//   network error or a READONLY reply asks the sentinels again; with
//   ReadFromReplicas read-only commands go to a random replica
//   (SENTINEL replicas);
// * Cluster (ConnectCluster): the slot map from CLUSTER SLOTS, keys hashed
//   with CRC16 mod 16384 (only the {hash tag} if there is one), multi-key
//   commands must hash to one slot (ErrCrossSlot), MOVED updates the map
//   (and reloads it), ASK sends ASKING + the command to the named node;
//   FLUSHALL, FLUSHDB, SCRIPT, KEYS and DBSIZE go to every master.
//
// Retries (Options.MaxRetries, exponential backoff): network errors and
// LOADING, TRYAGAIN, CLUSTERDOWN, MASTERDOWN, READONLY replies.
namespace data.redis

// ---- commands and keys ----------------------------------------------------------

func cmdName(args []any) string {
    if len(args) == 0 {
        return ""
    }
    return strings.ToUpper(strings.FromBytes(argBytes(args[0])))
}

func argText(a any) string {
    return strings.FromBytes(argBytes(a))
}

func keyRange(args []any, from int, to int) []string {
    var out []string = []
    var i = from
    for i < to && i < len(args) {
        out = append(out, argText(args[i]))
        i += 1
    }
    return out
}

// The keys of a command (for cluster routing): a table of the commands
// whose keys are not just their first argument.
func commandKeys(name string, args []any) []string {
    var n = len(args)
    switch name {
        case "PING", "ECHO", "INFO", "AUTH", "SELECT", "HELLO", "CLIENT", "CONFIG", "DBSIZE", "FLUSHALL", "FLUSHDB", "KEYS", "SCAN", "RANDOMKEY", "TIME", "LASTSAVE", "SAVE", "BGSAVE", "BGREWRITEAOF", "PUBLISH", "SPUBLISH", "SCRIPT", "CLUSTER", "COMMAND", "MULTI", "EXEC", "DISCARD", "UNWATCH", "WAIT", "SWAPDB", "ROLE", "READONLY", "READWRITE", "SENTINEL", "DEBUG", "SLOWLOG", "FUNCTION", "QUIT", "SHUTDOWN", "LATENCY", "MONITOR", "ACL", "MODULE", "REPLICAOF", "SLAVEOF", "LOLWUT", "ASKING", "SUBSCRIBE", "PSUBSCRIBE", "UNSUBSCRIBE", "PUNSUBSCRIBE", "PUBSUB":
            return []
        case "DEL", "UNLINK", "EXISTS", "MGET", "TOUCH", "WATCH", "SINTER", "SUNION", "SDIFF", "SINTERSTORE", "SUNIONSTORE", "SDIFFSTORE", "PFCOUNT", "PFMERGE", "RENAME", "RENAMENX", "SMOVE", "RPOPLPUSH", "LMOVE", "BLMOVE", "COPY", "ZDIFF", "ZDIFFSTORE":
            return keyRange(args, 1, n)
        case "MSET", "MSETNX":
            var out []string = []
            var i = 1
            for i < n {
                out = append(out, argText(args[i]))
                i += 2
            }
            return out
        case "EVAL", "EVALSHA", "EVAL_RO", "EVALSHA_RO", "FCALL", "FCALL_RO":
            if n < 3 {
                return []
            }
            var k = try strconv.Atoi(argText(args[2])) else 0
            return keyRange(args, 3, 3 + k)
        case "BLPOP", "BRPOP", "BZPOPMIN", "BZPOPMAX":
            return keyRange(args, 1, n - 1)
        case "ZUNIONSTORE", "ZINTERSTORE":
            if n < 3 {
                return keyRange(args, 1, 2)
            }
            var k = try strconv.Atoi(argText(args[2])) else 0
            var out = keyRange(args, 1, 2)
            for x in keyRange(args, 3, 3 + k) {
                out = append(out, x)
            }
            return out
        case "XREAD", "XREADGROUP":
            for i in 1..n {
                if strings.ToUpper(argText(args[i])) == "STREAMS" {
                    var rest = n - i - 1
                    return keyRange(args, i + 1, i + 1 + rest / 2)
                }
            }
            return []
        case "OBJECT", "MEMORY", "XINFO":
            return keyRange(args, 2, 3)
    }
    return keyRange(args, 1, 2)
}

// Whether a command only reads (Sentinel ReadFromReplicas).
func isReadOnly(name string) bool {
    switch name {
        case "GET", "MGET", "EXISTS", "TTL", "PTTL", "TYPE", "STRLEN", "GETRANGE", "HGET", "HGETALL", "HMGET", "HKEYS", "HVALS", "HLEN", "HEXISTS", "HSTRLEN", "LRANGE", "LLEN", "LINDEX", "SMEMBERS", "SISMEMBER", "SMISMEMBER", "SCARD", "SRANDMEMBER", "SINTER", "SUNION", "SDIFF", "ZRANGE", "ZRANGEBYSCORE", "ZREVRANGE", "ZREVRANGEBYSCORE", "ZRANGEBYLEX", "ZSCORE", "ZMSCORE", "ZRANK", "ZREVRANK", "ZCARD", "ZCOUNT", "KEYS", "SCAN", "HSCAN", "SSCAN", "ZSCAN", "DBSIZE", "XRANGE", "XREVRANGE", "XLEN", "PFCOUNT", "GETBIT", "BITCOUNT", "BITPOS", "RANDOMKEY", "DUMP", "EXPIRETIME", "PEXPIRETIME", "EVAL_RO", "EVALSHA_RO":
            return true
    }
    return false
}

// The cluster slot of a key: CRC16 of the key (or of the first non-empty
// {hash tag}) mod 16384.
func HashSlot(key string) int {
    var s = strings.Index(key, "{")
    if s >= 0 {
        var rest = key[s + 1..]
        var e = strings.Index(rest, "}")
        if e > 0 {
            return data.rtCrc16(rest[..e]) % 16384
        }
    }
    return data.rtCrc16(key) % 16384
}

// ---- the router -------------------------------------------------------------------

// Options of a Sentinel client (ConnectSentinelWith).
struct SentinelOptions {
    // sentinel addresses (host:port)
    Sentinels []string
    MasterName string
    // for the sentinels themselves
    SentinelUsername string
    SentinelPassword string
    // read-only commands go to a random replica
    ReadFromReplicas bool
    // options of the master and replica connections (Addr is ignored)
    Options Options
}

// Options of a Cluster client (ConnectClusterWith).
struct ClusterOptions {
    // some nodes of the cluster (host:port); the rest is discovered
    Nodes []string
    // MOVED / ASK redirects followed per command [8]
    MaxRedirects int
    // options of every node connection (Addr is ignored; DB must be 0)
    Options Options
}

struct core {
    guard int
    opts Options
    // 0 one server, 1 sentinel, 2 cluster
    mode int
    main *pool
    closed bool
    // sentinel
    sopts SentinelOptions
    sentOpts Options
    replicas []*pool
    sentinelIdx int
    watcher *Subscription
    failovers int
    // cluster
    nodes map[string]*pool
    slots []string
    masters []string
    seeds []string
    maxRedirects int
    reloads int

    func process(args []any) Task<Reply!> {
        return coreProcess(this, args)
    }

    func lock() {
        task.rtLock(&this.guard)
    }

    func unlock() {
        task.rtUnlock(&this.guard)
    }

    func isClosed() bool {
        this.lock()
        var c = this.closed
        this.unlock()
        return c
    }

    // The pool of a cluster node (made on first use).
    func nodePool(addr string) *pool {
        this.lock()
        var p = this.nodes[addr]
        if p == nil {
            p = newPool(this.opts, addr)
            this.nodes[addr] = p
        }
        this.unlock()
        return p
    }

    func slotAddr(slot int) string {
        this.lock()
        var a = ""
        if len(this.slots) == 16384 {
            a = this.slots[slot]
        }
        this.unlock()
        return a
    }

    func setSlot(slot int, addr string) {
        this.lock()
        if len(this.slots) == 16384 {
            this.slots[slot] = addr
        }
        this.unlock()
    }

    func masterAddrs() []string {
        this.lock()
        var m = this.masters
        this.unlock()
        return m
    }

    // All pools (statistics, Close).
    func allPools() []*pool {
        var out []*pool = []
        this.lock()
        if this.main != nil {
            out = append(out, this.main)
        }
        for p in this.replicas {
            out = append(out, p)
        }
        for _, p in this.nodes {
            out = append(out, p)
        }
        this.unlock()
        return out
    }

    func randomReplica() *pool {
        this.lock()
        var p *pool
        if len(this.replicas) > 0 {
            p = this.replicas[random.IntN(len(this.replicas))]
        }
        this.unlock()
        return p
    }

    func close() Task<void> {
        return closeCore(this)
    }
}

async func closeCore(c *core) {
    c.lock()
    if c.closed {
        c.unlock()
        return
    }
    c.closed = true
    var w = c.watcher
    c.watcher = nil
    c.unlock()
    for p in c.allPools() {
        p.close()
    }
    if w != nil {
        await w.Close()
    }
}

func newCore(o Options) *core {
    var opts = withDefaults(o)
    return new core{opts: opts, main: newPool(opts, opts.Addr), nodes: map[string]*pool{}}
}

// The pool for a command (cluster: by the slot of its keys).
async func route(c *core, name string, args []any) *pool! {
    if c.mode == 0 {
        return c.main
    }
    if c.mode == 1 {
        if c.sopts.ReadFromReplicas && isReadOnly(name) {
            var r = c.randomReplica()
            if r != nil {
                return r
            }
        }
        return c.main
    }
    var keys = commandKeys(name, args)
    if len(keys) == 0 {
        var ms = c.masterAddrs()
        if len(ms) == 0 {
            await reloadSlots(c)?
            ms = c.masterAddrs()
        }
        return c.nodePool(ms[random.IntN(len(ms))])
    }
    var slot = HashSlot(keys[0])
    for k in keys[1..] {
        if HashSlot(k) != slot {
            return ErrCrossSlot
        }
    }
    var addr = c.slotAddr(slot)
    if addr == "" {
        await reloadSlots(c)?
        addr = c.slotAddr(slot)
        if addr == "" {
            return error("redis: cluster slot " + strconv.Itoa(slot) + " is not served by any node")
        }
    }
    return c.nodePool(addr)
}

// Whether a failed command may be sent again.
func retryableErr(err error) bool {
    if errors.Is(err, task.ErrCancelled) || errors.Is(err, ErrClosed) || errors.Is(err, ErrPoolTimeout) {
        return false
    }
    return errors.Is(err, net.ErrRefused) || errors.Is(err, net.ErrReset) || errors.Is(err, net.ErrEOF) || errors.Is(err, net.ErrClosed) || errors.Is(err, net.ErrUnreachable)
}

func retryableCode(code string) bool {
    return code == "LOADING" || code == "TRYAGAIN" || code == "CLUSTERDOWN" || code == "MASTERDOWN" || code == "READONLY"
}

func maxRetries(o Options) int {
    if o.MaxRetries < 0 {
        return 0
    }
    return o.MaxRetries
}

async func backoff(o Options, attempt int) {
    var d = o.MinRetryBackoff
    for _ in 1..attempt {
        d = d * 2
        if d >= o.MaxRetryBackoff {
            d = o.MaxRetryBackoff
            break
        }
    }
    await task.Delay(d)
}

// One attempt of a command on a pool (asking: ASKING first).
async func once(p *pool, args []any, asking bool) Reply! {
    var cn = await p.get()?
    if asking {
        var rs = try await cn.pipeline([["ASKING"], args]) catch err {
            p.put(cn)
            return err
        }
        p.put(cn)
        return rs[1]
    }
    var r = try await cn.do(args) catch err {
        p.put(cn)
        return err
    }
    p.put(cn)
    return r
}

// "MOVED 3999 127.0.0.1:6381" -> (3999, "127.0.0.1:6381")
func redirect(text string) (int, string) {
    var parts = strings.Fields(text)
    if len(parts) < 3 {
        return (-1, "")
    }
    var slot = try strconv.Atoi(parts[1]) else -1
    return (slot, parts[2])
}

// Reacts to a failure on pool p: Sentinel asks the sentinels for the
// master again, Cluster reloads the slot map.
async func recover(c *core) {
    if c.mode == 1 {
        try await refreshMaster(c) catch _ {
        }
    } else if c.mode == 2 {
        try await reloadSlots(c) catch _ {
        }
    }
}

async func coreProcess(c *core, args []any) Reply! {
    if len(args) == 0 {
        return error("redis: empty command")
    }
    var name = cmdName(args)
    if c.mode == 2 && (name == "FLUSHALL" || name == "FLUSHDB" || name == "SCRIPT" || name == "KEYS" || name == "DBSIZE") {
        return await broadcast(c, name, args)?
    }
    var attempt = 0
    var redirects = 0
    var ask = ""
    var limit = maxRetries(c.opts)
    for {
        if c.isClosed() {
            return ErrClosed
        }
        var asking = ask != ""
        var p *pool
        if asking {
            p = c.nodePool(ask)
        } else {
            p = await route(c, name, args)?
        }
        ask = ""
        var r = try await once(p, args, asking) catch err {
            if attempt < limit && retryableErr(err) {
                attempt += 1
                await backoff(c.opts, attempt)
                await recover(c)
                continue
            }
            return err
        }
        if r.Kind != Kind.Error {
            return r
        }
        var code = ErrorCode(r.Err())
        if c.mode == 2 && (code == "MOVED" || code == "ASK") && redirects < c.maxRedirects {
            redirects += 1
            var (slot, addr) = redirect(r.Str)
            if slot < 0 {
                return r.Err()
            }
            if code == "MOVED" {
                c.setSlot(slot, addr)
                _ = reloadSlotsQuietly(c)
            } else {
                ask = addr
            }
            continue
        }
        if retryableCode(code) && attempt < limit {
            attempt += 1
            await backoff(c.opts, attempt)
            if code == "READONLY" || code == "MASTERDOWN" || code == "CLUSTERDOWN" {
                await recover(c)
            }
            continue
        }
        return r.Err()
    }
}

// A keyless cluster command on every master: FLUSHALL/FLUSHDB/SCRIPT give
// the first reply, KEYS the union, DBSIZE the sum.
async func broadcast(c *core, name string, args []any) Reply! {
    var ms = c.masterAddrs()
    if len(ms) == 0 {
        await reloadSlots(c)?
        ms = c.masterAddrs()
    }
    var first Reply
    var keys []Reply = []
    var sum = 0
    for i, addr in ms {
        var r = await once(c.nodePool(addr), args, false)?
        if r.Kind == Kind.Error {
            return r.Err()
        }
        if i == 0 {
            first = r
        }
        if name == "KEYS" {
            for e in r.Elems {
                keys = append(keys, e)
            }
        } else if name == "DBSIZE" {
            sum += r.Int
        }
    }
    if name == "KEYS" {
        return Reply{Kind: Kind.Array, Elems: keys}
    }
    if name == "DBSIZE" {
        return Reply{Kind: Kind.Int, Int: sum}
    }
    return first
}

// ---- pipelines through the router ----------------------------------------------------

// Runs cmds on one connection of p (multi: inside MULTI/EXEC). Replies
// are per command; a server error is an Error reply.
async func pipelineOn(p *pool, cmds [][]any, multi bool) []Reply! {
    var cn = await p.get()?
    var out = try await pipelineConn(cn, cmds, multi) catch err {
        p.put(cn)
        return err
    }
    p.put(cn)
    return out
}

async func pipelineConn(cn *conn, cmds [][]any, multi bool) []Reply! {
    if !multi {
        return await cn.pipeline(cmds)?
    }
    var all [][]any = [["MULTI"]]
    for x in cmds {
        all = append(all, x)
    }
    all = append(all, ["EXEC"])
    var rs = await cn.pipeline(all)?
    if rs[0].Kind == Kind.Error {
        return rs[0].Err()
    }
    var exec = rs[len(rs) - 1]
    if exec.Kind == Kind.Nil {
        return ErrTxFailed
    }
    if exec.Kind == Kind.Error {
        // EXECABORT: show the queuing errors per command
        var out []Reply = []
        for i in 0..len(cmds) {
            var q = rs[i + 1]
            if q.Kind == Kind.Error {
                out = append(out, q)
            } else {
                out = append(out, exec)
            }
        }
        return out
    }
    return exec.Elems
}

async func corePipeline(c *core, cmds [][]any, multi bool) []Reply! {
    if len(cmds) == 0 {
        return []
    }
    if c.isClosed() {
        return ErrClosed
    }
    var limit = maxRetries(c.opts)
    if c.mode != 2 {
        var attempt = 0
        for {
            var out = try await pipelineOn(c.main, cmds, multi) catch err {
                if attempt < limit && retryableErr(err) {
                    attempt += 1
                    await backoff(c.opts, attempt)
                    await recover(c)
                    continue
                }
                return err
            }
            return out
        }
    }
    if multi {
        // a transaction runs on one node: every key must be in one slot
        var slot = -1
        for x in cmds {
            for k in commandKeys(cmdName(x), x) {
                var s = HashSlot(k)
                if slot >= 0 && s != slot {
                    return ErrCrossSlot
                }
                slot = s
            }
        }
        var p *pool
        if slot < 0 {
            p = await route(c, "PING", ["PING"])?
        } else {
            var addr = c.slotAddr(slot)
            if addr == "" {
                await reloadSlots(c)?
                addr = c.slotAddr(slot)
            }
            p = c.nodePool(addr)
        }
        return await pipelineOn(p, cmds, true)?
    }
    // group by node, then redo redirected or failed commands one by one
    var addrs []string = []
    var groups map[string][]int = map[string][]int{}
    for i, x in cmds {
        var p = await route(c, cmdName(x), x)?
        var a = p.addr
        if groups[a] == nil {
            addrs = append(addrs, a)
            groups[a] = []
        }
        groups[a] = append(groups[a], i)
    }
    var out []Reply = []
    for _ in cmds {
        out = append(out, Reply{})
    }
    for a in addrs {
        var idx = groups[a]
        var part [][]any = []
        for i in idx {
            part = append(part, cmds[i])
        }
        var rs = try await pipelineOn(c.nodePool(a), part, false) catch err {
            if !retryableErr(err) {
                return err
            }
            await recover(c)
            for i in idx {
                out[i] = await processAsReply(c, cmds[i])
            }
            continue
        }
        for j, i in idx {
            var r = rs[j]
            if r.Kind == Kind.Error {
                var code = ErrorCode(r.Err())
                if code == "MOVED" || code == "ASK" || retryableCode(code) {
                    r = await processAsReply(c, cmds[i])
                }
            }
            out[i] = r
        }
    }
    return out
}

// A command through the router with a failure as an Error reply.
async func processAsReply(c *core, args []any) Reply {
    var r = try await coreProcess(c, args) catch err {
        return Reply{Kind: Kind.Error, Str: err.Message()}
    }
    return r
}

// ---- Cluster: the slot map -----------------------------------------------------------

// Loads CLUSTER SLOTS from the first node that answers (known masters,
// then the seeds).
async func reloadSlots(c *core) void! {
    var cands []string = []
    for a in c.masterAddrs() {
        cands = append(cands, a)
    }
    for a in c.seeds {
        cands = append(cands, a)
    }
    var lastErr error = error("redis: no cluster node given")
    for addr in cands {
        var r = try await once(c.nodePool(addr), ["CLUSTER", "SLOTS"], false) catch err {
            lastErr = err
            continue
        }
        if r.Kind == Kind.Error {
            lastErr = r.Err()
            continue
        }
        var host = addr
        var hp = try net.SplitHostPort(addr) else net.HostPort{}
        if hp.Host != "" {
            host = hp.Host
        }
        var slots []string = []
        for _ in 0..16384 {
            slots = append(slots, "")
        }
        var masters []string = []
        var seen = map[string]bool{}
        for rng in r.Elems {
            if len(rng.Elems) < 3 {
                continue
            }
            var from = rng.Elems[0].Int
            var to = rng.Elems[1].Int
            var node = rng.Elems[2]
            if len(node.Elems) < 2 {
                continue
            }
            var ip = try node.Elems[0].Text() else ""
            if ip == "" || ip == "?" {
                ip = host
            }
            var a = net.JoinHostPort(ip, node.Elems[1].Int)
            if !seen[a] {
                seen[a] = true
                masters = append(masters, a)
            }
            var s = from
            for s <= to && s < 16384 {
                slots[s] = a
                s += 1
            }
        }
        c.lock()
        c.slots = slots
        c.masters = masters
        c.reloads += 1
        c.unlock()
        return
    }
    return lastErr
}

async func reloadSlotsQuietly(c *core) {
    try await reloadSlots(c) catch _ {
    }
}

// ---- Sentinel ---------------------------------------------------------------------------

func sentinelOptions(so SentinelOptions) Options {
    var o = withDefaults(Options{})
    o.Username = so.SentinelUsername
    o.Password = so.SentinelPassword
    o.Protocol = 2
    o.TLS = so.Options.TLS
    o.DialTimeout = so.Options.DialTimeout
    if o.DialTimeout <= 0 {
        o.DialTimeout = 2000
    }
    o.ReadTimeout = so.Options.ReadTimeout
    if o.ReadTimeout <= 0 {
        o.ReadTimeout = 3000
    }
    return o
}

// Runs one command on the sentinels, starting with the last one that
// answered.
async func askSentinels(c *core, args []any) Reply! {
    var n = len(c.sopts.Sentinels)
    var lastErr error = error("redis: no sentinel given")
    for k in 0..n {
        var i = (c.sentinelIdx + k) % n
        var addr = c.sopts.Sentinels[i]
        var cn = try await dial(c.sentOpts, addr) catch err {
            lastErr = err
            continue
        }
        var r = try await cn.do(args) catch err {
            cn.close()
            lastErr = err
            continue
        }
        cn.close()
        if r.Kind == Kind.Error {
            lastErr = r.Err()
            continue
        }
        if r.Kind == Kind.Nil {
            lastErr = error("redis: sentinel " + addr + " does not know master " + strconv.Quote(c.sopts.MasterName))
            continue
        }
        c.sentinelIdx = i
        return r
    }
    return lastErr
}

async func masterAddr(c *core) string! {
    var r = await askSentinels(c, ["SENTINEL", "get-master-addr-by-name", c.sopts.MasterName])?
    var parts = r.Strings()?
    if len(parts) != 2 {
        return error("redis: bad SENTINEL get-master-addr-by-name reply " + r.String())
    }
    return net.JoinHostPort(parts[0], strconv.Atoi(parts[1])?("redis: sentinel master port"))
}

// Healthy replicas of the master (SENTINEL replicas).
async func replicaAddrs(c *core) []string! {
    var r = await askSentinels(c, ["SENTINEL", "replicas", c.sopts.MasterName])?
    var out []string = []
    for e in r.Elems {
        var m = e.StringMap()?
        var flags = m["flags"]
        if strings.Contains(flags, "s_down") || strings.Contains(flags, "o_down") || strings.Contains(flags, "disconnected") {
            continue
        }
        if m["master-link-status"] == "err" {
            continue
        }
        var port = try strconv.Atoi(m["port"]) else 0
        if m["ip"] != "" && port > 0 {
            out = append(out, net.JoinHostPort(m["ip"], port))
        }
    }
    return out
}

// Points the master pool at the sentinels' current master and refreshes
// the replica pools.
async func refreshMaster(c *core) void! {
    var addr = await masterAddr(c)?
    if c.main.currentAddr() != addr {
        c.lock()
        c.failovers += 1
        c.unlock()
        c.main.setAddr(addr)
    }
    if c.sopts.ReadFromReplicas {
        await refreshReplicas(c)?
    }
}

async func refreshReplicas(c *core) void! {
    var addrs = await replicaAddrs(c)?
    var ps []*pool = []
    c.lock()
    var old = c.replicas
    c.unlock()
    var keep = map[string]bool{}
    for a in addrs {
        var found *pool
        for p in old {
            if p.addr == a {
                found = p
            }
        }
        if found == nil {
            found = newPool(c.opts, a)
        }
        keep[a] = true
        ps = append(ps, found)
    }
    c.lock()
    c.replicas = ps
    c.unlock()
    for p in old {
        if !keep[p.addr] {
            p.close()
        }
    }
}

// A message of +switch-master: "<name> <old ip> <old port> <new ip> <new port>".
async func onSentinelMessage(c *core, m Message) {
    if m.Channel == "+switch-master" {
        var f = strings.Fields(m.Payload)
        if len(f) == 5 && f[0] == c.sopts.MasterName {
            var port = try strconv.Atoi(f[4]) else 0
            if port > 0 {
                var addr = net.JoinHostPort(f[3], port)
                if c.main.currentAddr() != addr {
                    c.lock()
                    c.failovers += 1
                    c.unlock()
                    c.main.setAddr(addr)
                }
            }
        }
    }
    if c.sopts.ReadFromReplicas && (m.Channel == "+switch-master" || m.Channel == "+slave" || m.Channel == "+sdown" || m.Channel == "-sdown") {
        try await refreshReplicas(c) catch _ {
        }
    }
}

// Dials the next sentinel that answers (the watcher's connection).
async func dialSentinel(c *core) *conn! {
    var n = len(c.sopts.Sentinels)
    var lastErr error = error("redis: no sentinel given")
    for k in 0..n {
        var i = (c.sentinelIdx + k) % n
        var cn = try await dial(c.sentOpts, c.sopts.Sentinels[i]) catch err {
            lastErr = err
            continue
        }
        return cn
    }
    return lastErr
}

// Watches the sentinels for failovers; after a reconnect of the watcher
// the master is looked up again (a switch may have been missed).
async func watchSentinels(c *core) void! {
    var w = weakCore{c: c}
    var st = newSubState(func() Task<*conn!> {
        return dialWatcher(w)
    })
    st.onMessage = func(m Message) Task<void> {
        return deliverSentinel(w, m)
    }
    st.onReconnect = func() Task<void> {
        return refreshWeak(w)
    }
    var sub = await startSubscription(st)?
    try await sub.Subscribe(["+switch-master", "+slave", "+sdown", "-sdown"]) catch err {
        await sub.Close()
        return err
    }
    c.lock()
    c.watcher = sub
    c.unlock()
}

// The watcher's callbacks hold the router weakly (no cycle through the
// subscription's closures).
struct weakCore {
    c weak *core
}

async func dialWatcher(w weakCore) *conn! {
    var c = w.c
    if c == nil {
        return ErrClosed
    }
    return await dialSentinel(c)?
}

async func deliverSentinel(w weakCore, m Message) {
    var c = w.c
    if c != nil {
        await onSentinelMessage(c, m)
    }
}

async func refreshWeak(w weakCore) {
    var c = w.c
    if c != nil {
        try await refreshMaster(c) catch _ {
        }
    }
}
