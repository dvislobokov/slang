// TLS client handshake (part of std.net.tls, see tls.zl): TLS 1.3 with
// HelloRetryRequest, PSK resumption from tickets, client certificates and
// the middlebox-compatibility change_cipher_spec; TLS 1.2 ECDHE + AEAD
// with extended_master_secret (required), RFC 5077 tickets and the
// RFC 8446 4.1.3 downgrade sentinel check.
namespace std.net.tls

// SHA-256("HelloRetryRequest"), the ServerHello.random of a HelloRetryRequest.
func hrrRandom() []byte {
    return try std.encoding.hex.Decode(
        "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c",
    ) else []
}

// "DOWNGRD" + 01: the last 8 bytes of ServerHello.random when a TLS 1.3
// server negotiates TLS 1.2.
func downgradeSentinel() []byte {
    return [byte(68), byte(79), byte(87), byte(78), byte(71), byte(82), byte(68), byte(1)]
}

// The content signed by CertificateVerify in TLS 1.3 (RFC 8446 4.4.3).
func signedContent13(server bool, th []byte) []byte {
    var b = newBuilder()
    for len(b.b) < 64 {
        b.u8(32)
    }
    if server {
        b.raw(bytesOf("TLS 1.3, server CertificateVerify"))
    } else {
        b.raw(bytesOf("TLS 1.3, client CertificateVerify"))
    }
    b.u8(0)
    b.raw(th)
    return b.bytes()
}

// The handshake messages for a certificate chain.
func certificateBody(chain []*std.crypto.x509.Certificate, v13 bool, context []byte) []byte {
    var b = newBuilder()
    if v13 {
        b.vec8(context)
    }
    var l = b.open(3)
    for cert in chain {
        b.vec24(cert.Raw)
        if v13 {
            b.u16(0)
        }
    }
    b.close(l, 3)
    return b.bytes()
}

// Parses a Certificate message into certificates (leaf first).
func parseCertificates(c *conn, body []byte, v13 bool) []*std.crypto.x509.Certificate! {
    var p = newParser(body)
    if v13 {
        var ctx = p.vec8()
        if len(ctx) != 0 && c.isClient {
            return c.fail(47, "unexpected certificate request context")
        }
    }
    var list = newParser(p.vec24())
    if !p.ok() || !p.empty() {
        return c.fail(50, "malformed Certificate message")
    }
    var out []*std.crypto.x509.Certificate = []
    for !list.empty() {
        var der = list.vec24()
        if v13 {
            _ = list.vec16()
        }
        if !list.ok() {
            return c.fail(50, "malformed Certificate message")
        }
        var cert = try std.crypto.x509.ParseDER(der) catch err {
            return c.fail(42, "bad certificate from the peer: " + err.Message())
        }
        out = append(out, cert)
    }
    return out
}

// Alert for a certificate verification error.
func certAlert(msg string) int {
    if std.strings.Contains(msg, "unknown authority") {
        return 48
    }
    if std.strings.Contains(msg, "expired") || std.strings.Contains(msg, "not valid yet") {
        return 45
    }
    return 42
}

// Verifies the server chain against the client configuration.
func verifyServer(c *conn) void! {
    if c.cfg.InsecureSkipVerify {
        return
    }
    var inter []*std.crypto.x509.Certificate = []
    for i in 1..len(c.peerCerts) {
        inter = append(inter, c.peerCerts[i])
    }
    var chain = try std.crypto.x509.Verify(c.peerCerts[0], std.crypto.x509.VerifyOptions{
        DNSName: c.serverName,
        Roots: c.cfg.RootCAs,
        Intermediates: inter,
    }) catch err {
        return c.fail(
            certAlert(err.Message()),
            "server certificate: " + std.strings.TrimPrefix(err.Message(), "x509: "),
        )
    }
    c.verified = chain
}

// The state of one client handshake.
struct clientHS {
    c         *conn
    minV      int
    maxV      int
    random    []byte
    sessionID []byte
    share     keyShare
    cookie    []byte
    sess      *session
    // session hash compatible with the PSK offered (TLS 1.3)
    pskHash   string
    offered12 []int
    offered13 []int
    sentCCS   bool

    // The ClientHello body; binder placeholders are zero.
    func helloBody(withPSK bool) []byte {
        var cfg = this.c.cfg
        var host = this.c.serverName
        var b = newBuilder()
        b.u16(771)
        b.raw(this.random)
        b.vec8(this.sessionID)
        var cs = b.open(2)
        for s in this.offered13 {
            b.u16(s)
        }
        for s in this.offered12 {
            b.u16(s)
        }
        b.close(cs, 2)
        b.u8(1)
        b.u8(0)
        var ext = b.open(2)
        if host != "" && !std.net.rtIsIP(host) {
            b.u16(0)
            var e = b.open(2)
            var l = b.open(2)
            b.u8(0)
            b.vec16(bytesOf(std.strings.TrimSuffix(host, ".")))
            b.close(l, 2)
            b.close(e, 2)
        }
        if this.minV <= 771 {
            // extended_master_secret, encrypt_then_mac (moot with AEAD suites,
            // RFC 7366 3), renegotiation_info, ec_point_formats
            b.u16(23)
            b.u16(0)
            b.u16(22)
            b.u16(0)
            b.u16(65281)
            b.u16(1)
            b.u8(0)
            b.u16(11)
            b.u16(2)
            b.u8(1)
            b.u8(0)
            if cfg.Sessions != nil {
                b.u16(35)
                if this.sess != nil && this.sess.version == 771 {
                    b.vec16(this.sess.ticket)
                } else {
                    b.u16(0)
                }
            }
        }
        b.u16(10)
        var g = b.open(2)
        var gl = b.open(2)
        b.u16(29)
        b.u16(23)
        b.u16(24)
        b.close(gl, 2)
        b.close(g, 2)
        b.u16(13)
        var sa = b.open(2)
        var sal = b.open(2)
        for s in ourSchemes() {
            b.u16(s)
        }
        b.close(sal, 2)
        b.close(sa, 2)
        if len(cfg.ALPN) > 0 {
            b.u16(16)
            var a = b.open(2)
            var al = b.open(2)
            for proto in cfg.ALPN {
                b.vec8(bytesOf(proto))
            }
            b.close(al, 2)
            b.close(a, 2)
        }
        if this.maxV >= 772 {
            b.u16(43)
            var v = b.open(2)
            var vl = b.open(1)
            b.u16(772)
            if this.minV <= 771 {
                b.u16(771)
            }
            b.close(vl, 1)
            b.close(v, 2)
            b.u16(45)
            b.u16(2)
            b.u8(1)
            b.u8(1)
            b.u16(51)
            var k = b.open(2)
            var kl = b.open(2)
            b.u16(this.share.group)
            b.vec16(this.share.pub)
            b.close(kl, 2)
            b.close(k, 2)
            if len(this.cookie) > 0 {
                b.u16(44)
                var ck = b.open(2)
                b.vec16(this.cookie)
                b.close(ck, 2)
            }
            if withPSK {
                // pre_shared_key must be the last extension
                var s = this.sess
                var age = (std.time.Now() - s.received + s.ageAdd) % 4294967296
                b.u16(41)
                var pe = b.open(2)
                var ids = b.open(2)
                b.vec16(s.ticket)
                b.u32(age)
                b.close(ids, 2)
                var bl = b.open(2)
                b.vec8(rtZeros(hashLen(this.pskHash)))
                b.close(bl, 2)
                b.close(pe, 2)
            }
        }
        b.close(ext, 2)
        return b.bytes()
    }

    // Queues a ClientHello (with the PSK binder filled in).
    func sendHello() void! {
        var c = this.c
        var withPSK = this.sess != nil && this.sess.version == 772 && this.pskHash != ""
        var body = this.helloBody(withPSK)
        var hb = newBuilder()
        hb.u8(1)
        hb.vec24(body)
        var msg = hb.bytes()
        if withPSK {
            var hl = hashLen(this.pskHash)
            var truncated = msg[..len(msg) - (hl + 3)]
            var early = earlySecret(this.pskHash, this.sess.secret)?
            var empty = hashOf(this.pskHash, [])?
            var binderKey = DeriveSecret(this.pskHash, early, "res binder", empty)?
            var th = hashOf(this.pskHash, cat(c.transcript, truncated))?
            var binder = finishedMAC(this.pskHash, binderKey, th)?
            rtCopy(msg, len(msg) - hl, binder)
        }
        c.transcript = cat(c.transcript, msg)
        c.queue(22, msg)
    }
}

// Parsed ServerHello.
struct serverHello {
    version         int
    random          []byte
    sessionID       []byte
    suite           int
    selectedVersion int
    keyShareGroup   int
    keyShare        []byte
    hasPSK          bool
    pskIdentity     int
    cookie          []byte
    alpn            string
    hasALPN         bool
    ems             bool
    ticketExt       bool
    reneg           bool
    renegOK         bool
}

func parseServerHello(c *conn, body []byte) serverHello! {
    var p = newParser(body)
    var sh = serverHello{version: p.u16(), random: p.take(32), sessionID: p.vec8(), suite: p.u16()}
    var comp = p.u8()
    if !p.ok() || comp != 0 {
        return c.fail(50, "malformed ServerHello")
    }
    if p.empty() {
        return sh
    }
    var exts = newParser(p.vec16())
    if !p.ok() || !p.empty() {
        return c.fail(50, "malformed ServerHello extensions")
    }
    var seen []int = []
    for !exts.empty() {
        var typ = exts.u16()
        var data = exts.vec16()
        if !exts.ok() {
            return c.fail(50, "malformed ServerHello extension")
        }
        if containsInt(seen, typ) {
            return c.fail(47, "duplicate extension in ServerHello")
        }
        seen = append(seen, typ)
        var e = newParser(data)
        switch typ {
            case 43:
                sh.selectedVersion = e.u16()
            case 51:
                sh.keyShareGroup = e.u16()
                if !e.empty() {
                    sh.keyShare = e.vec16()
                }
            case 41:
                sh.hasPSK = true
                sh.pskIdentity = e.u16()
            case 44:
                sh.cookie = e.vec16()
            case 16:
                var list = newParser(e.vec16())
                sh.alpn = std.strings.FromBytes(list.vec8())
                sh.hasALPN = true
                if !list.ok() || !list.empty() {
                    return c.fail(50, "malformed ALPN extension")
                }
            case 23:
                sh.ems = true
            case 35:
                sh.ticketExt = true
            case 65281:
                sh.reneg = true
                sh.renegOK = len(data) == 1 && int(data[0]) == 0
                e.off = len(data)
            case 22, 11, 0:
                e.off = len(data)
            default:
                return c.fail(110, std.fmt.Format("unsupported extension {0} in ServerHello", typ))
        }
        if !e.ok() || !e.empty() {
            return c.fail(50, std.fmt.Format("malformed extension {0} in ServerHello", typ))
        }
    }
    return sh
}

// Applies the ALPN answer of the server.
func checkALPN(c *conn, has bool, proto string) void! {
    if !has {
        return
    }
    var ok = false
    for p in c.cfg.ALPN {
        if p == proto {
            ok = true
        }
    }
    if !ok {
        return c.fail(120, "server selected an application protocol that was not offered")
    }
    c.alpn = proto
}

async func runClient(c *conn) void! {
    var cfg = c.cfg
    var h = new clientHS{c: c, minV: minVersion(cfg.MinVersion), maxV: maxVersion(cfg.MaxVersion)}
    if h.minV > h.maxV {
        return error("tls: MinVersion is newer than MaxVersion")
    }
    h.random = randomBytes(32)?
    h.sessionID = randomBytes(32)?
    if h.maxV >= 772 {
        h.offered13 = suites13()
        h.share = newKeyShare(29)?
    }
    if h.minV <= 771 {
        h.offered12 = suites12()
    }
    if cfg.Sessions != nil {
        c.sessionKey = c.serverName
        var s = cfg.Sessions.get(c.sessionKey)
        if s != nil && s.version >= h.minV && s.version <= h.maxV {
            h.sess = s
            if s.version == 772 {
                h.pskHash = suiteByID(s.suite).hash
            }
        }
    }
    h.sendHello()?
    await c.flush()?
    var m = await c.expect(2, "ServerHello")?
    var sh = parseServerHello(c, m.body)?
    var retried = false
    if same(sh.random, hrrRandom()) {
        // HelloRetryRequest (RFC 8446 4.1.4)
        retried = true
        var s = suiteByID(sh.suite)
        if sh.selectedVersion != 772 || !containsInt(h.offered13, sh.suite) || !s.v13 {
            return c.fail(47, "invalid HelloRetryRequest")
        }
        if sh.keyShareGroup == 0 && len(sh.cookie) == 0 {
            return c.fail(47, "HelloRetryRequest changes nothing")
        }
        if sh.keyShareGroup != 0 {
            if (sh.keyShareGroup != 29 && sh.keyShareGroup != 23 && sh.keyShareGroup != 24) ||
                sh.keyShareGroup == h.share.group {
                return c.fail(47, "HelloRetryRequest asks for an unsupported group")
            }
            h.share = newKeyShare(sh.keyShareGroup)?
        }
        h.cookie = sh.cookie
        c.suite = s
        var ch1 = hashOf(s.hash, c.transcript)?
        var mh = newBuilder()
        mh.u8(254)
        mh.u24(len(ch1))
        mh.raw(ch1)
        c.transcript = cat(mh.bytes(), m.raw)
        if h.pskHash != "" && h.pskHash != s.hash {
            h.pskHash = ""
        }
        // middlebox compatibility: a change_cipher_spec before the second hello
        c.queue(20, [byte(1)])
        h.sentCCS = true
        h.sendHello()?
        await c.flush()?
        m = await c.expect(2, "ServerHello")?
        sh = parseServerHello(c, m.body)?
        if same(sh.random, hrrRandom()) {
            return c.fail(10, "second HelloRetryRequest")
        }
        if sh.suite != c.suite.id {
            return c.fail(47, "ServerHello cipher suite differs from the HelloRetryRequest")
        }
    }
    var vers = sh.version
    if sh.selectedVersion != 0 {
        if sh.selectedVersion != 772 || h.maxV < 772 {
            return c.fail(47, "server selected an unsupported version")
        }
        vers = 772
    } else if retried {
        return c.fail(47, "TLS 1.2 ServerHello after a HelloRetryRequest")
    }
    if vers < h.minV || vers > h.maxV {
        return c.fail(
            70,
            "server selected " + versionName(vers) + ", outside the configured versions",
        )
    }
    c.addTranscript(m)
    if vers == 772 {
        await client13(h, sh)?
    } else {
        await client12(h, sh)?
    }
}

async func client13(h *clientHS, sh serverHello) void! {
    var c = h.c
    var s = suiteByID(sh.suite)
    if !containsInt(h.offered13, sh.suite) {
        return c.fail(47, "server selected a cipher suite that was not offered")
    }
    if !same(sh.sessionID, h.sessionID) {
        return c.fail(47, "server did not echo the session id")
    }
    c.suite = s
    c.vers = 772
    var hh = s.hash
    var psk []byte = []
    if sh.hasPSK {
        if h.pskHash == "" || sh.pskIdentity != 0 || h.pskHash != hh {
            return c.fail(47, "server selected a PSK that was not offered")
        }
        psk = h.sess.secret
        c.resumed = true
        c.peerCerts = h.sess.peerCerts
        c.verified = h.sess.verified
    }
    if sh.keyShareGroup != h.share.group || len(sh.keyShare) == 0 {
        return c.fail(47, "server key share does not match the offered group")
    }
    var shared = try sharedSecret(h.share, sh.keyShare) catch err {
        return c.fail(47, err.Message())
    }
    var early = earlySecret(hh, psk)?
    var hs = nextSecret(hh, early, shared)?
    var th = c.transcriptHash()?
    var cHS = DeriveSecret(hh, hs, "c hs traffic", th)?
    var sHS = DeriveSecret(hh, hs, "s hs traffic", th)?
    c.rd = cipher13(s, sHS)?
    // EncryptedExtensions
    var ee = await c.expect(8, "EncryptedExtensions")?
    var p = newParser(ee.body)
    var exts = newParser(p.vec16())
    if !p.ok() || !p.empty() {
        return c.fail(50, "malformed EncryptedExtensions")
    }
    for !exts.empty() {
        var typ = exts.u16()
        var data = exts.vec16()
        if typ == 16 {
            var e = newParser(data)
            var list = newParser(e.vec16())
            var proto = std.strings.FromBytes(list.vec8())
            if !e.ok() || !list.ok() || !list.empty() {
                return c.fail(50, "malformed ALPN extension")
            }
            checkALPN(c, true, proto)?
        } else if typ == 43 || typ == 51 || typ == 41 {
            return c.fail(47, "forbidden extension in EncryptedExtensions")
        }
    }
    if !exts.ok() {
        return c.fail(50, "malformed EncryptedExtensions")
    }
    c.addTranscript(ee)
    var certReq = false
    var reqContext []byte = []
    var reqSchemes []int = []
    if !c.resumed {
        var msg = await c.readHandshake()?
        if msg.typ == 13 {
            certReq = true
            var cp = newParser(msg.body)
            reqContext = cp.vec8()
            var re = newParser(cp.vec16())
            for !re.empty() {
                var typ = re.u16()
                var data = re.vec16()
                if typ == 13 {
                    var sp = newParser(data)
                    var lp = newParser(sp.vec16())
                    for !lp.empty() {
                        reqSchemes = append(reqSchemes, lp.u16())
                    }
                }
            }
            if !cp.ok() || !re.ok() {
                return c.fail(50, "malformed CertificateRequest")
            }
            c.addTranscript(msg)
            msg = await c.readHandshake()?
        }
        if msg.typ != 11 {
            return c.fail(10, "expected the server Certificate")
        }
        c.peerCerts = parseCertificates(c, msg.body, true)?
        if len(c.peerCerts) == 0 {
            return c.fail(50, "server sent no certificate")
        }
        c.addTranscript(msg)
        verifyServer(c)?
        var cv = await c.expect(15, "CertificateVerify")?
        var vp = newParser(cv.body)
        var scheme = vp.u16()
        var sig = vp.vec16()
        if !vp.ok() || !vp.empty() {
            return c.fail(50, "malformed CertificateVerify")
        }
        if !containsInt(ourSchemes(), scheme) {
            return c.fail(47, "server used a signature scheme that was not offered")
        }
        var content = signedContent13(true, c.transcriptHash()?)
        try verifyWith(c.peerCerts[0], scheme, content, sig, true) catch err {
            return c.fail(51, std.strings.TrimPrefix(err.Message(), "tls: "))
        }
        c.addTranscript(cv)
    }
    var fin = await c.expect(20, "Finished")?
    var want = finishedMAC(hh, sHS, c.transcriptHash()?)?
    if !std.crypto.hmac.Equal(want, fin.body) {
        return c.fail(51, "server Finished verification failed")
    }
    c.addTranscript(fin)
    var master = nextSecret(hh, hs, [])?
    var th2 = c.transcriptHash()?
    var cAP = DeriveSecret(hh, master, "c ap traffic", th2)?
    var sAP = DeriveSecret(hh, master, "s ap traffic", th2)?
    // middlebox compatibility change_cipher_spec (once), then our flight
    if !h.sentCCS {
        c.queue(20, [byte(1)])
    }
    c.wr = cipher13(s, cHS)?
    if certReq {
        var cc = c.cfg.ClientCert
        var chain []*std.crypto.x509.Certificate = []
        if cc != nil {
            chain = cc.Chain
        }
        c.queueHandshake(11, certificateBody(chain, true, reqContext))
        if cc != nil {
            var scheme = pickScheme(cc.Key, reqSchemes, true)
            if scheme == 0 {
                return c.fail(40, "no signature scheme for the client certificate")
            }
            var sig = signWith(cc.Key, scheme, signedContent13(false, c.transcriptHash()?))?
            var b = newBuilder()
            b.u16(scheme)
            b.vec16(sig)
            c.queueHandshake(15, b.bytes())
        }
    }
    var mine = finishedMAC(hh, cHS, c.transcriptHash()?)?
    c.queueHandshake(20, mine)
    await c.flush()?
    c.wr = cipher13(s, cAP)?
    c.rd = cipher13(s, sAP)?
    c.resMaster = DeriveSecret(hh, master, "res master", c.transcriptHash()?)?
}

// Stores a TLS 1.3 NewSessionTicket for resumption.
func handleTicket13(c *conn, m hsMsg) void! {
    var p = newParser(m.body)
    var lifetime = p.u32()
    var ageAdd = p.u32()
    var nonce = p.vec8()
    var ticket = p.vec16()
    _ = p.vec16()
    if !p.ok() || !p.empty() || len(ticket) == 0 {
        return c.fail(50, "malformed NewSessionTicket")
    }
    if c.cfg.Sessions == nil || lifetime == 0 || len(c.resMaster) == 0 {
        return
    }
    if lifetime > 604800 {
        lifetime = 604800
    }
    var hh = c.suite.hash
    var psk = ExpandLabel(hh, c.resMaster, "resumption", nonce, hashLen(hh))?
    c.cfg.Sessions.put(
        c.sessionKey,
        new session{
            version: 772,
            suite: c.suite.id,
            ticket: ticket,
            secret: psk,
            ageAdd: ageAdd,
            received: std.time.Now(),
            lifetime: lifetime,
            alpn: c.alpn,
            peerCerts: c.peerCerts,
            verified: c.verified,
        },
    )
}

// TLS 1.2 traffic keys from the master secret: (client, server) cipher states.
struct keys12 {
    client cipherState
    server cipherState
}

func deriveKeys12(s suiteInfo, master []byte, clientRandom []byte, serverRandom []byte) keys12! {
    var ivLen = 4
    if s.aead == 2 {
        ivLen = 12
    }
    var kb = prf12(
        s.hash,
        master,
        "key expansion",
        cat(serverRandom, clientRandom),
        2 * s.keyLen + 2 * ivLen,
    )?
    var k = s.keyLen
    var ck = kb[..k]
    var sk = kb[k..2 * k]
    var civ = kb[2 * k..2 * k + ivLen]
    var siv = kb[2 * k + ivLen..2 * k + 2 * ivLen]
    return keys12{client: cipher12(s, ck, civ)?, server: cipher12(s, sk, siv)?}
}

func finished12(c *conn, label string) []byte! {
    return prf12(c.suite.hash, c.master, label, c.transcriptHash()?, 12)?
}

async func client12(h *clientHS, sh serverHello) void! {
    var c = h.c
    var cfg = c.cfg
    c.vers = 771
    if h.maxV >= 772 && same(sh.random[24..], downgradeSentinel()) {
        return c.fail(47, "downgrade attempt detected (TLS 1.3 server answered with TLS 1.2)")
    }
    if !containsInt(h.offered12, sh.suite) {
        return c.fail(47, "server selected a cipher suite that was not offered")
    }
    var s = suiteByID(sh.suite)
    c.suite = s
    if !sh.ems {
        return c.fail(
            40,
            "server does not support extended_master_secret (RFC 7627), which is required",
        )
    }
    if sh.reneg && !sh.renegOK {
        return c.fail(40, "invalid renegotiation_info")
    }
    checkALPN(c, sh.hasALPN, sh.alpn)?
    c.clientRandom = h.random
    c.serverRandom = sh.random
    if h.sess != nil &&
        h.sess.version == 771 &&
        len(sh.sessionID) > 0 &&
        same(sh.sessionID, h.sessionID) {
        // abbreviated handshake (RFC 5077 3.1)
        if h.sess.suite != sh.suite {
            return c.fail(47, "resumed session with a different cipher suite")
        }
        c.resumed = true
        c.master = h.sess.secret
        c.peerCerts = h.sess.peerCerts
        c.verified = h.sess.verified
        var ks = deriveKeys12(s, c.master, c.clientRandom, c.serverRandom)?
        c.pendRd = ks.server
        var m = await c.readHandshake()?
        if m.typ == 4 {
            store12Ticket(c, m)?
            m = await c.readHandshake()?
        }
        if m.typ != 20 || !c.rd.active() {
            return c.fail(10, "expected the server Finished")
        }
        var want = finished12(c, "server finished")?
        if !std.crypto.hmac.Equal(want, m.body) {
            return c.fail(51, "server Finished verification failed")
        }
        c.addTranscript(m)
        c.queue(20, [byte(1)])
        c.wr = ks.client
        c.queueHandshake(20, finished12(c, "client finished")?)
        await c.flush()?
        return
    }
    if h.sess != nil && cfg.Sessions != nil {
        cfg.Sessions.remove(c.sessionKey)
    }
    var cm = await c.expect(11, "Certificate")?
    c.peerCerts = parseCertificates(c, cm.body, false)?
    if len(c.peerCerts) == 0 {
        return c.fail(50, "server sent no certificate")
    }
    c.addTranscript(cm)
    verifyServer(c)?
    var leaf = c.peerCerts[0]
    var leafAuth = leaf.PublicKeyAlgorithm
    if leafAuth == "Ed25519" {
        leafAuth = "ECDSA"
    }
    if leafAuth != s.auth {
        return c.fail(42, "certificate key type does not match the cipher suite")
    }
    var ske = await c.expect(12, "ServerKeyExchange")?
    var p = newParser(ske.body)
    var curveType = p.u8()
    var group = p.u16()
    var point = p.vec8()
    var paramsLen = p.off
    var scheme = p.u16()
    var sig = p.vec16()
    if !p.ok() || !p.empty() || curveType != 3 {
        return c.fail(50, "malformed ServerKeyExchange")
    }
    if group != 29 && group != 23 && group != 24 {
        return c.fail(47, "server selected an unsupported group")
    }
    if !containsInt(ourSchemes(), scheme) {
        return c.fail(47, "server used a signature scheme that was not offered")
    }
    var signed = cat3(c.clientRandom, c.serverRandom, ske.body[..paramsLen])
    try verifyWith(leaf, scheme, signed, sig, false) catch err {
        return c.fail(51, std.strings.TrimPrefix(err.Message(), "tls: "))
    }
    c.addTranscript(ske)
    var next = await c.readHandshake()?
    var certReq = false
    var reqSchemes []int = []
    if next.typ == 13 {
        certReq = true
        var rp = newParser(next.body)
        _ = rp.vec8()
        var sl = newParser(rp.vec16())
        for !sl.empty() {
            reqSchemes = append(reqSchemes, sl.u16())
        }
        _ = rp.vec16()
        if !rp.ok() || !sl.ok() {
            return c.fail(50, "malformed CertificateRequest")
        }
        c.addTranscript(next)
        next = await c.readHandshake()?
    }
    if next.typ != 14 || len(next.body) != 0 {
        return c.fail(10, "expected ServerHelloDone")
    }
    c.addTranscript(next)
    var share = newKeyShare(group)?
    var pre = try sharedSecret(share, point) catch err {
        return c.fail(47, err.Message())
    }
    var cc = cfg.ClientCert
    if certReq {
        var chain []*std.crypto.x509.Certificate = []
        if cc != nil {
            chain = cc.Chain
        }
        c.queueHandshake(11, certificateBody(chain, false, []))
    }
    var ckx = newBuilder()
    ckx.vec8(share.pub)
    c.queueHandshake(16, ckx.bytes())
    c.master = prf12(s.hash, pre, "extended master secret", c.transcriptHash()?, 48)?
    if certReq && cc != nil {
        var sch = pickScheme(cc.Key, reqSchemes, false)
        if sch == 0 {
            return c.fail(40, "no signature scheme for the client certificate")
        }
        var csig = signWith(cc.Key, sch, c.transcript)?
        var cvb = newBuilder()
        cvb.u16(sch)
        cvb.vec16(csig)
        c.queueHandshake(15, cvb.bytes())
    }
    var ks = deriveKeys12(s, c.master, c.clientRandom, c.serverRandom)?
    c.queue(20, [byte(1)])
    c.wr = ks.client
    c.queueHandshake(20, finished12(c, "client finished")?)
    await c.flush()?
    c.pendRd = ks.server
    var m = await c.readHandshake()?
    if m.typ == 4 {
        store12Ticket(c, m)?
        m = await c.readHandshake()?
    }
    if m.typ != 20 || !c.rd.active() {
        return c.fail(10, "expected the server Finished")
    }
    var want = finished12(c, "server finished")?
    if !std.crypto.hmac.Equal(want, m.body) {
        return c.fail(51, "server Finished verification failed")
    }
    c.addTranscript(m)
}

// Stores a TLS 1.2 NewSessionTicket (RFC 5077 3.3).
func store12Ticket(c *conn, m hsMsg) void! {
    var p = newParser(m.body)
    var lifetime = p.u32()
    var ticket = p.vec16()
    if !p.ok() || !p.empty() {
        return c.fail(50, "malformed NewSessionTicket")
    }
    c.addTranscript(m)
    if c.cfg.Sessions == nil || len(ticket) == 0 {
        return
    }
    if lifetime == 0 || lifetime > 604800 {
        lifetime = 604800
    }
    c.cfg.Sessions.put(
        c.sessionKey,
        new session{
            version: 771,
            suite: c.suite.id,
            ticket: ticket,
            secret: c.master,
            received: std.time.Now(),
            lifetime: lifetime,
            alpn: c.alpn,
            peerCerts: c.peerCerts,
            verified: c.verified,
        },
    )
}
