// json.Schema<T>(): the JSON Schema (draft 2020-12, as used by OpenAPI
// 3.1) of T, generated by compile-time reflection like Format<T>: structs
// by their fields (@json names, skip), @std.web.validate as keywords
// (required, minimum/maximum, minLength/maxLength, pattern, format
// "email"), slices and arrays as "array", maps with string keys as
// "object" with additionalProperties, pointers as their element, plain
// enums as string enums, time.Time as "date-time". Recursive types stop
// at the first repetition ({"type":"object"}).
namespace std.encoding.json

func Schema<T>() string {
    var b = std.strings.Builder{}
    var seen []string = []
    schemaOf<T>(&b, seen)
    return b.String()
}

func schemaOf<T>(b *std.strings.Builder, seen []string) {
    if len(seen) > 32 {
        b.Write("{}")
        return
    }
    if std.reflect.TypeOf<T>() == std.reflect.TypeOf<Value>() || std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Any {
        b.Write("{}")
    } else if std.reflect.TypeOf<T>() == std.reflect.TypeOf<std.time.Time>() {
        b.Write("{\"type\":\"string\",\"format\":\"date-time\"}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Struct {
        var name = std.reflect.TypeOf<T>().FullName
        for x in seen {
            if x == name {
                b.Write("{\"type\":\"object\"}")
                return
            }
        }
        var inner []string = []
        for x in seen {
            inner = append(inner, x)
        }
        inner = append(inner, name)
        b.Write("{\"type\":\"object\",\"properties\":{")
        var zero T
        var first = true
        var required []string = []
        for f in std.reflect.Fields<T>() {
            var tag = f.Attribute<std.reflect.json>()
            if tag != nil && tag.skip {
                continue
            }
            var name = f.Name
            if tag != nil && tag.name != "" {
                name = tag.name
            }
            if !first {
                b.Write(",")
            }
            first = false
            b.Write(Quote(name))
            b.Write(":")
            var v = f.Attribute<std.web.validate>()
            if v == nil {
                schemaVal(b, f.Get(zero), inner)
            } else {
                if v.required {
                    required = append(required, name)
                }
                var sub = std.strings.Builder{}
                schemaVal(&sub, f.Get(zero), inner)
                b.Write(withRules(sub.String(), v))
            }
        }
        b.Write("}")
        if len(required) > 0 {
            b.Write(",\"required\":[")
            for i, r in required {
                if i > 0 {
                    b.Write(",")
                }
                b.Write(Quote(r))
            }
            b.Write("]")
        }
        b.Write("}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.String {
        b.Write("{\"type\":\"string\"}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Bool {
        b.Write("{\"type\":\"boolean\"}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Int || std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Uint {
        b.Write("{\"type\":\"integer\",\"format\":\"int64\"}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Int8 || std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Int16 || std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Int32 || std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Uint8 || std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Uint16 || std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Uint32 {
        b.Write("{\"type\":\"integer\",\"format\":\"int32\"}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Float {
        b.Write("{\"type\":\"number\",\"format\":\"double\"}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Float32 {
        b.Write("{\"type\":\"number\",\"format\":\"float\"}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Char {
        b.Write("{\"type\":\"string\",\"minLength\":1,\"maxLength\":1}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Enum {
        b.Write("{\"type\":\"string\",\"enum\":[")
        for i, v in std.reflect.TypeOf<T>().Variants {
            if i > 0 {
                b.Write(",")
            }
            b.Write(Quote(v.Name))
        }
        b.Write("]}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Slice {
        var zero T
        b.Write("{\"type\":\"array\",\"items\":")
        schemaSlice(b, zero, seen)
        b.Write("}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Array {
        var zero T
        b.Write("{\"type\":\"array\",\"items\":")
        var done = false
        for x in zero {
            if !done {
                schemaVal(b, x, seen)
                done = true
            }
        }
        if !done {
            b.Write("{}")
        }
        b.Write("}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Map {
        var zero T
        b.Write("{\"type\":\"object\",\"additionalProperties\":")
        schemaMap(b, zero, seen)
        b.Write("}")
    } else if std.reflect.TypeOf<T>().Kind == std.reflect.Kind.Pointer {
        var zero T
        schemaPtr(b, zero, seen)
    } else {
        b.Write("{}")
    }
}

func schemaVal<F>(b *std.strings.Builder, x F, seen []string) {
    schemaOf<F>(b, seen)
}

func schemaSlice<E>(b *std.strings.Builder, xs []E, seen []string) {
    schemaOf<E>(b, seen)
}

func schemaMap<K, V>(b *std.strings.Builder, m map[K]V, seen []string) {
    schemaOf<V>(b, seen)
}

func schemaPtr<E>(b *std.strings.Builder, p *E, seen []string) {
    schemaOf<E>(b, seen)
}

// Adds the keywords of a @validate to a schema object text.
func withRules(schema string, v *std.web.validate) string {
    var extra = ""
    var isString = std.strings.HasPrefix(schema, "{\"type\":\"string\"")
    var isArray = std.strings.HasPrefix(schema, "{\"type\":\"array\"")
    if len(v.range) == 2 {
        extra += ",\"minimum\":" + std.fmt.Format("{0}", v.range[0]) + ",\"maximum\":" + std.fmt.Format("{0}", v.range[1])
    }
    if v.min > -1.0e308 {
        extra += ",\"minimum\":" + std.fmt.Format("{0}", v.min)
    }
    if v.max < 1.0e308 {
        extra += ",\"maximum\":" + std.fmt.Format("{0}", v.max)
    }
    if v.minLength >= 0 {
        if isArray {
            extra += ",\"minItems\":" + std.fmt.Format("{0}", v.minLength)
        } else if isString {
            extra += ",\"minLength\":" + std.fmt.Format("{0}", v.minLength)
        }
    }
    if v.maxLength >= 0 {
        if isArray {
            extra += ",\"maxItems\":" + std.fmt.Format("{0}", v.maxLength)
        } else if isString {
            extra += ",\"maxLength\":" + std.fmt.Format("{0}", v.maxLength)
        }
    }
    if v.pattern != "" {
        extra += ",\"pattern\":" + Quote(v.pattern)
    }
    if v.email {
        extra += ",\"format\":\"email\""
    }
    if extra == "" || !std.strings.HasSuffix(schema, "}") {
        return schema
    }
    return schema[..len(schema) - 1] + extra + "}"
}
