namespace app

import std
import std.io

// Debugger fixture (compiler/tests/debug.rs): every value kind, with
// `// BREAK <name>` markers where the test stops.

struct Point {
    X float
    Y float

    func Length() float {
        var sq = this.X * this.X + this.Y * this.Y
        return math.Sqrt(sq) // BREAK method
    }
}

struct Node {
    name   string
    parent weak *Node
}

enum Color { Red, Green, Blue }

enum Result {
    Ok(value int)
    Fail(code int, reason string)
}

interface Shape {
    func Area() float
}

struct Circle {
    R float

    func Area() float {
        return 3.0 * this.R * this.R
    }
}

func Max<T: Ordered>(a, b T) T {
    if a > b {
        return a // BREAK generic
    }
    return b
}

func Parse(s string) int! {
    if s == "" {
        return error("empty string")
    }
    return len(s)
} // BREAK parse_ret

func Use(xs []any) {
}

func main() {
    var name = "zell"
    var empty = ""
    var nums = [5, 3, 8]
    var none []int
    var ages = map[string]int{"bob": 31, "alice": 30}
    var ids = map[int]string{2: "two", 1: "one"}
    var p = Point{X: 3, Y: 4}
    var pp = new Point{X: 1, Y: 2}
    var c = Color.Green
    var r = Result.Ok(1)
    var f = Result.Fail(2, "bad")
    var s Shape = Circle{R: 2}
    var nilShape Shape
    var x = try Parse("") else -1
    var y = try Parse("abc") else -1
    var t = (1, "one")
    var flag = true
    var ch = 'z'
    var ratio = 2.5
    var arr [3]int
    arr[1] = 2
    var k = 10
    var add = (v int) => v + k
    var parent = new Node{name: "root"}
    var child = new Node{name: "leaf", parent: parent}
    var b byte = 7
    var a any = 42
    println(name, empty, nums, none, len(ages), len(ids), p.Length(), pp.X, c, s.Area(), nilShape == nil) // BREAK values
    Use([r, f, x, y, t, flag, ch, ratio, arr, add(1), child.name, b, a])
    println(Max(9, 3), Max("b", "a"))
}
