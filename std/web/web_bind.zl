// Parameter binding (route, query, header, form, JSON body) with type
// conversion, and @validate. The compiler-generated endpoint handlers
// call bind*<T> for each parameter; failures are collected on the
// Context and answered with one 400 Problem Details listing all errors.
namespace web

// @validate on a body field or a parameter. Unset numbers keep their
// sentinels (min/max: +-1e308, lengths: -1).
@attribute(targets: [reflect.Target.Field, reflect.Target.Param])
struct validate {
    required bool = false
    min float = -1.0e308
    max float = 1.0e308
    minLength int = -1
    maxLength int = -1
    pattern string = ""
    email bool = false
    range []float = []
    message string = ""
}

// ---- query strings and forms ---------------------------------------------------------

// The decoded values of key in an application/x-www-form-urlencoded text
// (query strings and form bodies), in order.
func queryValues(q string, key string) []string {
    var out []string = []
    if q == "" {
        return out
    }
    for part in strings.Split(q, "&") {
        if part == "" {
            continue
        }
        var k = part
        var v = ""
        var eq = strings.Index(part, "=")
        if eq >= 0 {
            k = part[..eq]
            v = part[eq + 1..]
        }
        if net.http.unescape(k) == key {
            out = append(out, net.http.unescape(v))
        }
    }
    return out
}

func hasQueryKey(q string, key string) bool {
    return len(queryValues(q, key)) > 0
}

// ---- conversions ---------------------------------------------------------------------------

// A short description of T for messages ("an integer").
func typeLabel<T>() string {
    var t = reflect.TypeOf<T>()
    if t.Kind == reflect.Kind.Pointer {
        t = t.Elem
    }
    var k = t.Kind
    if k == reflect.Kind.Int || k == reflect.Kind.Int8 || k == reflect.Kind.Int16 || k == reflect.Kind.Int32 || k == reflect.Kind.Uint || k == reflect.Kind.Uint8 || k == reflect.Kind.Uint16 || k == reflect.Kind.Uint32 {
        return "an integer"
    }
    if k == reflect.Kind.Float || k == reflect.Kind.Float32 {
        return "a number"
    }
    if k == reflect.Kind.Bool {
        return "true or false"
    }
    if k == reflect.Kind.Enum {
        var names []string = []
        for v in t.Variants {
            names = append(names, v.Name)
        }
        return "one of " + strings.Join(names, ", ")
    }
    return "a " + t.Name
}

func intRange(s string, lo int, hi int) (int, bool) {
    var n = try strings.ToInt(strings.Trim(s)) catch err {
        return (0, false)
    }
    if n < lo || n > hi {
        return (0, false)
    }
    return (n, true)
}

// Converts text to a T (strings, integers with range checks, floats,
// bools, plain enums by variant name, pointers to those); false if it
// does not convert.
func convert<T>(s string, out *T) bool {
    if reflect.TypeOf<T>().Kind == reflect.Kind.String {
        *out = s
        return true
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Bool {
        var l = strings.ToLower(strings.Trim(s))
        if l == "true" || l == "1" || l == "on" || l == "yes" {
            *out = true
            return true
        }
        if l == "false" || l == "0" || l == "off" || l == "no" {
            *out = false
            return true
        }
        return false
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Int {
        var (n, ok) = intRange(s, math.MinInt, math.MaxInt)
        *out = n
        return ok
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Int8 {
        var (n, ok) = intRange(s, -128, 127)
        *out = int8(n)
        return ok
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Int16 {
        var (n, ok) = intRange(s, -32768, 32767)
        *out = int16(n)
        return ok
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Int32 {
        var (n, ok) = intRange(s, math.MinInt32, math.MaxInt32)
        *out = int32(n)
        return ok
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Uint {
        var (n, ok) = intRange(s, 0, math.MaxInt)
        *out = uint(n)
        return ok
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Uint8 {
        var (n, ok) = intRange(s, 0, 255)
        *out = byte(n)
        return ok
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Uint16 {
        var (n, ok) = intRange(s, 0, 65535)
        *out = uint16(n)
        return ok
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Uint32 {
        var (n, ok) = intRange(s, 0, math.MaxUint32)
        *out = uint32(n)
        return ok
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Float {
        var f = try strings.ToFloat(strings.Trim(s)) catch err {
            return false
        }
        *out = f
        return true
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Float32 {
        var f = try strings.ToFloat(strings.Trim(s)) catch err {
            return false
        }
        *out = float32(f)
        return true
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Enum {
        var t = reflect.TypeOf<T>()
        for v in t.Variants {
            if strings.EqualFold(v.Name, strings.Trim(s)) && len(v.Fields) == 0 {
                reflect.storeTag(out, v.Index)
                return true
            }
        }
        return false
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Pointer {
        return convertPtr(s, out)
    } else {
        return false
    }
}

func convertPtr<E>(s string, out **E) bool {
    var e E
    if !convert(s, &e) {
        return false
    }
    *out = &e
    return true
}

func convertSlice<E>(vals []string, out *[]E) bool {
    var res []E = []
    for v in vals {
        var e E
        if !convert(v, &e) {
            return false
        }
        res = append(res, e)
    }
    *out = res
    return true
}

func badValue<T>(c *Context, name string, value string) {
    c.AddError(name, "The value '" + value + "' is not valid for " + name + ": expected " + typeLabel<T>() + ".")
}

// ---- binders (called by generated handlers) ---------------------------------------------

// A route parameter ({name}).
func bindPath<T>(c *Context, name string) T {
    var out T
    var s = c.Request.Params[name]
    if !convert(s, &out) {
        badValue<T>(c, name, s)
    }
    return out
}

// Values of a query, header or form parameter: scalars take the last
// value, slices every value (comma-separated values are split too).
func bindValues<T>(c *Context, name string, vals []string, required bool) T {
    var out T
    if len(vals) == 0 {
        if required {
            c.AddError(name, "The " + name + " field is required.")
        }
        return out
    }
    if reflect.TypeOf<T>().Kind == reflect.Kind.Slice {
        var all []string = []
        for v in vals {
            for p in strings.Split(v, ",") {
                all = append(all, p)
            }
        }
        if !convertSlice(all, &out) {
            c.AddError(name, "The value '" + strings.Join(vals, ",") + "' is not valid for " + name + ".")
        }
    } else {
        var s = vals[len(vals) - 1]
        if !convert(s, &out) {
            badValue<T>(c, name, s)
        }
    }
    return out
}

func bindQuery<T>(c *Context, name string, required bool) T {
    return bindValues<T>(c, name, queryValues(c.Request.Query, name), required)
}

func bindHeader<T>(c *Context, name string, required bool) T {
    var h = c.Request.Header(name)
    var vals []string = []
    if h != "" {
        vals = append(vals, h)
    }
    return bindValues<T>(c, name, vals, required)
}

// A field of an application/x-www-form-urlencoded body.
func bindForm<T>(c *Context, name string, required bool) T {
    return bindValues<T>(c, name, queryValues(c.Request.Body, name), required)
}

// The JSON body as a T, validated (@validate of its fields; "required"
// means present and not null).
func bindBody<T>(c *Context) T {
    var out T
    var text = c.Request.Body
    if strings.Trim(text) == "" {
        c.AddError("", "A non-empty request body is required.")
        return out
    }
    var jv = try encoding.json.ParseValue(text) catch err {
        c.AddError("", err.Message())
        return out
    }
    out = try encoding.json.Decode<T>(jv) catch err {
        var msg = err.Message()
        var field = ""
        var colon = strings.Index(msg, ": ")
        if colon > 0 && !strings.HasPrefix(msg, "json:") {
            field = msg[..colon]
            msg = msg[colon + 2..]
        }
        c.AddError(field, msg)
        return out
    }
    validateInto<T>(&c.errs, "", out, jv, true)
    return out
}

// A service parameter.
func bindService<T>(c *Context) T! {
    return resolve<T>(c.Scope)?
}

// @validate of a route, query, header or form parameter.
func checkParam<T>(c *Context, name string, v T, a validate, present bool) {
    checkRule<T>(&c.errs, name, v, &a, present)
}

// ---- validation -----------------------------------------------------------------------------

// The errors of v by the @validate attributes of its fields (nested
// structs, slices and pointers included); empty if valid.
func Validate<T>(v T) []FieldError {
    var errs []FieldError = []
    validateInto<T>(&errs, "", v, encoding.json.Value{}, false)
    return errs
}

func joinPath(path string, name string) string {
    if path == "" {
        return name
    }
    return path + "." + name
}

// Validates v; jv is its JSON source when hasJson (for presence checks).
func validateInto<T>(errs *[]FieldError, path string, v T, jv encoding.json.Value, hasJson bool) {
    if reflect.TypeOf<T>().Kind == reflect.Kind.Struct {
        for f in reflect.Fields<T>() {
            var tag = f.Attribute<reflect.json>()
            if tag != nil && tag.skip {
                continue
            }
            var name = f.Name
            if tag != nil && tag.name != "" {
                name = tag.name
            }
            var p = joinPath(path, name)
            var a = f.Attribute<validate>()
            var present = true
            if hasJson {
                present = jv.Has(name) && !jv.Get(name).IsNull()
            }
            if a != nil {
                _ = checkRule(errs, p, f.Get(v), a, present)
            }
            if present {
                validateInto(errs, p, f.Get(v), jv.Get(name), hasJson)
            }
        }
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Slice {
        validateSlice(errs, path, v, jv, hasJson)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Pointer {
        if v != nil {
            validateInto(errs, path, *v, jv, hasJson)
        }
    }
}

func validateSlice<E>(errs *[]FieldError, path string, xs []E, jv encoding.json.Value, hasJson bool) {
    if reflect.TypeOf<E>().Kind == reflect.Kind.Struct || reflect.TypeOf<E>().Kind == reflect.Kind.Pointer || reflect.TypeOf<E>().Kind == reflect.Kind.Slice {
        for i, x in xs {
            validateInto(errs, path + "[" + fmt.Format("{0}", i) + "]", x, jv.Index(i), hasJson)
        }
    }
}

func fmtNum(f float) string {
    return fmt.Format("{0}", f)
}

func addRule(errs *[]FieldError, path string, a *validate, msg string) {
    var m = msg
    if a.message != "" {
        m = a.message
    }
    *errs = append(*errs, FieldError{Field: path, Message: m})
}

// Whether s looks like an e-mail address (local@domain.tld, no spaces).
func isEmail(s string) bool {
    var at = strings.Index(s, "@")
    if at <= 0 || at != strings.LastIndex(s, "@") || strings.Contains(s, " ") {
        return false
    }
    var domain = s[at + 1..]
    var dot = strings.LastIndex(domain, ".")
    return dot > 0 && dot < len(domain) - 1
}

// Checks one value against its @validate; false if it failed (nested
// values are then not checked).
func checkRule<F>(errs *[]FieldError, path string, x F, a *validate, present bool) bool {
    var label = path
    if label == "" {
        label = "value"
    }
    if a.required && (!present || blank(x)) {
        addRule(errs, path, a, "The " + label + " field is required.")
        return false
    }
    var before = len(*errs)
    if reflect.TypeOf<F>().Kind == reflect.Kind.Int || reflect.TypeOf<F>().Kind == reflect.Kind.Int8 || reflect.TypeOf<F>().Kind == reflect.Kind.Int16 || reflect.TypeOf<F>().Kind == reflect.Kind.Int32 || reflect.TypeOf<F>().Kind == reflect.Kind.Uint || reflect.TypeOf<F>().Kind == reflect.Kind.Uint8 || reflect.TypeOf<F>().Kind == reflect.Kind.Uint16 || reflect.TypeOf<F>().Kind == reflect.Kind.Uint32 || reflect.TypeOf<F>().Kind == reflect.Kind.Float || reflect.TypeOf<F>().Kind == reflect.Kind.Float32 {
        if present {
            var n = float(x)
            if len(a.range) == 2 {
                if n < a.range[0] || n > a.range[1] {
                    addRule(errs, path, a, "The field " + label + " must be between " + fmtNum(a.range[0]) + " and " + fmtNum(a.range[1]) + ".")
                }
            }
            if a.min > -1.0e308 && n < a.min {
                addRule(errs, path, a, "The field " + label + " must be at least " + fmtNum(a.min) + ".")
            }
            if a.max < 1.0e308 && n > a.max {
                addRule(errs, path, a, "The field " + label + " must be at most " + fmtNum(a.max) + ".")
            }
        }
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.String {
        if present && x != "" {
            var n = len(strings.Runes(x))
            if a.minLength >= 0 && n < a.minLength {
                addRule(errs, path, a, "The field " + label + " must be at least " + fmt.Format("{0}", a.minLength) + " characters long.")
            }
            if a.maxLength >= 0 && n > a.maxLength {
                addRule(errs, path, a, "The field " + label + " must be at most " + fmt.Format("{0}", a.maxLength) + " characters long.")
            }
            if a.email && !isEmail(x) {
                addRule(errs, path, a, "The " + label + " field is not a valid e-mail address.")
            }
            if a.pattern != "" {
                var re = try regex.Compile("^(?:" + a.pattern + ")$") catch err {
                    addRule(errs, path, a, "The pattern of " + label + " is invalid: " + err.Message())
                    return false
                }
                if !re.Match(x) {
                    addRule(errs, path, a, "The field " + label + " must match the pattern '" + a.pattern + "'.")
                }
            }
        }
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Slice || reflect.TypeOf<F>().Kind == reflect.Kind.Map {
        var n = len(x)
        if a.minLength >= 0 && n < a.minLength {
            addRule(errs, path, a, "The field " + label + " must have at least " + items(a.minLength) + ".")
        }
        if a.maxLength >= 0 && n > a.maxLength {
            addRule(errs, path, a, "The field " + label + " must have at most " + items(a.maxLength) + ".")
        }
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Pointer {
        if x != nil {
            var inner = *a
            inner.required = false
            return checkRule(errs, path, *x, &inner, present)
        }
    }
    return len(*errs) == before
}

func items(n int) string {
    if n == 1 {
        return "1 item"
    }
    return fmt.Format("{0} items", n)
}

// The empty value of a "required" check: "", nil, an empty slice or map.
func blank<F>(x F) bool {
    if reflect.TypeOf<F>().Kind == reflect.Kind.String {
        return strings.Trim(x) == ""
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Slice || reflect.TypeOf<F>().Kind == reflect.Kind.Map {
        return len(x) == 0
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Pointer {
        return x == nil
    } else {
        return false
    }
}
