// Examples for std.fs.
namespace fs_test

import std
import std.io

func ExampleJoin() {
    var p = fs.Join("logs", "app.log")
    println(p, fs.Base(p), fs.Ext(p), fs.Dir(p))
    // Output:
    // logs/app.log app.log .log logs
}

func ExampleReadDir() void! {
    var dir = fs.Join(fs.TempDir(), "zell-fs-example-" + strconv.Itoa(os.Pid()))
    fs.MkdirAll(dir)?
    io.WriteFile(fs.Join(dir, "b.txt"), "bee")?
    io.WriteFile(fs.Join(dir, "a.txt"), "ay")?
    println(fs.ReadDir(dir)?, fs.Size(fs.Join(dir, "b.txt"))?)
    try io.ReadFile(fs.Join(dir, "missing.txt")) catch err {
        println("missing:", errors.Is(err, fs.ErrNotFound))
    }
    fs.RemoveAll(dir)?
    // Output:
    // [a.txt b.txt] 3
    // missing: true
}
