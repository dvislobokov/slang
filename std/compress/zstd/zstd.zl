// Zstandard (RFC 8878); the decoder (runtime/src/std_zstd.c) and the
// encoder (std_zstd_enc.c) are C. Frames are decoded whole: the streaming
// Reader emits a frame's content once all of it has arrived. Dictionaries
// are not supported.
namespace compress.zstd

// Compresses data into one zstd frame with a content checksum. Levels
// 1 (fastest) .. 19 (more match search); 0 or negative means 3. The
// encoder is simpler than the reference one (predefined sequence tables,
// no repeat offsets): ratios are between reference levels 1 and 3.
func Compress(data []byte, level int) []byte! {
    var l = level
    if l <= 0 {
        l = 3
    }
    return compress.rtZstdEncode(data, l, true)?
}

// Compress without the content checksum.
func CompressNoChecksum(data []byte, level int) []byte! {
    var l = level
    if l <= 0 {
        l = 3
    }
    return compress.rtZstdEncode(data, l, false)?
}

// Decompresses all frames of data (skippable frames are skipped).
func Decompress(data []byte) []byte! {
    return compress.rtZstdDecode(data)?
}

// Reports whether data starts with a zstd frame magic number.
func IsFrame(data []byte) bool {
    return len(data) >= 4 &&
        int(data[0]) == 40 &&
        int(data[1]) == 181 &&
        int(data[2]) == 47 &&
        int(data[3]) == 253
}

// A streaming decompressor: Feed chunks; Read returns the content of the
// frames completed so far.
struct Reader {
    buf    []byte
    out    []byte
    frames int

    func Feed(chunk []byte) void! {
        this.buf = compress.rtConcat(this.buf, chunk)
        for len(this.buf) > 0 {
            var n = compress.rtZstdFrameLen(this.buf)
            if n < 0 {
                return error("zstd: invalid magic number")
            }
            if n == 0 {
                return
            }
            var b = compress.rtZstdDecode(compress.rtCopy(this.buf, 0, n))?
            this.out = compress.rtConcat(this.out, b)
            this.buf = compress.rtCopy(this.buf, n, len(this.buf))
            this.frames += 1
        }
    }

    // The decompressed bytes produced since the last call.
    func Read() []byte {
        var b = this.out
        this.out = []
        return b
    }

    // True when at least one frame was decoded and no other is in progress.
    func Done() bool {
        return this.frames > 0 && len(this.buf) == 0
    }

    func Close() void! {
        if !this.Done() {
            return error("zstd: unexpected end of data")
        }
    }
}

func NewReader() *Reader {
    return &Reader{}
}
