// Shared helpers of the reflection-based codecs encoding.{csv,xml,
// yaml,toml} (internal; lowercase).
namespace encoding

// v converted to the integer or float type F, or an error naming the
// range when it does not fit.
func intAs<F>(v int) F! {
    var lo = 0
    var hi = 0
    if reflect.TypeOf<F>().Kind == reflect.Kind.Int {
        return v
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Int8 {
        lo = -128
        hi = 127
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Int16 {
        lo = -32768
        hi = 32767
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Int32 {
        lo = math.MinInt32
        hi = math.MaxInt32
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Uint {
        lo = 0
        hi = math.MaxInt
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Uint8 {
        lo = 0
        hi = 255
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Uint16 {
        lo = 0
        hi = 65535
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Uint32 {
        lo = 0
        hi = math.MaxUint32
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Float {
        return float(v)
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Float32 {
        return float32(v)
    }
    if v < lo || v > hi {
        return error(
            fmt.Format("number {0} out of range for {1}", v, reflect.TypeOf<F>().Name),
        )
    }
    return narrow<F>(v)
}

func narrow<F>(v int) F {
    if reflect.TypeOf<F>().Kind == reflect.Kind.Int8 {
        return int8(v)
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Int16 {
        return int16(v)
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Int32 {
        return int32(v)
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Uint {
        return uint(v)
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Uint8 {
        return byte(v)
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Uint16 {
        return uint16(v)
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Uint32 {
        return uint32(v)
    } else {
        var zero F
        return zero
    }
}

// v converted to the float type F.
func floatAs<F>(v float) F {
    if reflect.TypeOf<F>().Kind == reflect.Kind.Float32 {
        return float32(v)
    } else {
        return v
    }
}

func isIntKind<F>() bool {
    var k = reflect.TypeOf<F>().Kind
    return k == reflect.Kind.Int ||
        k == reflect.Kind.Int8 ||
        k == reflect.Kind.Int16 ||
        k == reflect.Kind.Int32 ||
        k == reflect.Kind.Uint ||
        k == reflect.Kind.Uint8 ||
        k == reflect.Kind.Uint16 ||
        k == reflect.Kind.Uint32
}

// The zero value test of omitEmpty.
func isEmpty<F>(x F) bool {
    if reflect.TypeOf<F>().Kind == reflect.Kind.String {
        return x == ""
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Bool {
        return !x
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Int ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Int8 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Int16 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Int32 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Uint ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Uint8 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Uint16 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Uint32 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Float ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Float32 {
        return x == 0
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Slice ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Map {
        return len(x) == 0
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Pointer {
        return x == nil
    } else {
        return false
    }
}
