// Topic administration (see kafka.zl for the file layout): CreateTopics v2
// and DeleteTopics v1 sent to the controller, topic listing and
// description from Metadata v1.
namespace data.kafka

// A topic to create. ReplicationFactor 0 means 1; Configs are topic
// configs ("retention.ms", "cleanup.policy"...).
struct TopicSpec {
    Name string
    Partitions int
    ReplicationFactor int
    Configs map[string]string
}

// The admin client.
struct Admin {
    c *client

    // CreateTopic creates a topic with partitions and replicationFactor.
    func CreateTopic(name string, partitions int, replicationFactor int) Task<void!> {
        return createTopics(this.c, [TopicSpec{Name: name, Partitions: partitions, ReplicationFactor: replicationFactor}])
    }

    // Creates topics; the first failure (TOPIC_ALREADY_EXISTS...) is
    // returned as an Error.
    func CreateTopics(specs []TopicSpec) Task<void!> {
        return createTopics(this.c, specs)
    }

    // DeleteTopic deletes a topic.
    func DeleteTopic(name string) Task<void!> {
        return deleteTopics(this.c, [name])
    }

    // DeleteTopics deletes topics.
    func DeleteTopics(names []string) Task<void!> {
        return deleteTopics(this.c, names)
    }

    // Every topic (internal ones too) with its partitions, sorted by name.
    func ListTopics() Task<[]TopicInfo!> {
        return listTopics(this.c)
    }

    // DescribeTopic returns the partitions and their leaders and replicas.
    func DescribeTopic(name string) Task<TopicInfo!> {
        return describeTopic(this.c, name)
    }

    // The brokers of the last metadata response, sorted by id.
    func Brokers() []Broker {
        this.c.lock()
        var out []Broker = []
        for _, b in this.c.brokers {
            out = append(out, b)
        }
        this.c.unlock()
        slices.SortFunc(out, func(a Broker, b Broker) bool {
            return a.ID < b.ID
        })
        return out
    }

    // Close closes the connections to the brokers.
    func Close() {
        this.c.closeAll()
    }
}

// NewAdmin connects an admin client to the cluster through brokers.
async func NewAdmin(brokers []string) *Admin! {
    return await NewAdminWith(brokers, Config{})?
}

// NewAdminWith is NewAdmin with a client configuration.
async func NewAdminWith(brokers []string, cfg Config) *Admin! {
    var c = newClient(cfg, brokers)?
    try await refreshMetadata(c, []) catch err {
        c.closeAll()
        return err
    }
    return new Admin{c: c}
}

async func controllerConn(c *client) *brokerConn! {
    c.lock()
    var ctrl = c.controller
    c.unlock()
    if ctrl < 0 {
        await refreshMetadata(c, [])?
        c.lock()
        ctrl = c.controller
        c.unlock()
    }
    if ctrl < 0 {
        return await anyConn(c)?
    }
    return await connToBroker(c, ctrl, "")?
}

async func createTopics(c *client, specs []TopicSpec) void! {
    var attempt = 0
    for {
        var bc = await controllerConn(c)?
        var e = Encoder{}
        e.ArrayLen(len(specs))
        for s in specs {
            e.String(s.Name)
            var n = s.Partitions
            if n <= 0 {
                n = 1
            }
            var rf = s.ReplicationFactor
            if rf <= 0 {
                rf = 1
            }
            e.Int32(n)
            e.Int16(rf)
            e.ArrayLen(0)
            var keys = maps.SortedKeys(s.Configs)
            e.ArrayLen(len(keys))
            for k in keys {
                e.String(k)
                e.NullableString(s.Configs[k], false)
            }
        }
        e.Int32(c.cfg.RequestTimeout)
        e.Bool(false)
        var resp = try await request(c, bc, 19, 2, e.B, false) catch err {
            if attempt < c.cfg.MaxRetries && isNetErr(err) {
                attempt += 1
                await backoff(c.cfg, attempt)
                continue
            }
            return err
        }
        var d = Decoder{B: resp}
        _ = d.Int32()
        var n = d.ArrayLen()
        var retry = false
        for _ in 0..n {
            var name = d.String()
            var code = d.Int16()
            var msg = d.String()
            if code == 41 && attempt < c.cfg.MaxRetries {
                retry = true
            } else if code != 0 {
                return Error{Code: code, Text: "topic " + strconv.Quote(name) + ": " + msg}
            }
        }
        if retry {
            attempt += 1
            c.lock()
            c.controller = -1
            c.unlock()
            await backoff(c.cfg, attempt)
            continue
        }
        // wait until the new topics have leaders
        for s in specs {
            _ = await topicPartitions(c, s.Name)?
        }
        return
    }
}

async func deleteTopics(c *client, names []string) void! {
    var bc = await controllerConn(c)?
    var e = Encoder{}
    e.ArrayLen(len(names))
    for n in names {
        e.String(n)
    }
    e.Int32(c.cfg.RequestTimeout)
    var resp = await request(c, bc, 20, 1, e.B, false)?
    var d = Decoder{B: resp}
    _ = d.Int32()
    var n = d.ArrayLen()
    for _ in 0..n {
        var name = d.String()
        var code = d.Int16()
        if code != 0 {
            return Error{Code: code, Text: "topic " + strconv.Quote(name)}
        }
    }
    c.lock()
    for name in names {
        delete(c.topics, name)
    }
    c.unlock()
}

async func listTopics(c *client) []TopicInfo! {
    var bc = await anyConn(c)?
    var resp = await request(c, bc, 3, 1, encodeMetadata([]), false)?
    var (bs, ctrl, ts, bad) = decodeMetadata(resp)
    if bad {
        return error("kafka: malformed Metadata response")
    }
    c.lock()
    for b in bs {
        c.brokers[b.ID] = b
    }
    c.controller = ctrl
    c.unlock()
    var out []TopicInfo = []
    for t in ts {
        if t.Err == 0 {
            out = append(out, t)
        }
    }
    slices.SortFunc(out, func(a TopicInfo, b TopicInfo) bool {
        return a.Name < b.Name
    })
    return out
}

async func describeTopic(c *client, name string) TopicInfo! {
    await refreshMetadata(c, [name])?
    var t = c.topic(name)
    if t.Err != 0 {
        return Error{Code: t.Err, Text: "topic " + strconv.Quote(name)}
    }
    return t
}
