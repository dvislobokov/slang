// cloud.blob: one interface for object storage (docs/STDLIB.md level
// 3b), implemented over cloud.s3 (OpenS3) and over a local directory
// (OpenDir), so code and tests can switch between a bucket and the file
// system. Keys are "/"-separated; a missing key fails with
// blob.ErrNotFound (errors.Is) in both implementations.
namespace cloud.blob

// Metadata of a blob.
struct Attributes {
    Key string
    Size int
    ModTime time.Time
    ETag string
    ContentType string
}

// A bucket of blobs.
interface Bucket {
    // Write stores data under key with a content type.
    func Write(key string, data []byte, contentType string) Task<void!>
    // Read returns the contents of key (ErrNotFound if it is missing).
    func Read(key string) Task<[]byte!>
    // Delete removes key.
    func Delete(key string) Task<void!>
    // Exists reports whether key exists.
    func Exists(key string) Task<bool!>
    // Attributes returns the size, content type and modification time of key.
    func Attributes(key string) Task<cloud.blob.Attributes!>
    // Every blob whose key starts with prefix, sorted by key.
    func List(prefix string) Task<[]cloud.blob.Attributes!>
    // Copy copies src to dst within the bucket.
    func Copy(dst string, src string) Task<void!>
    // A URL that grants method on key for expires seconds (S3 only).
    func SignedURL(key string, method string, expires int) string!
}

func notFound(key string) error {
    return errors.Wrap(ErrNotFound, "blob: " + key)
}

// ---- S3 -----------------------------------------------------------------------

// A Bucket over an S3 bucket; keys live under prefix ("" or "dir/").
struct S3Bucket {
    c *cloud.s3.Client
    bucket string
    prefix string

    // Write stores data under key with a content type (PutObject).
    func Write(key string, data []byte, contentType string) Task<void!> {
        return s3Write(this, key, data, contentType)
    }

    // Read returns the contents of key (ErrNotFound if it is missing).
    func Read(key string) Task<[]byte!> {
        return s3Read(this, key)
    }

    // Delete removes key.
    func Delete(key string) Task<void!> {
        return this.c.DeleteObject(this.bucket, this.prefix + key)
    }

    // Exists reports whether key exists (HeadObject).
    func Exists(key string) Task<bool!> {
        return s3Exists(this, key)
    }

    // Attributes returns the attributes of key.
    func Attributes(key string) Task<Attributes!> {
        return s3Attrs(this, key)
    }

    // List returns every blob whose key starts with prefix, sorted by key.
    func List(prefix string) Task<[]Attributes!> {
        return s3List(this, prefix)
    }

    // Copy copies src to dst within the bucket (CopyObject).
    func Copy(dst string, src string) Task<void!> {
        return s3Copy(this, dst, src)
    }

    // SignedURL returns a presigned URL granting method on key for expires seconds.
    func SignedURL(key string, method string, expires int) string! {
        return this.c.Presign(method, this.bucket, this.prefix + key, expires)?
    }
}

// OpenS3 returns a bucket over an S3 client; keys are relative to prefix.
func OpenS3(c *cloud.s3.Client, bucket string, prefix string) *S3Bucket {
    return new S3Bucket{c: c, bucket: bucket, prefix: prefix}
}

func mapS3(err error, key string) error {
    if errors.Is(err, cloud.s3.ErrNoSuchKey) || cloud.s3.ErrorCode(err) == "NotFound" {
        return notFound(key)
    }
    return err
}

async func s3Write(b *S3Bucket, key string, data []byte, contentType string) void! {
    _ = await b.c.PutObject(b.bucket, b.prefix + key, data, cloud.s3.PutOptions{ContentType: contentType})?
}

async func s3Read(b *S3Bucket, key string) []byte! {
    var d = try await b.c.GetObjectBytes(b.bucket, b.prefix + key) catch err {
        return mapS3(err, key)
    }
    return d
}

async func s3Exists(b *S3Bucket, key string) bool! {
    try await b.c.HeadObject(b.bucket, b.prefix + key) catch err {
        if errors.Is(mapS3(err, key), ErrNotFound) {
            return false
        }
        return err
    }
    return true
}

func attrsOf(o cloud.s3.ObjectInfo, key string) Attributes {
    return Attributes{Key: key, Size: o.Size, ModTime: o.LastModified, ETag: o.ETag, ContentType: o.ContentType}
}

async func s3Attrs(b *S3Bucket, key string) Attributes! {
    var o = try await b.c.HeadObject(b.bucket, b.prefix + key) catch err {
        return mapS3(err, key)
    }
    return attrsOf(o, key)
}

async func s3List(b *S3Bucket, prefix string) []Attributes! {
    var out []Attributes = []
    var it = b.c.List(b.bucket, b.prefix + prefix, "")
    for o in it {
        out = append(out, attrsOf(o, o.Key[len(b.prefix)..]))
    }
    if it.Err() != nil {
        return it.Err()
    }
    return out
}

async func s3Copy(b *S3Bucket, dst string, src string) void! {
    try await b.c.CopyObject(b.bucket, b.prefix + src, b.bucket, b.prefix + dst, cloud.s3.PutOptions{}) catch err {
        return mapS3(err, src)
    }
}

// ---- local directory -----------------------------------------------------------------

// A Bucket over a directory: key "a/b.txt" is the file dir/a/b.txt.
// Keys with "..", "." or empty segments, or a leading "/", are refused.
struct DirBucket {
    dir string

    func path(key string) string! {
        if key == "" || strings.HasPrefix(key, "/") || strings.Contains(key, "\\") {
            return error("blob: invalid key " + strconv.Quote(key))
        }
        for seg in strings.Split(key, "/") {
            if seg == "" || seg == "." || seg == ".." {
                return error("blob: invalid key " + strconv.Quote(key))
            }
        }
        return this.dir + "/" + key
    }

    // Write stores data in the file for key (creating directories).
    func Write(key string, data []byte, contentType string) Task<void!> {
        return dirWrite(this, key, data)
    }

    // Read returns the contents of the file for key (ErrNotFound if it is missing).
    func Read(key string) Task<[]byte!> {
        return dirRead(this, key)
    }

    // Delete removes the file for key.
    func Delete(key string) Task<void!> {
        return dirDelete(this, key)
    }

    // Exists reports whether the file for key exists.
    func Exists(key string) Task<bool!> {
        return dirExists(this, key)
    }

    // Attributes returns the attributes of the file for key.
    func Attributes(key string) Task<Attributes!> {
        return dirAttrs(this, key)
    }

    // List returns every blob whose key starts with prefix, sorted by key.
    func List(prefix string) Task<[]Attributes!> {
        return dirList(this, prefix)
    }

    // Copy copies the file for src to dst.
    func Copy(dst string, src string) Task<void!> {
        return dirCopy(this, dst, src)
    }

    // SignedURL is not supported by a directory bucket and always fails.
    func SignedURL(key string, method string, expires int) string! {
        return error("blob: signed URLs are not supported by a directory bucket")
    }
}

// A Bucket over dir (created if missing).
func OpenDir(dir string) *DirBucket! {
    fs.MkdirAll(dir)?("blob: " + dir)
    var abs = fs.Abs(dir)?
    return new DirBucket{dir: abs}
}

async func dirWrite(b *DirBucket, key string, data []byte) void! {
    var p = b.path(key)?
    fs.MkdirAll(fs.Dir(p))?
    // write a temporary file, then rename: readers never see a partial blob
    var tmp = p + ".tmp-" + strconv.Itoa(random.IntN(1000000000))
    io.WriteFile(tmp, strings.FromBytes(data))?
    try fs.Rename(tmp, p) catch err {
        try fs.Remove(tmp) catch _ {
        }
        return err
    }
}

async func dirRead(b *DirBucket, key string) []byte! {
    var p = b.path(key)?
    if !fs.Exists(p) || fs.IsDir(p) {
        return notFound(key)
    }
    return strings.Bytes(io.ReadFile(p)?)
}

async func dirDelete(b *DirBucket, key string) void! {
    var p = b.path(key)?
    if !fs.Exists(p) || fs.IsDir(p) {
        return
    }
    fs.Remove(p)?
    // drop directories the key left empty
    var d = fs.Dir(p)
    for d != b.dir && strings.HasPrefix(d, b.dir) {
        var names = try fs.ReadDir(d) else ["x"]
        if len(names) > 0 {
            break
        }
        try fs.Remove(d) catch _ {
            break
        }
        d = fs.Dir(d)
    }
}

async func dirExists(b *DirBucket, key string) bool! {
    var p = b.path(key)?
    return fs.Exists(p) && !fs.IsDir(p)
}

func fileAttrs(path string, key string) Attributes! {
    var size = fs.Size(path)?
    var mt = fs.ModTime(path)?
    var ct = mime.TypeByExtension(fs.Ext(path))
    return Attributes{Key: key, Size: size, ModTime: time.UnixMilli(mt), ContentType: ct}
}

async func dirAttrs(b *DirBucket, key string) Attributes! {
    var p = b.path(key)?
    if !fs.Exists(p) || fs.IsDir(p) {
        return notFound(key)
    }
    return fileAttrs(p, key)?
}

func walk(dir string, rel string, out []Attributes) []Attributes! {
    var acc = out
    for name in fs.ReadDir(dir)? {
        if strings.Contains(name, ".tmp-") {
            continue
        }
        var full = dir + "/" + name
        var key = name
        if rel != "" {
            key = rel + "/" + name
        }
        if fs.IsDir(full) {
            acc = walk(full, key, acc)?
        } else {
            acc = append(acc, fileAttrs(full, key)?)
        }
    }
    return acc
}

async func dirList(b *DirBucket, prefix string) []Attributes! {
    var all = walk(b.dir, "", [])?
    var out []Attributes = []
    for a in all {
        if strings.HasPrefix(a.Key, prefix) {
            out = append(out, a)
        }
    }
    slices.SortFunc(out, func(x Attributes, y Attributes) bool {
        return x.Key < y.Key
    })
    return out
}

async func dirCopy(b *DirBucket, dst string, src string) void! {
    var data = await dirRead(b, src)?
    await dirWrite(b, dst, data)?
}

// ---- URLs ------------------------------------------------------------------------------

// Opens a bucket by URL: "file:///path/to/dir", or
// "s3://bucket/prefix/?endpoint=http://localhost:9000&region=us-east-1&path_style=true"
// (credentials from the environment or ~/.aws/credentials).
func Open(raw string) Bucket! {
    if strings.HasPrefix(raw, "file://") {
        return OpenDir(raw[7..])?
    }
    if !strings.HasPrefix(raw, "s3://") {
        return error("blob: unsupported URL " + strconv.Quote(raw) + " (want file:// or s3://)")
    }
    var u = net.url.Parse(raw)?("blob: invalid URL")
    var q = net.url.ParseQuery(u.RawQuery)?("blob: invalid URL query")
    var cfg = cloud.s3.Config{Endpoint: q.Get("endpoint"), Region: q.Get("region"), PathStyle: q.Get("path_style") == "true"}
    var c = cloud.s3.NewClient(cfg)?
    var prefix = u.Path
    if strings.HasPrefix(prefix, "/") {
        prefix = prefix[1..]
    }
    return OpenS3(c, u.Host, prefix)
}
