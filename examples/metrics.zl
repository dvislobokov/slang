namespace examples.metrics

import std
import std.io
import std.net

// std.diag metrics: counters, gauges and histograms with labels, exposed
// in the Prometheus text format, also over HTTP (diag.ServeMetrics).

async func Work(req *http.Request, res *http.Response) void! {
    var requests = diag.NewCounter("app_requests_total", "Requests handled.", ["path", "code"])
    requests.With([req.Path, "200"]).Inc()
    res.Text(200, "done\n")
}

async func main() void! {
    var jobs = diag.NewCounter("app_jobs_total", "Jobs processed.", ["queue"])
    jobs.With(["email"]).Inc()
    jobs.With(["email"]).Add(2.0)
    jobs.With(["sms"]).Inc()
    var depth = diag.NewGauge("app_queue_depth", "Jobs waiting.", nil)
    depth.Set(10.0)
    depth.Dec()
    depth.Sub(2.5)
    var latency = diag.NewHistogram("app_job_seconds", "Job duration.", ["queue"], [0.01, 0.1, 1.0])
    for x in [0.004, 0.05, 0.05, 0.2, 3.0] {
        latency.With(["email"]).Observe(x)
    }
    println("email jobs:", jobs.With(["email"]).Value(), "depth:", depth.Value())

    var r = http.NewRouter()
    r.Get("/work", Work)
    r.Get("/metrics", diag.ServeMetrics)
    var srv = http.Server{Addr: "127.0.0.1:0", Handler: r}
    srv.Listen()?
    var serving = srv.Serve()
    var base = fmt.Format("http://127.0.0.1:{0}", srv.Port())
    _ = await http.Get(base + "/work")?
    _ = await http.Get(base + "/work")?
    var m = await http.Get(base + "/metrics")?
    println(m.Status, m.Header("Content-Type"))
    print(m.Body)
    await srv.Shutdown()
    await serving?

    // Runtime figures (also in PrometheusText after EnableRuntimeMetrics).
    var rt = diag.Runtime()
    println(
        "live objects:",
        rt.LiveObjects > 0,
        "allocations:",
        rt.Allocations >= rt.LiveObjects,
        "workers:",
        rt.Workers > 0,
    )
    diag.EnableRuntimeMetrics()
    println(
        "runtime metrics:",
        strings.Contains(diag.PrometheusText(), "# TYPE zell_scheduler_queue_length gauge"),
    )
}
