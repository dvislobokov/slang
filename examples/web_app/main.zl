// web_app: a users API on web (docs/FRAMEWORK.md section 2) over
// SQLite: controllers with attribute routes compiled into the route table,
// DI (singletons built by static New, a scoped audit trail dropped with
// each request), @validate with Problem Details, JWT auth with roles,
// request logging, health checks and the OpenAPI 3.1 document. The
// requests go through the in-memory test client, so the output is
// deterministic.
namespace webapp

import database
import encoding
import io
import net
import web

import webapp.controllers
import webapp.models
import webapp.services

@embed("appsettings.json")
var defaults string

var requests = 0

func nextId() string {
    requests += 1
    return fmt.Format("req-{0}", requests)
}

func show(label string, r *http.Response) {
    println(label, "->", r.Status, r.Body)
}

async func main() void! {
    // configuration: embedded defaults < environment < arguments
    os.Setenv("APP__PageSize", "50")?
    var cfg = config.Load(config.LoadOptions{
        Defaults: defaults,
        NoFiles: true,
        Args: ["--Jwt:LifetimeSeconds=600"],
    })?
    var settings = cfg.Bind<Settings>("")?
    println("config:", settings.Jwt.Issuer, settings.Jwt.LifetimeSeconds, settings.PageSize)

    var db = sqlite.Open(":memory:")
    db.SetMaxOpenConns(1)
    defer db.Close()

    // request log lines on stdout (no timings, to stay reproducible)
    var logger = log.New().WriteTo.Console(log.ConsoleOptions{
        Template: "  log: {RequestMethod:l} {RequestPath:l} -> {StatusCode} [{RequestId:l}]{NewLine}",
        Stdout: true,
    }).Enrich.FromContext().CreateLogger()

    var app = web.NewAppWith(web.AppOptions{
        Title: "Users API",
        Version: "1.0.0",
        Logger: logger,
        Environment: "production",
    })
    app.Services.AddInstance(&settings)
    app.Services.AddInstance(new Database{Db: db})
    app.Services.AddSingleton<UserStore>()
    app.Services.AddSingleton<TokenService>()
    app.Services.AddScoped<Audit>()

    app.UseRequestId(web.RequestIdOptions{Generate: nextId})
    app.UseLogging()
    app.UseAuth(web.AuthOptions{
        Key: web.auth.jwt.HS256(settings.Jwt.Secret),
        Issuer: settings.Jwt.Issuer,
        Clock: () => 1700000100,
    })
    app.MapControllers<UsersController, AuthController>()
    app.AddHealthCheck("sqlite", async func() void! {
        await db.Ping()?
    })
    app.MapHealthChecks("/health")
    app.MapOpenApi("/openapi.json")
    app.MapSwagger("/swagger", "/openapi.json")

    var client = web.TestServer(app)?
    var store = app.Services.CreateScope().Get<*UserStore>()?
    await store.Migrate()?
    _ = await store.Create(CreateUser{
        Name: "Root",
        Email: "root@example.com",
        Role: "admin",
        Password: "rootpassword",
    })?
    _ = await store.Create(CreateUser{
        Name: "Bob",
        Email: "bob@example.com",
        Role: "user",
        Password: "bobpassword",
    })?

    show("health", await client.Get("/health"))
    var login = await client.Post(
        "/api/auth/login",
        "{\"Email\": \"root@example.com\", \"Password\": \"rootpassword\"}",
    )
    println("login ->", login.Status)
    var token = login.JSON<TokenResponse>()?
    var admin = client.WithBearer(token.AccessToken)
    show(
        "bad login",
        await client.Post(
            "/api/auth/login",
            "{\"Email\": \"root@example.com\", \"Password\": \"nope\"}",
        ),
    )

    show(
        "create anonymous",
        await client.Post(
            "/api/users",
            "{\"Name\": \"Carol\", \"Email\": \"carol@example.com\", \"Password\": \"carolpassword\"}",
        ),
    )
    show(
        "create invalid",
        await admin.Post(
            "/api/users",
            "{\"Name\": \"C\", \"Email\": \"carol-at-example\", \"Role\": \"root\"}",
        ),
    )
    var created = await admin.Post(
        "/api/users",
        "{\"Name\": \"Carol\", \"Email\": \"carol@example.com\", \"Password\": \"carolpassword\"}",
    )
    println("create ->", created.Status, created.Header("Location"), created.Body)
    show(
        "create duplicate",
        await admin.Post(
            "/api/users",
            "{\"Name\": \"Carol\", \"Email\": \"carol@example.com\", \"Password\": \"carolpassword\"}",
        ),
    )

    show("list", await client.Get("/api/users"))
    show("list admins", await client.Get("/api/users?role=admin"))
    show("get", await client.Get("/api/users/3"))
    show("get missing", await client.Get("/api/users/99"))
    show("get bad id", await client.Get("/api/users/abc"))
    var users = await client.GetJSON<[]User>("/api/users")?
    println("typed:", len(users), users[2].Name, users[2].Role)

    var bobLogin = await client.Post(
        "/api/auth/login",
        "{\"Email\": \"bob@example.com\", \"Password\": \"bobpassword\"}",
    )
    var bob = client.WithBearer(bobLogin.JSON<TokenResponse>()?.AccessToken)
    show("delete as user", await bob.Delete("/api/users/3"))
    show("delete as admin", await admin.Delete("/api/users/3"))
    show("delete again", await admin.Delete("/api/users/3"))
    var stale = web.auth.jwt.Sign(
        web.auth.jwt.Claims{Subject: "1", Issuer: "webapp", ExpiresAt: 1600000000},
        web.auth.jwt.HS256(settings.Jwt.Secret),
    )?
    show("expired token", await client.WithBearer(stale).Get("/api/users"))
    show("forged token", await client.WithBearer(stale + "x").Get("/api/users"))

    // the OpenAPI document, generated from the compiled route table
    var doc = json.ParseValue((await client.Get("/openapi.json")).Body)?
    println("openapi", doc.Get("openapi").String()?, doc.Get("info").Get("title").String()?)
    for p in doc.Get("paths").Keys() {
        var ops = doc.Get("paths").Get(p)
        for m in ops.Keys() {
            var op = ops.Get(m)
            var line = "  " + strings.ToUpper(m) + " " + p + " " + op.Get("operationId").String()?
            if op.Has("security") {
                line += " (bearer)"
            }
            println(line)
        }
    }
    var body = doc.Get("paths").Get("/api/users").Get("post").Get("requestBody").Get("content").Get(
        "application/json",
    ).Get("schema")
    println("CreateUser schema:", body.Format())
    var swagger = await client.Get("/swagger")
    println(
        "swagger ->",
        swagger.Status,
        swagger.Header("Content-Type"),
        strings.Contains(swagger.Body, "swagger-ui-bundle.js"),
    )
}
