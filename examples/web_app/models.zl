// Models of the users API: entities and request bodies with @validate.
namespace webapp.models

import web

struct User {
    Id    int
    Name  string
    Email string
    Role  string
}

// The body of POST /api/users (validated before the action runs).
struct CreateUser {
    @validate(required: true, minLength: 2, maxLength: 40)                   Name     string
    @validate(required: true, email: true)                                   Email    string
    @validate(pattern: "admin|user", message: "Role must be admin or user.") Role     string
    @validate(required: true, minLength: 8)                                  Password string
}

struct LoginRequest {
    @validate(required: true, email: true) Email    string
    @validate(required: true)              Password string
}

struct TokenResponse {
    @json(name: "access_token") AccessToken string
    @json(name: "token_type")   TokenType   string
}

// appsettings: bound by config.Bind (here from command-line style args).
struct JwtSettings {
    @validate(required: true, minLength: 16) Secret string
    Issuer string
    @validate(range: [60, 86400]) LifetimeSeconds int
}

struct Settings {
    Jwt JwtSettings
    @validate(range: [1, 1000]) PageSize int
}
