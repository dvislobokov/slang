// Controllers: routes come from the attributes and are compiled into the
// route table at build time (app.MapController<T>()); fields are injected
// from the DI container.
namespace webapp.controllers

import web

import webapp.models
import webapp.services

@route("/api/users")
struct UsersController {
    store *UserStore
    audit *Audit

    @get("")
    @summary("List users, optionally by role")
    async func List(role string) []User! {
        return await this.store.All(role)?
    }

    @get("{id}")
    @summary("Get one user")
    async func Get(id int) Result<User>! {
        var u = await this.store.Find(id)?
        if u == nil {
            return NotFound()
        }
        return Ok(*u)
    }

    @post("")
    @authorize(roles: ["admin"])
    @summary("Create a user (admins only)")
    async func Create(@body req CreateUser, c *Context) Result<User>! {
        var u = await this.store.Create(req)?
        this.audit.Add(c.User.Name + " created user " + fmt.Format("{0}", u.Id))
        return CreatedAt("/api/users/" + fmt.Format("{0}", u.Id), u)
    }

    @delete("{id}")
    @authorize(roles: ["admin"])
    async func Delete(id int, c *Context) Result<string>! {
        if !await this.store.Delete(id)? {
            return NotFound()
        }
        this.audit.Add(c.User.Name + " deleted user " + fmt.Format("{0}", id))
        return NoContent()
    }
}

@route("/api/auth")
struct AuthController {
    store  *UserStore
    tokens *TokenService

    @post("login")
    async func Login(@body req LoginRequest) Result<TokenResponse>! {
        var u = await this.store.CheckPassword(req.Email, req.Password)?
        if u == nil {
            return Problem(401, "Invalid credentials", "unknown e-mail or wrong password")
        }
        var t = this.tokens.Issue(*u, 1700000000)?
        return Ok(TokenResponse{AccessToken: t, TokenType: "Bearer"})
    }
}
