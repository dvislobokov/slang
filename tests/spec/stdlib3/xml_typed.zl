// test: encoding.xml.Parse<T>/Format<T>/FormatIndent<T> through compile-time reflection: root name from @xml(name:) on the type, @xml(attr:), @xml(text:), @xml(name:), @xml(omitEmpty:), @xml(skip:), @xml(ns:), @serde(name:), repeated elements into slices, nested and pointer structs, enums, bools, floats, list attributes; errors with paths; the Value tree (ParseValue, Child, Elements, Attr, InnerText, Format, NewElement) and the Writer (indent, comments, CDATA, escaping)
// status: passing
namespace spec.stdlib3.xml_typed

import io

enum Status {
    Draft
    Published
}

struct Author {
    @xml(attr: true) id   int
    @xml(text: true) Name string
}

@xml(name: "book", ns: "urn:books")
struct Book {
    @xml(attr: true)               isbn string
    @xml(attr: true, name: "tags") Tags []string
    Title   string
    Authors []Author
    @xml(name: "price") Price float
    InPrint bool
    Status  Status
    @serde(name: "editor") Editor *Author
    @xml(omitEmpty: true)  Note   string
    @xml(skip: true)       cache  int
    Chapters []string
}

func main() void! {
    var b = Book{
        isbn: "978-0",
        Tags: ["sci", "fi"],
        Title: "Dune & Co",
        Authors: [Author{id: 1, Name: "Frank"}, Author{id: 2, Name: "Brian"}],
        Price: 9.5,
        InPrint: true,
        Status: Status.Published,
        Chapters: ["One", "Two <2>"],
        cache: 42,
    }
    var text = encoding.xml.Format(b)
    println(text)
    var back = encoding.xml.Parse<Book>(text)?
    println(
        back.isbn,
        back.Tags,
        back.Title,
        len(back.Authors),
        back.Authors[1].id,
        back.Authors[1].Name,
        back.Price,
        back.InPrint,
        back.Status,
        back.Editor == nil,
        back.Chapters,
        back.cache,
    )
    back.Editor = &Author{id: 9, Name: "Ed"}
    back.Note = "signed"
    print(encoding.xml.FormatIndent(back, "  "))

    var doc = "<book isbn=\"x\"><Title>T</Title><price>not-a-number</price></book>"
    try encoding.xml.Parse<Book>(doc) catch err {
        println(err.Message())
    }
    try encoding.xml.Parse<Book>("<magazine/>") catch err {
        println(err.Message())
    }
    try encoding.xml.Parse<Book>("<book><Authors id=\"x\">A</Authors></book>") catch err {
        println(err.Message())
    }
    try encoding.xml.Parse<Book>("<book><Status>Lost</Status></book>") catch err {
        println(err.Message())
    }

    var v = encoding.xml.ParseValue(
        "<cfg version=\"2\">\n  <server host=\"a\" port=\"80\"/>\n  <server host=\"b\"/>\n  <name>Main <b>bold</b> text</name>\n</cfg>",
    )?
    println(
        v.Name.Local,
        v.Attr("version"),
        v.HasAttr("nope"),
        len(v.Elements("server")),
        len(v.Elements("")),
    )
    for s in v.Elements("server") {
        println(" ", s.Attr("host"), s.Attr("port") == "")
    }
    println(v.Child("name").InnerText(), v.Child("missing") == nil)
    println(v.Format())
    var built = encoding.xml.NewElement("list", [encoding.xml.A("n", "2")], [
        encoding.xml.NewElement("i", [], [encoding.xml.NewText("a&b")]),
        encoding.xml.NewElement("i", [], []),
    ])
    print(built.FormatIndent("\t") + "\n")
    var a = encoding.xml.Decode<Author>(encoding.xml.ParseValue("<x id=\"5\">Zed</x>")?)?
    println(a.id, a.Name)

    var w = encoding.xml.NewWriter()
    w.Indent = "  "
    w.Header()
    w.Start("doc", [encoding.xml.A("q", "\"quoted\"")])
    w.Comment("generated -- by zell")
    w.Element("t", "1 < 2")
    w.Start("raw", [])
    w.CData("x ]]> y")
    w.End()
    w.End()
    w.Close()?
    println(w.String())
}
