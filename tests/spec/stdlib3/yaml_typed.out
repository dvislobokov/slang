version: "3.9"
services:
  - name: web
    image: nginx:1.25
    ports: [80, 443]
    env:
      A: "yes"
      TZ: UTC
    limits:
      cpu: 0.5
      memory: 512M
    mode: Prod
    replicas: 3
    command:
      - nginx
      - -g
      - daemon off;
    notes: |
      line one
      line two
  - name: db
    image: postgres
    ports: []
    limits: null
    mode: Dev
    replicas: 0
    command:
      - "true"
      - ""
      - "null"
      - "123"
      - " padded "
      - "a: b"
      - "#hash"
      - "- dash"
