// test: encoding.csv reader and writer semantics checked against Go encoding/csv (36 reader cases: quotes, CRLF, lazy quotes, comments, custom delimiters, leading-space trimming, field counts, errors with line/column; writer quoting with and without CRLF)
// status: passing
namespace spec.stdlib3.csv_corpus

import io

func quoted(recs [][]string) string {
    var parts []string = []
    for r in recs {
        var fs []string = []
        for x in r {
            fs = append(fs, encoding.json.Quote(x))
        }
        parts = append(parts, "[" + strings.Join(fs, " ") + "]")
    }
    return "[" + strings.Join(parts, " ") + "]"
}

func case0() {
    var r = encoding.csv.NewReader("a,b,c\n")
    r.Comma = ','
    r.LazyQuotes = false
    r.TrimLeadingSpace = false
    r.FieldsPerRecord = 0
    var recs = try r.ReadAll() catch err {
        println(0, "error", err.Message())
        return
    }
    println(0, quoted(recs))
}

