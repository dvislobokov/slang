func case36() {
    var w = encoding.csv.NewWriter()
    w.UseCRLF = false
    w.Write(["a", "b"])
    w.Write(["with,comma", "with\"quote"])
    w.Write(["", " lead", "trail "])
    w.Write(["new\nline", "cr\rx"])
    w.Write(["\\.", "tab\tin"])
    w.Write(["\tlead", "x"])
    w.Write(["é", "日本"])
    println(encoding.json.Quote(w.String()))
}

func case37() {
    var w = encoding.csv.NewWriter()
    w.UseCRLF = true
    w.Write(["a", "b"])
    w.Write(["with,comma", "with\"quote"])
    w.Write(["", " lead", "trail "])
    w.Write(["new\nline", "cr\rx"])
    w.Write(["\\.", "tab\tin"])
    w.Write(["\tlead", "x"])
    w.Write(["é", "日本"])
    println(encoding.json.Quote(w.String()))
}

