// test: std.regex Replace ($1, ${name}, $$, empty matches), ReplaceLiteral, Split/SplitN, Escape, ReplaceFunc; outputs checked against Go regexp
// status: passing
namespace spec.stdlib3.regex_api

import std
import std.io

func quoted(xs []string) string {
    var parts []string = []
    for x in xs {
        parts = append(parts, encoding.json.Quote(x))
    }
    return "[" + strings.Join(parts, " ") + "]"
}

func main() {
    println(regex.Pattern("a(x*)b").Replace("-ab-axxb-", "${1}W"))
    println(regex.Pattern("a(x*)b").Replace("-ab-axxb-", "$1W"))
    println(regex.Pattern("a(x*)b").Replace("-ab-axxb-", "$1"))
    println(regex.Pattern("a(?P<x>x*)b").Replace("-ab-axxb-", "[$x]"))
    println(regex.Pattern("a(x*)b").Replace("-ab-axxb-", "$$"))
    println(regex.Pattern("a(x*)b").Replace("-ab-axxb-", "$"))
    println(regex.Pattern("x*").Replace("abc", "-"))
    println(regex.Pattern("b*").Replace("abc", "-"))
    println(regex.Pattern("(\\w+) (\\w+)").Replace("hello world foo bar", "$2 $1"))
    println(regex.Pattern("(?P<k>\\w+)=(?P<v>\\w+)").Replace("a=1, b=2", "${v}=${k}"))
    println(regex.Pattern("\\s+").Replace("a  b \t c", " "))
    println(regex.Pattern("é").Replace("café é", "e"))
    println(regex.Pattern("").Replace("abc", "."))
    println(regex.Pattern("a|b").Replace("abcab", "$0$0"))
    println(regex.Pattern("(a)(b)?").Replace("ab a", "[$2]"))
    println(regex.Pattern("x").Replace("abc", "y"))
    println(regex.Pattern("(?i)HELLO").Replace("Hello hello", "bye"))
    println(regex.Pattern("^").Replace("abc", ">"))
    println(regex.Pattern("$").Replace("abc", "<"))
    println(regex.Pattern("(?m)^").Replace("a\nb", ">"))
    println(regex.Pattern("\\b").Replace("ab cd", "|"))
    println(regex.Pattern("a{2}").Replace("aaaaa", "X"))
    println(regex.Pattern("(\\d+)").Replace("a1b22c333", "<${1}0>"))
    println(regex.Pattern("${").Replace("x", "y"))
    println(regex.Pattern("a").Replace("banana", "${"))
    println(regex.Pattern("a").Replace("banana", "$1x"))
    println(regex.Pattern("(a)").Replace("banana", "${1x}"))
    println(regex.Pattern("a(x*)b").ReplaceLiteral("-ab-axxb-", "${1}W"))
    println(regex.Pattern("a(x*)b").ReplaceLiteral("-ab-axxb-", "$1W"))
    println(regex.Pattern("a(x*)b").ReplaceLiteral("-ab-axxb-", "$1"))
    println(regex.Pattern("a(?P<x>x*)b").ReplaceLiteral("-ab-axxb-", "[$x]"))
    println(regex.Pattern("a(x*)b").ReplaceLiteral("-ab-axxb-", "$$"))
    println(regex.Pattern("a(x*)b").ReplaceLiteral("-ab-axxb-", "$"))
    println(regex.Pattern("x*").ReplaceLiteral("abc", "-"))
    println(regex.Pattern("b*").ReplaceLiteral("abc", "-"))
    println(quoted(regex.Pattern(",").Split("a,b,c")))
    println(quoted(regex.Pattern(",").SplitN("a,b,c", 2)))
    println(quoted(regex.Pattern(",").Split("a,,b,")))
    println(quoted(regex.Pattern(",").SplitN("a,,b,", 2)))
    println(quoted(regex.Pattern("\\s*,\\s*").Split("a , b,c")))
    println(quoted(regex.Pattern("\\s*,\\s*").SplitN("a , b,c", 2)))
    println(quoted(regex.Pattern("x*").Split("axbxxc")))
    println(quoted(regex.Pattern("x*").SplitN("axbxxc", 2)))
    println(quoted(regex.Pattern("").Split("abc")))
    println(quoted(regex.Pattern("").SplitN("abc", 2)))
    println(quoted(regex.Pattern("b").Split("")))
    println(quoted(regex.Pattern("b").SplitN("", 2)))
    println(quoted(regex.Pattern("").Split("")))
    println(quoted(regex.Pattern("").SplitN("", 2)))
    println(quoted(regex.Pattern("a").Split("banana")))
    println(quoted(regex.Pattern("a").SplitN("banana", 2)))
    println(quoted(regex.Pattern("\\d").Split("x1y2z3")))
    println(quoted(regex.Pattern("\\d").SplitN("x1y2z3", 2)))
    println(quoted(regex.Pattern("(?:)").Split("héllo")))
    println(quoted(regex.Pattern("(?:)").SplitN("héllo", 2)))
    println(quoted(regex.Pattern("z").Split("abc")))
    println(quoted(regex.Pattern("z").SplitN("abc", 2)))
    println(quoted(regex.Pattern("^").Split("abc")))
    println(quoted(regex.Pattern("^").SplitN("abc", 2)))
    println(quoted(regex.Pattern("$").Split("abc")))
    println(quoted(regex.Pattern("$").SplitN("abc", 2)))
    println(quoted(regex.Pattern("a*").Split("baaac")))
    println(quoted(regex.Pattern("a*").SplitN("baaac", 2)))
    println(regex.Escape("a.b*c"), regex.Pattern(regex.Escape("a.b*c")).Match("a.b*c"))
    println(regex.Escape("x+y?"), regex.Pattern(regex.Escape("x+y?")).Match("x+y?"))
    println(regex.Escape("(a|b)"), regex.Pattern(regex.Escape("(a|b)")).Match("(a|b)"))
    println(regex.Escape("[x]"), regex.Pattern(regex.Escape("[x]")).Match("[x]"))
    println(regex.Escape("{1}"), regex.Pattern(regex.Escape("{1}")).Match("{1}"))
    println(regex.Escape("^$"), regex.Pattern(regex.Escape("^$")).Match("^$"))
    println(regex.Escape("\\d"), regex.Pattern(regex.Escape("\\d")).Match("\\d"))
    println(regex.Escape("plain"), regex.Pattern(regex.Escape("plain")).Match("plain"))
    println(regex.Escape(""), regex.Pattern(regex.Escape("")).Match(""))
    println(regex.Pattern("[aeiou]").ReplaceFunc("hello world", (s string) => strings.ToUpper(s)))
}
