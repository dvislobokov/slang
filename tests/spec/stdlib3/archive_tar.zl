// test: archive.tar reads a pax archive made by GNU tar (long name in a pax header, directory, mtimes) inside a .tar.gz, writes ustar entries (prefix split for long paths) and pax headers (non-ASCII / very long names, big uid), reads them back with the sequential Reader; corrupt checksums and unsafe names are errors; ExtractTo / FromDir round trip
// status: passing
namespace spec.stdlib3.archive_tar

import io

func short(name string) string {
    if len(name) > 30 {
        return name[..12] + "..." + name[len(name) - 6..]
    }
    return name
}

func main() void! {
    var tgz = encoding.base64.Decode(
        "",
    )?
    var data = compress.gzip.Decompress(tgz)?
    for e in archive.tar.Read(data)? {
        var h = e.Header
        println(
            short(h.Name),
            string(char(h.Type)),
            h.Size,
            len(e.Data),
            h.ModTime,
            h.Mode,
            h.Uid,
            h.IsDir(),
        )
    }

    var w = archive.tar.NewWriter()
    w.AddString("plain.txt", "plain")?
    w.AddDir("d", 1700000000)?
    var deep = strings.Repeat("segment/", 15) + "file.txt"
    w.AddString(deep, "deep")?
    w.AddString("ünïcödé.txt", "utf8")?
    w.AddString(strings.Repeat("x", 300), "long")?
    w.AddHeader(
        archive.tar.Header{
            Name: "link",
            Type: archive.tar.TypeSymlink,
            Linkname: "plain.txt",
            Uid: 5000000,
            Uname: "someone",
        },
        [],
    )?
    var out = w.Close()
    println(len(out) % 512 == 0)
    var r = archive.tar.NewReader(out)
    for {
        var h = r.Next()?
        if h == nil {
            break
        }
        println(
            short(h.Name),
            len(h.Name),
            string(char(h.Type)),
            h.Size,
            strings.FromBytes(r.Data()),
            h.Linkname,
            h.Uid,
            h.Uname,
        )
    }

    var bad []byte = []
    for b in out {
        bad = append(bad, b)
    }
    bad[0] = byte(81)
    try archive.tar.Read(bad) catch err {
        println(err.Message())
    }
    println(len(archive.tar.Read([])?))

    var tmp = fs.Join(fs.TempDir(), fmt.Format("zell-tar-test-{0}", os.Pid()))
    fs.RemoveAll(tmp)?
    archive.tar.ExtractTo(data, fs.Join(tmp, "x"))?
    var again = archive.tar.FromDir(fs.Join(tmp, "x"))?
    var names []string = []
    for e in archive.tar.Read(again)? {
        names = append(names, short(e.Header.Name))
    }
    println(names)
    var evil = archive.tar.NewWriter()
    evil.AddString("a/../../x", "no")?
    try archive.tar.ExtractTo(evil.Close(), tmp) catch err {
        println(err.Message())
    }
    fs.RemoveAll(tmp)?
}
