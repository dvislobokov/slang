// test: std.crypto.x509 parses certificates and keys (PEM/DER) and verifies chains: SAN/wildcard/IP host names, validity, EKU, CA flags, name constraints
// status: passing
// run-flags: --leak-check
namespace spec.stdlib.x509_verify

import std
import std.crypto
import std.io

