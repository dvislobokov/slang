// test: path helpers Join, Base, Dir, Ext behave like Go's path/filepath
// status: passing
namespace spec.stdlib.fs_paths

import std
import std.io

func main() {
    println(fs.Join("a/b", "c.txt"), fs.Join("a/b/", "../c"), fs.Join("/", "x"))
    println(
        fs.Base("/srv/app/main.zl"),
        fs.Base("dir/"),
        fs.Dir("/srv/app/main.zl"),
        fs.Dir("main.zl"),
    )
    println(fs.Ext("archive.tar.gz"), "[" + fs.Ext("Makefile") + "]", fs.Ext(".bashrc"))
}
