// test: io.ReadFile on a missing file fails with an error that names the path
// status: passing
namespace spec.stdlib.io_readfile_missing

import io

func main() {
    var text = try io.ReadFile("/nonexistent-zell-spec/missing.txt") catch err {
        println("failed:", strings.Contains(err.Message(), "/nonexistent-zell-spec/missing.txt"))
        return
    }
    println("unexpected", text)
}
