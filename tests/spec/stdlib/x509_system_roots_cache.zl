const interPEM = `-----BEGIN CERTIFICATE-----
MIICujCCAmGgAwIBAgIUc8cZK8vXLXjqQVs7y79Judx/sq0wCgYIKoZIzj0EAwIw
KzEaMBgGA1UEAwwRWmVsbCBUZXN0IFJvb3QgQ0ExDTALBgNVBAoMBFplbGwwIBcN
