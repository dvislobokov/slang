// test: zell run --leak-check reports objects kept alive by a strong cycle on stderr and exits with 66 when the cycle collector does not run (ZELL_CYCLES=manual)
// status: passing
// run-flags: --leak-check
// env: ZELL_CYCLES=manual
// exit: 66
// stderr: leak
namespace spec.memory.leak_check_cycle

import io

struct Node {
    Name  string
    Other *Node
}

func main() {
    var a = new Node{Name: "a"}
    var b = new Node{Name: "b", Other: a}
    a.Other = b
    println("cycle built")
}
