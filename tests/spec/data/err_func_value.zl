// error: the argument of Where must be a lambda literal
// status: passing
namespace spec.data.err_func_value

struct User {
    Id    int
    Name  string
    Age   int
    @data.ignore Cache string
    Orders []*Order
}

struct Order {
    Id     int
    UserId int
    Total  float
}

struct Shop {
    data.Context
    Users  data.Set<User>
    Orders data.Set<Order>
}

async func main() void! {
    var ctx = data.Open<Shop>(data.Provider.Sqlite, ":memory:")?
    var f = (u *User) => u.Age > 1
    _ = await ctx.Users.Where(f).ToList()?
}
