    Id    int
    Posts []Post
}

struct Post {
    Id    int
    Title string
}

struct Blogs {
    data.Context
    Blogs data.Set<Blog>
}

func main() {
    var ctx = data.OpenDB<Blogs>(data.Provider.Sqlite, database.sqlite.Open(":memory:"))
    println(ctx.Blogs.TableName())
}
