// error: User.Cache is not mapped to a column (@ignore)
// status: passing
namespace spec.data.err_ignored_field

struct User {
    Id    int
    Name  string
    Age   int
    @data.ignore Cache string
    Orders []*Order
}

struct Order {
    Id     int
    UserId int
    Total  float
}

struct Shop {
    data.Context
    Users  data.Set<User>
    Orders data.Set<Order>
}

async func main() void! {
    var ctx = data.Open<Shop>(data.Provider.Sqlite, ":memory:")?
    _ = await ctx.Users.OrderBy((u) => u.Cache).ToList()?
}
