order_lines labels categories
-- sqlite
CREATE TABLE "customers" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "mail" TEXT NOT NULL,
    "full_name" VARCHAR(80) NOT NULL,
    "nickname" TEXT,
    "note" TEXT NOT NULL,
    "created_at" TIMESTAMP NOT NULL DEFAULT (CURRENT_TIMESTAMP),
    "state" TEXT NOT NULL,
    "balance" TEXT NOT NULL,
    "settings" TEXT,
    "photo" BLOB NOT NULL,
    "active" BOOLEAN NOT NULL,
    "score" REAL NOT NULL,
    "version" INTEGER NOT NULL
);
CREATE TABLE "order_lines" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "customer_id" INTEGER NOT NULL,
    "product_name" VARCHAR(200) NOT NULL,
    "qty" INTEGER NOT NULL,
    CONSTRAINT "fk_order_lines_customers_customer_id" FOREIGN KEY ("customer_id") REFERENCES "customers" ("id") ON DELETE CASCADE
);
CREATE TABLE "labels" (
    "code" TEXT PRIMARY KEY,
    "title" TEXT NOT NULL
);
CREATE TABLE "categories" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "parent_id" INTEGER,
    "name" TEXT NOT NULL DEFAULT ('misc'),
    CONSTRAINT "fk_categories_categories_parent_id" FOREIGN KEY ("parent_id") REFERENCES "categories" ("id") ON DELETE SET NULL
);
CREATE TABLE "line_tags" (
    "order_line_id" INTEGER NOT NULL,
    "tag_id" TEXT NOT NULL,
    PRIMARY KEY ("order_line_id", "tag_id"),
    CONSTRAINT "fk_line_tags_order_lines_order_line_id" FOREIGN KEY ("order_line_id") REFERENCES "order_lines" ("id") ON DELETE CASCADE,
    CONSTRAINT "fk_line_tags_labels_tag_id" FOREIGN KEY ("tag_id") REFERENCES "labels" ("code") ON DELETE CASCADE
);
CREATE UNIQUE INDEX "ux_customers_mail" ON "customers" ("mail");
CREATE INDEX "ix_product_qty" ON "order_lines" ("product_name", "qty");
CREATE INDEX "ix_order_lines_customer_id" ON "order_lines" ("customer_id");
CREATE INDEX "ix_categories_parent_id" ON "categories" ("parent_id");
CREATE INDEX "ix_line_tags_tag_id" ON "line_tags" ("tag_id");
-- postgres
CREATE TABLE "customers" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "mail" text NOT NULL,
    "full_name" varchar(80) NOT NULL,
    "nickname" text,
    "note" text NOT NULL,
    "created_at" timestamptz NOT NULL DEFAULT now(),
    "state" text NOT NULL,
    "balance" numeric NOT NULL,
    "settings" jsonb,
    "photo" bytea NOT NULL,
    "active" boolean NOT NULL,
    "score" double precision NOT NULL,
    "version" bigint NOT NULL
);
CREATE TABLE "order_lines" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "customer_id" bigint NOT NULL,
    "product_name" varchar(200) NOT NULL,
    "qty" integer NOT NULL,
    CONSTRAINT "fk_order_lines_customers_customer_id" FOREIGN KEY ("customer_id") REFERENCES "customers" ("id") ON DELETE CASCADE
);
CREATE TABLE "labels" (
    "code" text PRIMARY KEY,
    "title" text NOT NULL
);
CREATE TABLE "categories" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "parent_id" bigint,
    "name" text NOT NULL DEFAULT 'misc',
    CONSTRAINT "fk_categories_categories_parent_id" FOREIGN KEY ("parent_id") REFERENCES "categories" ("id") ON DELETE SET NULL
);
CREATE TABLE "line_tags" (
    "order_line_id" bigint NOT NULL,
    "tag_id" text NOT NULL,
    PRIMARY KEY ("order_line_id", "tag_id"),
    CONSTRAINT "fk_line_tags_order_lines_order_line_id" FOREIGN KEY ("order_line_id") REFERENCES "order_lines" ("id") ON DELETE CASCADE,
    CONSTRAINT "fk_line_tags_labels_tag_id" FOREIGN KEY ("tag_id") REFERENCES "labels" ("code") ON DELETE CASCADE
);
CREATE UNIQUE INDEX "ux_customers_mail" ON "customers" ("mail");
CREATE INDEX "ix_product_qty" ON "order_lines" ("product_name", "qty");
CREATE INDEX "ix_order_lines_customer_id" ON "order_lines" ("customer_id");
CREATE INDEX "ix_categories_parent_id" ON "categories" ("parent_id");
CREATE INDEX "ix_line_tags_tag_id" ON "line_tags" ("tag_id");
