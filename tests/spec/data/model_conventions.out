Customer customers 13 id version
  Id -> id int64 false true true
  Email -> mail string false false false
  FullName -> full_name string false false false
  Nickname -> nickname string true false false
  Note -> note string false false false
  CreatedAt -> created_at time false false false
  State -> state enum false false false
