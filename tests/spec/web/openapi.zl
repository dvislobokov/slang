// test: the OpenAPI 3.1 document generated from the compiled route table: paths in registration order, operation ids and tags from controllers, path/query/header parameters with JSON Schemas, request bodies with @validate keywords, response schemas per result type, bearer security for @authorize, the components; json.Schema<T> directly; the /swagger page
// status: passing
// run-flags: --leak-check
namespace spec.web.openapi

import io
import web

enum Status { Open, Closed }

struct Tag {
    Name string
}

struct Ticket {
    @json(name: "id")                                      Id       int
    @validate(required: true, minLength: 3, maxLength: 80) Title    string
    @validate(email: true)                                 Reporter string
    @validate(range: [1, 5])                               Priority int
    Status Status
    Tags   []Tag
    Meta   map[string]string
    Parent *Ticket
    @json(skip: true) secret string
}

@route("/tickets")
@authorize(roles: ["agent"])
struct TicketsController {
    @get("")
    @allowAnonymous
    @summary("List tickets")
    func List(status *Status, @query("page") p int, @header("X-Tenant") tenant string) []Ticket {
        return []
    }

    @post("")
    func Create(@body t Ticket) Result<Ticket> {
        return Created(t)
    }

    @delete("{id}")
    func Delete(id int) void {}
}

async func main() void! {
    var app = NewAppWith(AppOptions{Title: "Tickets", Version: "0.9.0"})
    app.MapController<TicketsController>()
    app.MapGet("/ping", () => "pong")
    app.MapHealthChecks("/health")
    app.MapOpenApi("/openapi.json")
    app.MapSwagger("/swagger", "/openapi.json")
    var c = TestServer(app)?
    var r = await c.Get("/openapi.json")
    println(r.Status, r.Header("Content-Type"))
    var doc = encoding.json.ParseValue(r.Body)?
    println("openapi:", doc.Get("openapi").String()?, doc.Get("info").Format())
    var paths = doc.Get("paths")
    println("paths:", paths.Keys())
    for p in paths.Keys() {
        for m in paths.Get(p).Keys() {
            var op = paths.Get(p).Get(m)
            println(m, p, op.Format())
        }
    }
    println(
        "components:",
        doc.Get("components").Keys(),
        doc.Get("components").Get("securitySchemes").Format(),
    )
    println("schema int:", encoding.json.Schema<int>())
    println("schema []string:", encoding.json.Schema<[]string>())
    println("schema map:", encoding.json.Schema<map[string]float>())
    println("schema Tag:", encoding.json.Schema<Tag>())
    var s = await c.Get("/swagger")
    println(
        "swagger:",
        s.Status,
        s.Header("Content-Type"),
        strings.Contains(s.Body, "SwaggerUIBundle({ url: \"/openapi.json\""),
        strings.Contains(s.Body, "<title>Tickets - Swagger UI</title>"),
    )
}
