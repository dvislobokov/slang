// test: @validate (required, min, max, range, minLength, maxLength, pattern, email, message) on body fields, nested structs and slices, and on route/query parameters: every failure is listed in one 400 Problem Details; web.Validate<T> checks a value directly
// status: passing
// run-flags: --leak-check
namespace spec.web.validation

import io
import web

struct Address {
    @validate(required: true)      City string
    @validate(pattern: "[0-9]{5}") Zip  string
}

struct Line {
    @validate(required: true)  Sku string
    @validate(min: 1, max: 99) Qty int
}

struct Order {
    @json(name: "email") @validate(required: true, email: true)      Email    string
    @validate(minLength: 3, maxLength: 10)                           Name     string
    @validate(range: [0, 100], message: "Discount is a percentage.") Discount float
    @validate(required: true)                                        Count    int
    Ship Address
    @validate(minLength: 1, maxLength: 2) Lines []Line
    Note *string
}

@route("/orders")
struct OrdersController {
    @post("")
    func Create(@body o Order) string {
        return "ok " + o.Email
    }

    @get("{id}")
    func Get(@validate(min: 1) id int, @validate(required: true, maxLength: 5) q string) string {
        return "order " + q
    }
}

func show(errs []FieldError) {
    if len(errs) == 0 {
        println("valid")
    }
    for e in errs {
        println(" ", e.Field, "|", e.Message)
    }
}

async func main() void! {
    var app = NewApp()
    app.MapController<OrdersController>()
    var c = TestServer(app)?
    var good = "{\"email\": \"a@b.co\", \"Name\": \"Ann\", \"Discount\": 10, \"Count\": 0, \"Ship\": {\"City\": \"Oslo\", \"Zip\": \"01234\"}, \"Lines\": [{\"Sku\": \"x\", \"Qty\": 2}]}"
    var r = await c.Post("/orders", good)
    println(r.Status, r.Body)
    var bad = "{\"email\": \"not-an-email\", \"Name\": \"Al\", \"Discount\": 150, \"Ship\": {\"Zip\": \"12\"}, \"Lines\": [{\"Sku\": \"\", \"Qty\": 0}, {\"Sku\": \"y\", \"Qty\": 100}, {\"Sku\": \"z\", \"Qty\": 1}]}"
    r = await c.Post("/orders", bad)
    println(r.Status, r.Header("Content-Type"))
    var doc = encoding.json.ParseValue(r.Body)?
    println(doc.Get("title").String()?)
    var errs = doc.Get("errors")
    for k in errs.Keys() {
        println(" ", k, errs.Get(k).Format())
    }
    r = await c.Get("/orders/0?q=toolong")
    println(r.Status, r.Body)
    r = await c.Get("/orders/1")
    println(r.Status, r.Body)
    r = await c.Get("/orders/2?q=ok")
    println(r.Status, r.Body)

    println("direct:")
    show(Validate(Order{Email: "x@y.z", Name: "Bob", Count: 1}))
    show(Validate(Order{
        Email: "",
        Name: "B",
        Lines: [Line{Sku: "s", Qty: 5}, Line{Sku: "t", Qty: 500}],
    }))
}
