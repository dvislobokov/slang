// test: web.config: appsettings.json < .yaml < .toml < appsettings.<env>.* < APP__ environment variables < --arguments, case-insensitive keys, Bind<T> of nested structs, slices, maps and pointers with conversion errors and @validate, Options<T> reload when a file changes, embedded defaults
// status: passing
// run-flags: --leak-check
namespace spec.web.config

import io
import web

struct Db {
    Host string
    @validate(range: [1, 65535]) Port int
    Replicas []string
}

struct Settings {
    Name   string
    Debug  bool
    Ratio  float
    Db     Db
    Limits map[string]int
    Proxy  *string
    Tags   []string
}

async func main() void! {
    var dir = "/tmp/zell-web-spec-config"
    fs.MkdirAll(dir)?
    io.WriteFile(
        dir + "/appsettings.json",
        "{\"Name\": \"json\", \"Ratio\": 0.5, \"Db\": {\"Host\": \"db.local\", \"Port\": 5432, \"Replicas\": [\"r1\", \"r2\"]}, \"Limits\": {\"read\": 10, \"write\": 2}, \"Tags\": \"a,b\"}",
    )?
    io.WriteFile(dir + "/appsettings.yaml", "Debug: true\ndb:\n  replicas:\n    - y1\n")?
    io.WriteFile(dir + "/appsettings.toml", "[Limits]\nwrite = 5\n")?
    io.WriteFile(dir + "/appsettings.staging.json", "{\"Name\": \"staging\"}")?
    os.Setenv("APP__Db__Host", "env-host")?
    var o = config.LoadOptions{
        Dir: dir,
        Environment: "staging",
        Args: ["--Db:Port=6000", "--Proxy", "http://proxy", "--ignored"],
    }
    var c = config.Load(o)?
    println("env:", c.Environment, len(c.Files()))
    println(
        "get:",
        c.Get("name"),
        c.Get("DB:HOST"),
        c.Get("db:port"),
        c.Get("missing") == "",
        c.Has("debug"),
    )
    var s = c.Bind<Settings>("")?
    println(
        "bind:",
        s.Name,
        s.Debug,
        s.Ratio,
        s.Db.Host,
        s.Db.Port,
        s.Db.Replicas,
        s.Limits["read"],
        s.Limits["write"],
        *s.Proxy,
        s.Tags,
    )
    var db = c.Bind<Db>("Db")?
    println("section:", db.Host, db.Port)

    var bad = config.Load(config.LoadOptions{
        Dir: dir,
        Environment: "staging",
        Args: ["--Db:Port=99999", "--Debug=perhaps"],
    })?
    try bad.Bind<Settings>("") catch err {
        println(err)
    }
    var bad2 = config.Load(config.LoadOptions{
        Dir: dir,
        Environment: "staging",
        Args: ["--Db:Port=0"],
    })?
    try bad2.Bind<Settings>("") catch err {
        println(err)
    }

    var defaults = config.Load(config.LoadOptions{
        NoFiles: true,
        NoArgs: true,
        EnvPrefix: "-",
        Defaults: "{\"Db\": {\"Host\": \"embedded\", \"Port\": 1}}",
    })?
    println("defaults:", defaults.Bind<Db>("Db")?.Host)

    var opts = config.NewOptions<Db>(c, "Db")?
    opts.OnChange((d Db) => println("changed: port", d.Port, "replicas", d.Replicas))
    println("options:", opts.Value().Port, opts.Version(), opts.CheckForChanges()?)
    io.WriteFile(
        dir + "/appsettings.yaml",
        "Debug: true\ndb:\n  replicas:\n    - y1\n    - y2\n    - y3\n",
    )?
    println("reloaded:", opts.CheckForChanges()?, opts.Version(), opts.Value().Replicas)
    io.WriteFile(dir + "/appsettings.staging.json", "{oops")?
    try opts.CheckForChanges() catch err {
        println("reload failed:", err)
    }
    println("kept:", opts.Value().Port, opts.Version(), opts.LastError() != "")
    os.Setenv("APP__Db__Host", "")?
}
