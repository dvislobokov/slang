// test: web routing: controller prefixes, relative and absolute action routes, several verbs on one method, MapControllers<A, B>, minimal API handlers, 404/405 Problem Details, HEAD via GET, wildcard segments
// status: passing
// run-flags: --leak-check
namespace spec.web.routing

import io
import web

@route("/api/books")
struct BooksController {
    @get("")
    func List() string {
        return "list"
    }

    @get("{id}")
    func Get(id int) string {
        return "book " + fmt.Format("{0}", id)
    }

    @put("{id}")
    @patch("{id}")
    func Update(id int, c *Context) string {
        return c.Method() + " book " + fmt.Format("{0}", id)
    }

    @get("/version")
    func Version() string {
        return "v1"
    }

    @get("{id}/pages/{page}")
    func Page(id int, page int) string {
        return fmt.Format("book {0} page {1}", id, page)
    }
}

@route("/api/authors/")
struct AuthorsController {
    @get("{name}")
    func Get(name string) string {
        return "author " + name
    }
}

func files(c *Context) string {
    return "file " + c.Param("*")
}

async func main() void! {
    var app = NewApp()
    app.MapControllers<BooksController, AuthorsController>()
    app.MapGet("/", () => "root")
    app.MapDelete("/api/books/{id}", (id int) => "deleted " + fmt.Format("{0}", id))
    app.MapGet("/files/*", files)
    var c = TestServer(app)?
    for path in [
        "/",
        "/api/books",
        "/api/books/7",
        "/api/books/7/pages/3",
        "/version",
        "/api/authors/ann",
        "/files/a/b.txt",
        "/api/books/",
    ] {
        var r = await c.Get(path)
        println("GET", path, "->", r.Status, r.Body)
    }
    var r = await c.Put("/api/books/2", "")
    println("PUT ->", r.Status, r.Body)
    r = await c.Patch("/api/books/2", "")
    println("PATCH ->", r.Status, r.Body)
    r = await c.Delete("/api/books/2")
    println("DELETE ->", r.Status, r.Body)
    r = await c.Send("HEAD", "/api/books", "", nil)
    println("HEAD ->", r.Status, r.Body)
    r = await c.Post("/api/books/2", "")
    println("POST ->", r.Status, r.Header("Allow"), r.Header("Content-Type"))
    println(r.Body)
    r = await c.Get("/nowhere")
    println("GET /nowhere ->", r.Status, r.Body)
    for e in app.Endpoints() {
        println(e.Method, e.Pattern, e.Name, e.Tag)
    }
}
