// test: web parameter binding: route values, query (renamed, optional pointers, slices, enums, bools), headers, form fields and JSON bodies, with conversion errors collected into one 400 Problem Details
// status: passing
// run-flags: --leak-check
namespace spec.web.binding

import io
import web

enum Sort { Name, Date }

struct Filter {
    Tags  []string
    Limit int
}

struct Note {
    Title string
    Pages int
    Draft bool
}

@route("/notes")
struct NotesController {
    @get("{id}")
    func Get(
        id int8,
        @query("q") search string,
        page *int,
        sort Sort,
        tags []string,
        verbose bool,
        @header("X-Trace") trace string,
    ) string {
        var p = "nil"
        if page != nil {
            p = fmt.Format("{0}", *page)
        }
        return fmt.Format(
            "id={0} q={1} page={2} sort={3} tags={4} verbose={5} trace={6}",
            id,
            search,
            p,
            sort,
            tags,
            verbose,
            trace,
        )
    }

    @post("")
    func Create(@body n Note, @header("X-User") user string) Result<Note> {
        var out = n
        out.Title = n.Title + " by " + user
        return Created(out)
    }

    @post("login")
    func Login(@form user string, @form("pw") password string, @form remember bool) string {
        return fmt.Format("user={0} pw={1} remember={2}", user, password, remember)
    }

    @post("search")
    func Search(f Filter) string {
        return fmt.Format("{0} {1}", f.Tags, f.Limit)
    }
}

async func main() void! {
    var app = NewApp()
    app.MapController<NotesController>()
    app.MapGet("/sum/{a}/{b}", func(a int, b float, scale *float) float {
        var s = 1.0
        if scale != nil {
            s = *scale
        }
        return (float(a) + b) * s
    })
    var c = TestServer(app)?
    var gets = [
        "/notes/5",
        "/notes/-3?q=hello%20world&page=2&sort=date&tags=a,b&tags=c&verbose=yes",
        "/sum/2/0.5",
        "/sum/2/0.5?scale=3",
        "/notes/500?page=x&sort=size&verbose=maybe",
        "/sum/x/y",
    ]
    for path in gets {
        var r = await c.WithHeader("X-Trace", "t1").Get(path)
        println(path, "->", r.Status, r.Body)
    }
    var r = await c.WithHeader("X-User", "ann").Post(
        "/notes",
        "{\"Title\": \"Plan\", \"Pages\": 3, \"Draft\": true}",
    )
    println(r.Status, r.Body)
    r = await c.Post("/notes", "{\"Title\": \"Plan\", \"Pages\": \"three\"}")
    println(r.Status, r.Body)
    r = await c.Post("/notes", "{\"Title\": ")
    println(r.Status, r.Body)
    r = await c.Post("/notes", "")
    println(r.Status, r.Body)
    r = await c.Send("POST", "/notes/login", "user=ann+lee&pw=p%26w&remember=on", nil)
    println(r.Status, r.Body)
    r = await c.Post("/notes/search", "{\"Tags\": [\"x\", \"y\"], \"Limit\": 2}")
    println(r.Status, r.Body)
}
