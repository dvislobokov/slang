// test: hand-written JSON-like document model: a recursive enum, pretty and compact printers, string escaping, path queries with errors
// status: passing
namespace spec.programs.json_printer

import io

enum Json {
    Null
    Bool(v bool)
    Num(v float)
    Str(s string)
    Arr(items []Json)
    Obj(keys []string, vals []Json)
}

func Quote(s string) string {
    var out = "\""
    for _, c in s {
        switch c {
            case '"': out += "\\\""
            case '\\': out += "\\\\"
            case '\n': out += "\\n"
            case '\t': out += "\\t"
            default:
                out += string(c)
        }
    }
    return out + "\""
}

func IsScalar(j Json) bool {
    switch j {
        case Json.Arr(_): return false
        case Json.Obj(_, _): return false
        default:
            return true
    }
}

func Compact(j Json) string {
    switch j {
        case Json.Null: return "null"
        case Json.Bool(v):
            if v { return "true" }
            return "false"
        case Json.Num(v): return fmt.Format("{0}", v)
        case Json.Str(s): return Quote(s)
        case Json.Arr(items):
            var parts []string = []
            for it in items { parts = append(parts, Compact(it)) }
            return "[" + strings.Join(parts, ", ") + "]"
        case Json.Obj(keys, vals):
            var parts []string = []
            for i, k in keys { parts = append(parts, Quote(k) + ": " + Compact(vals[i])) }
            return "{" + strings.Join(parts, ", ") + "}"
        default:
            return "?"
    }
}

func Pretty(j Json, ind int) string {
    var pad = strings.Repeat("  ", ind)
    switch j {
        case Json.Arr(items):
            if len(items) == 0 { return "[]" }
            var simple = true
            for it in items {
                if !IsScalar(it) { simple = false }
            }
            if simple { return Compact(j) }
            var b = "[\n"
            for i, it in items {
                b += pad + "  " + Pretty(it, ind + 1)
                if i < len(items) - 1 { b += "," }
                b += "\n"
            }
            return b + pad + "]"
        case Json.Obj(keys, vals):
            if len(keys) == 0 { return "{}" }
            var b = "{\n"
            for i, k in keys {
                b += pad + "  " + Quote(k) + ": " + Pretty(vals[i], ind + 1)
                if i < len(keys) - 1 { b += "," }
                b += "\n"
            }
            return b + pad + "}"
        default:
            return Compact(j)
    }
}

func Get(doc Json, path string) Json! {
    var cur = doc
    for seg in strings.Split(path, ".") {
        switch cur {
            case Json.Obj(keys, vals):
                var found = -1
                for i, k in keys {
                    if k == seg { found = i }
                }
                if found < 0 { return error("no key " + seg) }
                cur = vals[found]
            case Json.Arr(items):
                var i = try strings.ToInt(seg) else -1
                if i < 0 || i >= len(items) {
                    return error(fmt.Format("index {0} out of range", i))
                }
                cur = items[i]
            default:
                return error("not a container at " + seg)
        }
    }
    return cur
}

func Count(j Json) int {
    switch j {
        case Json.Arr(items):
            var n = 1
            for it in items { n += Count(it) }
            return n
        case Json.Obj(_, vals):
            var n = 1
            for v in vals { n += Count(v) }
            return n
        default:
            return 1
    }
}

func Author(name string, commits int) Json {
    return Json.Obj(["name", "commits"], [Json.Str(name), Json.Num(float(commits))])
}

func main() {
    var noKeys []string = []
    var noVals []Json = []
    var doc = Json.Obj(["name", "version", "tags", "deps", "authors", "meta"], [
        Json.Str("zell"),
        Json.Num(0.1),
        Json.Arr([Json.Str("fast"), Json.Str("simple")]),
        Json.Obj(noKeys, noVals),
        Json.Arr([Author("ann", 3), Author("bo", 1)]),
        Json.Obj(["stable", "owner", "quote"], [
            Json.Bool(false),
            Json.Null,
            Json.Str("say \"hi\"\n"),
        ]),
    ])
    println(Pretty(doc, 0))
    println(Compact(doc))
    println("nodes", Count(doc))
    for q in [
        "authors.1.name",
        "meta.stable",
        "authors.0",
        "tags.5",
        "name.x",
        "meta.missing",
        "tags.first",
    ] {
        var v = try Get(doc, q) catch err {
            println(q, "error:", err)
            continue
        }
        println(q, "=", Compact(v))
    }
}
