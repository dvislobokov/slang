parse ann@example.com ->  | ann@example.com | <ann@example.com>
parse <b@x.org> ->  | b@x.org | <b@x.org>
parse Bob Smith <bob@x.org> -> Bob Smith | bob@x.org | Bob Smith <bob@x.org>
parse "Smith, Bob" <bob@x.org> -> Smith, Bob | bob@x.org | "Smith, Bob" <bob@x.org>
parse =?utf-8?q?J=C3=BCrgen?= <j@x.de> -> Jürgen | j@x.de | =?utf-8?q?J=C3=BCrgen?= <j@x.de>
parse carl@x.org (Carl) -> Carl | carl@x.org | Carl <carl@x.org>
parse bad -> mail: invalid address "bad"
parse a@b, c@d -> mail: expected a single address in "a@b, c@d"
2 a@x.org B, b
