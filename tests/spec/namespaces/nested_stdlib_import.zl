// test: import crypto gives hash.X; import crypto.hash gives bare X
// status: passing
namespace spec.namespaces.nested_stdlib_import

import crypto
import crypto.hash
import io

func main() {
    println(hash.Sha1Hex("abc") == Sha1Hex("abc"), hash.Md5Hex("") == Md5Hex(""))
    println(crypto.hash.Crc32("123456789"))
}
