// test: with ZELL_DIAG_HEAP=1 (no --leak-check) diag.HeapByType counts live objects per type, and HeapReport shows the growth since the previous report
// status: passing
// env: ZELL_DIAG_HEAP=1
namespace spec.memory3.heap_by_type

import io

struct Item {
    Id   int
    Name string
}

func live(name string) int {
    for t in diag.HeapByType() {
        if t.Type == name {
            return t.Live
        }
    }
    return 0
}

func main() {
    println("counting", diag.HeapCounting())
    var items []*Item = []
    for i in 0..40 {
        items = append(items, new Item{Id: i})
    }
    println("items", live("spec.memory3.heap_by_type.Item"))
    var first = diag.HeapReport(100)
    println("first report lists Item", strings.Contains(first, "spec.memory3.heap_by_type.Item"))
    for i in 0..10 {
        items = append(items, new Item{Id: i})
    }
    var second = diag.HeapReport(100)
    for line in strings.Split(second, "\n") {
        if strings.HasSuffix(line, " spec.memory3.heap_by_type.Item") {
            println(strings.Fields(line)[0], strings.Fields(line)[1])
        }
    }
    items = []
    println("after clear", live("spec.memory3.heap_by_type.Item"))
}
