// test: @cfg(not(os: "linux")) excludes a declaration on linux; @cfg(not(os: "windows")) keeps it
// status: passing
// os: linux
namespace spec.platform.cfg_not

import io

@cfg(not(os: "linux"))
func Kind() string {
    return "not linux"
}

@cfg(not(os: "windows"))
func Kind() string {
    return "unix-like"
}

func main() {
    println(Kind())
}
