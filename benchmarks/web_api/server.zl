namespace bench.web_api

import web

// web_api: a small REST API on the `web` framework (attribute routing,
// DI, JSON binding, @validate, middleware), the Zell side of
// benchmarks/web_api (the Go sides are go/gin and go/nethttp, the load
// generator go/load). Prints its port on stderr and serves until killed.
//
//   GET  /api/items/{id}              one item (404 if missing)
//   GET  /api/items?category=&limit=  items of a category, in id order
//   GET  /api/items/{id}/quote?qty=   path parameter + query
//   POST /api/orders                  validated JSON body -> 201 + order
//
// Every request goes through a request-logging middleware (one rendered
// line per request into a discarding sink) and an API-key middleware
// (X-Api-Key: bench-key, else 401).

struct Item {
    Id         int
    Name       string
    Category   string
    PriceCents int
    Stock      int
}

struct Quote {
    ItemId     int
    Qty        int
    TotalCents int
}

struct NewOrder {
    @validate(range: [1, 1000])            ItemId int
    @validate(range: [1, 100])             Qty    int
    @validate(required: true, email: true) Email  string
}

struct Order {
    Id         int
    ItemId     int
    Qty        int
    Email      string
    TotalCents int
}

var categories = ["tools", "books", "games", "food"]

// The catalogue: 1000 items, the same data as the Go servers.
struct Catalog {
    items []Item

    static func New() *Catalog {
        var xs []Item = []
        for i in 1..1001 {
            xs = append(xs, Item{
                Id: i,
                Name: fmt.Format("item-{0}", i),
                Category: categories[i % 4],
                PriceCents: (i * 37) % 10000 + 100,
                Stock: i % 50,
            })
        }
        return new Catalog{items: xs}
    }

    func Get(id int) (Item, bool) {
        if id < 1 || id > len(this.items) {
            return (Item{}, false)
        }
        return (this.items[id - 1], true)
    }

    func List(category string, limit int) []Item {
        var out []Item = []
        for it in this.items {
            if len(out) >= limit {
                break
            }
            if category == "" || it.Category == category {
                out = append(out, it)
            }
        }
        return out
    }
}

// Order ids (shared by all requests).
struct Orders {
    next sync.AtomicInt

    func Next() int {
        return this.next.Add(1)
    }
}

@route("/api")
struct ItemsController {
    catalog *Catalog
    orders  *Orders

    @get("items/{id}")
    func Get(id int) Result<Item> {
        var (it, ok) = this.catalog.Get(id)
        if !ok {
            return NotFound()
        }
        return Ok(it)
    }

    @get("items")
    func List(category string, limit int) []Item {
        var n = limit
        if n <= 0 || n > 100 {
            n = 20
        }
        return this.catalog.List(category, n)
    }

    @get("items/{id}/quote")
    func GetQuote(id int, qty int) Result<Quote> {
        var (it, ok) = this.catalog.Get(id)
        if !ok {
            return NotFound()
        }
        return Ok(Quote{ItemId: id, Qty: qty, TotalCents: it.PriceCents * qty})
    }

    @post("orders")
    func Create(@body o NewOrder) Result<Order> {
        var (it, ok) = this.catalog.Get(o.ItemId)
        if !ok {
            return NotFound()
        }
        return Created(Order{
            Id: this.orders.Next(),
            ItemId: o.ItemId,
            Qty: o.Qty,
            Email: o.Email,
            TotalCents: it.PriceCents * o.Qty,
        })
    }
}

// A sink that renders every event (as a text sink would) and drops it.
struct DiscardSink {
    func Emit(e *log.Event) {
        _ = e.Render(true)
    }

    func Close() Task<void> {
        return task.Delay(0)
    }
}

async func apiKey(c *Context, next *Next) void! {
    if c.Header("X-Api-Key") != "bench-key" {
        c.Text(401, "unauthorized")
        return
    }
    await next.Run(c)?
}

async func main() void! {
    var logger = log.New().WriteTo.Sink(new DiscardSink{}).CreateLogger()
    var app = NewAppWith(AppOptions{Logger: logger, Environment: "production"})
    app.Services.AddSingleton<Catalog>()
    app.Services.AddSingleton<Orders>()
    app.UseLogging()
    app.Use(apiKey)
    app.MapController<ItemsController>()
    app.Listen("127.0.0.1:0")?
    io.Eprintln(fmt.Format("{0}", app.Port()))
    await app.Run("")?
}
