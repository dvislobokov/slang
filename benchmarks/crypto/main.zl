// n bytes: base, base+1, ... (mod 256).
func seq(n int, base int) []byte {
    var out []byte = []
    for i in 0..n {
        out = append(out, byte((base + i) & 255))
    }
    return out
}

// 1 MB of pseudo-random bytes (the LCG of main.go).
func chunk() []byte {
    var out []byte = []
    var s = 12345
    for _ in 0..1048576 {
        s = (s * 1103515245 + 12345) % 2147483648
        out = append(out, byte((s >> 16) & 255))
    }
    return out
}

func xorInto(acc []byte, x []byte) {
    for i in 0..len(acc) {
        acc[i] = acc[i] ^ x[i]
    }
}

func cat(a []byte, b []byte) []byte {
    var out = a
    for x in b {
        out = append(out, x)
    }
    return out
}

func now() int {
    return time.NowNanos()
}

func report(name string, t0 int, t1 int, n int, unit string) {
    var d = t1 - t0
    if d <= 0 {
        d = 1
    }
    if unit == "MB" {
        io.Eprintln(fmt.Format("{0}: {1} ms, {2} MB/s", name, d / 1000000, n * 1000 / d))
    } else {
        io.Eprintln(fmt.Format("{0}: {1} ms, {2} ops/s", name, d / 1000000, n * 1000000000 / d))
    }
}

async func echoOnce(c tls.Conn) void! {
    var b = await c.Read(65536)?
    if len(b) > 0 {
        _ = await c.Write(b)?
    }
    c.Close()
}

async func serve(l tls.Listener) {
    for {
        var c = try await l.Accept() catch err {
            return
        }
        _ = echoOnce(c)
    }
}

async func main() void! {
    var mb = 1024
    var div = 1
    if os.Getenv("SCALE") == "small" {
        mb = 16
        div = 20
    }
    var buf = chunk()

    // SHA-256 / SHA-512: digest of each 1 MB chunk (chunk i starts with i).
    for alg in ["sha256", "sha512"] {
        var digests []byte = []
        var t0 = now()
        for i in 0..mb {
            buf[0] = byte(i & 255)
            buf[1] = byte(i >> 8)
            digests = cat(digests, crypto.hash.Sum(alg, buf)?)
        }
        var t1 = now()
        println(alg, hex.Encode(crypto.hash.Sum("sha256", digests)?))
        report(alg, t0, t1, mb * 1048576, "MB")
    }

    // AEAD sealing: 1 MB messages, nonce = counter.
    var key = seq(32, 7)
    for alg in ["aes-256-gcm", "chacha20-poly1305"] {
        var tags []byte = []
        var nonce = seq(12, 0)
        var t0 = now()
        for i in 0..mb {
            nonce[8] = byte(i & 255)
            nonce[9] = byte(i >> 8)
            var ct []byte = []
            if alg == "aes-256-gcm" {
                ct = aes.GcmSeal(key, nonce, buf, [])?
            } else {
                ct = chacha.Seal(key, nonce, buf, [])?
            }
            tags = cat(tags, ct[len(ct) - 16..])
        }
        var t1 = now()
        println(alg, hex.Encode(crypto.hash.Sum("sha256", tags)?))
        report(alg, t0, t1, mb * 1048576, "MB")
    }

    // X25519 shared secrets.
    var nx = 20000 / div
    var peer = x25519.PublicKey(seq(32, 99))?
    var priv = seq(32, 1)
    var acc = seq(32, 0)
    var t0 = now()
    for i in 0..nx {
        priv[2] = byte(i & 255)
        priv[1] = byte(i >> 8)
        xorInto(acc, x25519.SharedSecret(priv, peer)?)
    }
    var t1 = now()
    println("x25519", nx, hex.Encode(acc))
    report("x25519", t0, t1, nx, "ops")

    // Ed25519.
    var ne = 20000 / div
    var seed = seq(32, 42)
    var pub = ed25519.PublicKey(seed)?
    var msg = seq(64, 3)
    var sigs [][]byte = []
    var all []byte = []
    t0 = now()
    for i in 0..ne {
        msg[0] = byte(i & 255)
        msg[1] = byte(i >> 8)
        var s = ed25519.Sign(seed, msg)?
        sigs = append(sigs, s)
    }
    t1 = now()
    var ok = 0
    for i in 0..ne {
        msg[0] = byte(i & 255)
        msg[1] = byte(i >> 8)
        if ed25519.Verify(pub, msg, sigs[i]) {
            ok += 1
        }
    }
    var t2 = now()
    for s in sigs {
        all = cat(all, s)
    }
    println("ed25519", ne, ok, hex.Encode(crypto.hash.Sum("sha256", all)?))
    report("ed25519 sign", t0, t1, ne, "ops")
    report("ed25519 verify", t1, t2, ne, "ops")

    // RSA-2048 PKCS#1 v1.5 with SHA-256.
    var der = hex.Decode(strings.Replace(rsaKeyHex, "\n", ""))?
    var rpub = rsa.PublicKeyOf(der)?
    var nrs = 500 / div
    var nrv = 5000 / div
    var digest = crypto.hash.Sum("sha256", msg)?
    var rsig []byte = []
    var rall []byte = []
    t0 = now()
    for i in 0..nrs {
        digest[0] = byte(i & 255)
        rsig = rsa.SignPKCS1v15(der, "sha256", digest)?
        rall = cat(rall, rsig[0..8])
    }
    t1 = now()
    var rok = 0
    for _ in 0..nrv {
        if rsa.VerifyPKCS1v15(rpub.N, rpub.E, "sha256", digest, rsig) {
            rok += 1
        }
    }
    t2 = now()
    println("rsa2048", nrs, rok, hex.Encode(crypto.hash.Sum("sha256", rall)?))
    report("rsa2048 sign", t0, t1, nrs, "ops")
    report("rsa2048 verify", t1, t2, nrv, "ops")

    // P-256 ECDSA (randomized signatures: count the verified ones).
    var np = 10000 / div
    var epriv = seq(32, 1)
    var epub = ecdsa.PublicKey(epriv)?
    var esigs [][]byte = []
    t0 = now()
    for i in 0..np {
        digest[0] = byte(i & 255)
        digest[1] = byte(i >> 8)
        esigs = append(esigs, ecdsa.Sign(epriv, digest)?)
    }
    t1 = now()
    var eok = 0
    for i in 0..np {
        digest[0] = byte(i & 255)
        digest[1] = byte(i >> 8)
        if ecdsa.Verify(epub, digest, esigs[i]) {
            eok += 1
        }
    }
    t2 = now()
    println("p256", np, eok, hex.Encode(epub[0..8]))
    report("p256 sign", t0, t1, np, "ops")
    report("p256 verify", t1, t2, np, "ops")

    // HKDF-SHA256, 32-byte keys.
    var nh = 200000 / div
    var secret = seq(32, 5)
    var salt = seq(16, 9)
    var info = seq(16, 11)
    var hacc = seq(32, 0)
    t0 = now()
    for i in 0..nh {
        info[0] = byte(i & 255)
        info[1] = byte(i >> 8)
        info[2] = byte(i >> 16)
        xorInto(hacc, kdf.Hkdf("sha256", secret, salt, info, 32)?)
    }
    t1 = now()
    println("hkdf", nh, hex.Encode(hacc))
    report("hkdf", t0, t1, nh, "ops")

    // Argon2id, t=1, 64 MiB, 4 lanes.
    var na = 8
    if div > 1 {
        na = 1
    }
    var aacc = seq(32, 0)
    var pw = seq(16, 33)
    t0 = now()
    for i in 0..na {
        pw[0] = byte(i)
        xorInto(aacc, kdf.Argon2id(pw, salt, 1, 65536, 4, 32)?)
    }
    t1 = now()
    println("argon2id", na, hex.Encode(aacc))
    report("argon2id", t0, t1, na, "ops")

    // TLS 1.3 full handshakes on loopback (no session resumption), one
    // byte echoed per connection.
    var nt = 1000 / div
    var cert = tls.LoadKeyPair(serverCert, serverKey)?
    var l = tls.Listen("127.0.0.1:0", tls.ServerConfig{Certificates: [cert], MinVersion: tls.V13})?
    var addr = fmt.Format("127.0.0.1:{0}", l.Port())
    var serving = serve(l)
    var tok = 0
    var ccfg = tls.Config{InsecureSkipVerify: true, MinVersion: tls.V13}
    t0 = now()
    for _ in 0..nt {
        var c = await tls.Dial(addr, ccfg)?
        _ = await c.WriteString("x")?
        var b = await c.Read(16)?
        if len(b) == 1 && c.ConnectionState().VersionName() == "TLS 1.3" {
            tok += 1
        }
        c.Close()
    }
    t1 = now()
    l.Close()
    await serving
    println("tls13", nt, tok)
    report("tls13 handshake", t0, t1, nt, "ops")
}
