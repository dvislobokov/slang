namespace bench.channel_pingpong

import io

// Channels. Ping-pong: two tasks exchange 5M messages (2.5M each way) over
// two unbuffered channels. Pipeline: 1M values through 4 stages connected
// by buffered channels (capacity 128): source -> +1 -> *3 -> xor -> sink.

async func ponger(src task.Channel<int>, out task.Channel<int>) {
    for v in src {
        await out.Send(v + 1)
    }
    out.Close()
}

async func pingpong(msgs int) int {
    var a = task.Channel<int>(0)
    var b = task.Channel<int>(0)
    var p = ponger(a, b)
    var sum = 0
    for i in 0..msgs / 2 {
        await a.Send(i)
        sum += try await b.Recv() else 0
    }
    a.Close()
    await p
    return sum
}

async func source(out task.Channel<int>, n int) {
    for i in 0..n {
        await out.Send(i)
    }
    out.Close()
}

async func stage(src task.Channel<int>, out task.Channel<int>, kind int) {
    for v in src {
        if kind == 0 {
            await out.Send(v + 1)
        } else if kind == 1 {
            await out.Send(v * 3)
        } else {
            await out.Send(v ^ 0x5555)
        }
    }
    out.Close()
}

async func pipeline(n int) int {
    var c0 = task.Channel<int>(128)
    var c1 = task.Channel<int>(128)
    var c2 = task.Channel<int>(128)
    var c3 = task.Channel<int>(128)
    var s0 = source(c0, n)
    var s1 = stage(c0, c1, 0)
    var s2 = stage(c1, c2, 1)
    var s3 = stage(c2, c3, 2)
    var sum = 0
    for v in c3 {
        sum += v
    }
    await task.All(s0, s1, s2, s3)
    return sum
}

// The workload: `small` (SCALE=small) for a quick smoke run, else full.
func scaled(small bool, smallN int, fullN int) int {
    if small {
        return smallN
    }
    return fullN
}

async func main() {
    var small = os.Getenv("SCALE") == "small"   // smoke workload
    var msgs = scaled(small, 50000, 5000000)
    var items = scaled(small, 10000, 1000000)
    var t0 = time.NowNanos()
    var a = await pingpong(msgs)
    var t1 = time.NowNanos()
    var b = await pipeline(items)
    var t2 = time.NowNanos()
    println("channel_pingpong", a, b)
    println("  pingpong_ms", (t1 - t0) / 1000000, "pipeline_ms", (t2 - t1) / 1000000)
}
